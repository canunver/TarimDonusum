@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    var b = Model.Basvuru;
    bool ro = Model.SaltOkunur;
    decimal toplamTl = b.HesaplananToplamYatirimTutariTl;
    decimal? toplamEur = b.HesaplananToplamYatirimTutariEur;
    decimal azamiDestek = b.basvuruFirma.donem.maksimumDestekTutari.GetValueOrDefault();
    decimal azamiOran = b.basvuruFirma.donem.AzamiDestekOrani(b.YatirimAdresleri.Select(x => x.ilceId));
    decimal? hesaplananFinansmanTutari = toplamEur.HasValue && b.finans.talepEdilenFinansmanOrani.HasValue
        ? Math.Round(toplamEur.Value * b.finans.talepEdilenFinansmanOrani.Value / 100m, 2)
        : null;
    decimal? hesaplananOzKaynak = toplamEur.HasValue && hesaplananFinansmanTutari.HasValue
        ? toplamEur.Value - hesaplananFinansmanTutari.Value
        : null;
    string toplamEurHam = toplamEur?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0";
}
            <section class="basvuru-panel active" data-panel="5" data-finans-maksimum-destek="@azamiDestek.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <h2>@L["Basvuru.Step.FinansmanOdemePlani"]</h2>
                <div class="finans-plan-form">
                    <label><span>Toplam yatırım tutarı (TL):</span><div class="finans-plan-value">@IsimBul.MetneCevirKurussuz(toplamTl)</div></label>
                    <label><span>Toplam yatırım tutarı (EUR):</span><div class="finans-plan-value">@(toplamEur?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "")</div><input id="finansToplamYatirimTutari" type="hidden" value="@toplamEurHam" data-hesaplanan-deger="@toplamEurHam" /></label>
                    <label><span>Talep edilen oran (%):</span><input name="Basvuru.finans.TalepEdilenFinansmanOrani" type="number" min="0.01" max="@azamiOran.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@b.finans.talepEdilenFinansmanOrani?.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" oninput="FinansTutarlariniHesapla()" onchange="FinansTutarlariniHesapla()" disabled="@ro" /></label>
                    <label><span>Talep edilen finansman yatırım (EUR):</span><div id="finansTalepEdilenGosterge" class="finans-plan-value">@(hesaplananFinansmanTutari?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "")</div><small id="finansMaksimumDestekUyarisi" class="text-danger d-none">Maksimum destek tutarı aşılıyor. Oranı düşürünüz.</small></label>
                    <label><span>Öz kaynak tutarı (EUR):</span><div id="finansOzKaynakGosterge" class="finans-plan-value">@(hesaplananOzKaynak?.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ?? "")</div><input name="Basvuru.finans.BasvuruSahibiKatkisi" type="hidden" value="@(hesaplananOzKaynak?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" /></label>
                    <label><span>@L["Basvuru.Field.TalepEdilenVadeSuresiAy"]:</span><input name="Basvuru.finans.TalepEdilenVadeSuresiAy" type="number" min="1" step="1" value="@b.finans.talepEdilenVadeSuresiAy" disabled="@ro" /></label>
                    <label><span>@L["Basvuru.Field.YatirimSuresiAy"]:</span><input name="Basvuru.finans.YatirimSuresiAy" type="number" min="1" step="1" value="@b.finans.yatirimSuresiAy" disabled="@ro" /></label>
                </div>
                <div class="alert alert-info mt-3 mb-0">
                    <ol class="mb-0 pl-3">
                        <li>@L["Basvuru.Finance.InvestmentDurationHelp"]</li>
                        <li>@L["Basvuru.Finance.GracePeriod24Help"]</li>
                        <li>@L["Basvuru.Finance.GracePeriod12Help"]</li>
                    </ol>
                </div>
            </section>


