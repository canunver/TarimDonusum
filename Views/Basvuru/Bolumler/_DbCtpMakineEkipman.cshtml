@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@using System.Text.Json
@{ bool duzenlenebilir = !Model.DenetciGorunumu && !Model.SaltOkunur; }
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.DbCtpMakineEkipman)">
 <div class="section-toolbar"><h2 class="mb-0">Teknik Proje (Makine Ekipman)</h2><div class="d-flex align-items-center justify-content-end flex-wrap ml-auto" style="gap:8px">@{ ViewData["AdresAsamaKaynak"] = "makine"; }<partial name="_AdresAsamaFiltresi" model="Model" /><a data-adres-asama-yazdir class="btn btn-outline-primary" href="@Url.Action("YatirimMakineEkipmanListesiYazdir","Basvuru",new{id=Model.Basvuru.Id})"><i class="fas fa-file-excel mr-1"></i>Yazdır</a>@if(duzenlenebilir){<a class="btn btn-outline-success" href="@Url.Action("YatirimEkipmanlariExcelSablonuIndir", "Basvuru")"><i class="fas fa-download mr-1"></i>Excel Şablonu</a><label class="btn btn-outline-success mb-0" for="yatirimEkipmanExcelDosya"><i class="fas fa-file-excel mr-1"></i>Excel'den yükle</label><input id="yatirimEkipmanExcelDosya" type="file" accept=".xlsx,.xls" class="d-none" /><button type="button" class="btn btn-primary" id="yatirimEkipmanYeniBtn">Yeni ekipman ekle</button>}</div></div>
 <input type="hidden" id="dbCtpTeknikProjeJson" value="@Model.Basvuru.dbCtpTeknikProje.dbCtpTeknikProjeJson" />
 <script type="application/json" id="yatirimEkipmanJson">@Html.Raw(JsonSerializer.Serialize(Model.Basvuru.Makineler.Select(m => new { m.id,m.basvuruId,m.uygulamaAdresiId,m.uygulamaAdresiAciklama,m.degerZinciriAsamaTuru,m.degerZinciriAsamaTuruAdi,m.siraNo,m.ad,m.birim,m.miktar,m.aciklama,m.marka,m.model,m.kapasiteOzellikleri,m.yerlesimPlaniSiraNo,m.kullanimAmaci,m.durum,m.kapasiteSecimGerekcesi,m.teklifKontroluYapilsin,teknikOzellikler=m.teknikOzellikler,teklifler=m.teklifler })))</script>
 <div id="yatirimEkipmanListeAlani"></div>
</section>
@if(duzenlenebilir)
{
<partial name="_YatirimEkipmanModal" model="Model" />

}
