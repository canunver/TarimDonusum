@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@using System.Text.Json
@{ bool duzenlenebilir = !Model.DenetciGorunumu && !Model.SaltOkunur; }
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.DbCtpMakineEkipman)">
 <div class="section-toolbar"><h2 class="mb-0">Teknik Proje (Makine Ekipman)</h2>@if(duzenlenebilir){<div class="d-flex align-items-center" style="gap:8px"><label class="btn btn-outline-success mb-0" for="yatirimEkipmanExcelDosya"><i class="fas fa-file-excel mr-1"></i>Excel'den yükle</label><button type="button" class="btn btn-outline-info" title="Excel formatı hakkında bilgi" onclick="$('#yatirimEkipmanExcelYardimModal').modal('show')"><i class="fas fa-question"></i></button><input id="yatirimEkipmanExcelDosya" type="file" accept=".xlsx,.xls" class="d-none" /><button type="button" class="btn btn-primary" id="yatirimEkipmanYeniBtn">Yeni ekipman ekle</button></div>}</div>
 <input type="hidden" id="dbCtpTeknikProjeJson" value="@Model.Basvuru.dbCtpTeknikProje.dbCtpTeknikProjeJson" />
 <script type="application/json" id="yatirimEkipmanJson">@Html.Raw(JsonSerializer.Serialize(Model.Basvuru.Makineler.Select(m => new { m.id,m.basvuruId,m.uygulamaAdresiId,m.uygulamaAdresiAciklama,m.siraNo,m.ad,m.birim,m.miktar,m.aciklama,m.marka,m.model,m.kapasiteOzellikleri,m.yerlesimPlaniSiraNo,m.kullanimAmaci,m.durum,m.kapasiteSecimGerekcesi,m.teklifKontroluYapilsin,teknikOzellikler=m.teknikOzellikler,teklifler=m.teklifler })))</script>
 <div id="yatirimEkipmanListeAlani"></div>
</section>
@if(duzenlenebilir)
{
<div class="modal fade" id="yatirimEkipmanModal" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content">
 <div class="modal-header"><h5 class="modal-title">Yatırımda Kullanılacak Ekipman</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
 <div class="modal-body" style="max-height:calc(100vh - 180px);overflow-y:auto">
  <input type="hidden" id="yatirimEkipmanIndex" />
  <div class="form-grid">
   <label>Kullanılacağı adres<select id="yeAdres"><option value="">Seçiniz</option>@foreach(var a in Model.Basvuru.YatirimAdresleri.OrderBy(x=>x.siraNo)){<option value="@a.id">@a.siraNo. @a.ilAdi / @a.ilceAdi - @a.tamAdres</option>}</select></label>
   <label>Makine-ekipmanın adı<input id="yeAd" maxlength="250" /></label><label>Markası<input id="yeMarka" maxlength="150" /></label><label>Modeli<input id="yeModel" maxlength="150" /></label>
   <label>Adedi<input id="yeAdet" type="number" min="0.001" step="0.001" /></label><label>Yerleşim planı ve listesindeki sıra numarası<input id="yePlanSira" type="number" min="1" max="9999" /></label>
   <label>Durum<select id="yeDurum" onchange="YatirimEkipmanDurumAlanlariGuncelle()"><option value="">Seçiniz</option><option>YENİ DESTEK İSTENİYOR</option><option>YENİ DESTEK İSTEMİYOR</option><option>MEVCUT KULLANILACAK</option><option>MEVCUT KULLANILMAYACAK</option></select></label>
  </div>
  <label class="wide-label">İşleme kapasitesi veya kapasite belirleyici özellikleri<textarea id="yeKapasite" maxlength="2000"></textarea></label>
  <label class="wide-label">Kullanım amacı<textarea id="yeKullanimAmaci" maxlength="2000"></textarea></label>
  <label class="wide-label">Makine-ekipman kapasitesi seçim gerekçesi ve kapasiteyi belirleyen hususlar<textarea id="yeKapasiteGerekcesi" maxlength="4000"></textarea></label>
 </div>
 <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="YatirimEkipmanKaydet()">Kaydet</button></div>
</div></div></div>

<div class="modal fade" id="yatirimEkipmanExcelYardimModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl"><div class="modal-content">
 <div class="modal-header"><h5 class="modal-title">Yatırım Ekipmanları Excel Formatı</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
 <div class="modal-body">
  <p>İlk satır başlık, ikinci satırdan itibaren ekipman kayıtları olmalıdır. Sütun başlıkları aşağıdaki sırayla ve aynı metinlerle yazılmalıdır.</p>
  <div class="table-responsive"><table class="table table-bordered table-sm"><thead><tr><th>Sütun</th><th>Başlık</th><th>Açıklama</th></tr></thead><tbody>
   <tr><td>A</td><td>Adres No</td><td>Yatırım adresinin ekranda görünen sıra numarasıdır (1, 2 gibi).</td></tr>
   <tr><td>B</td><td>Makine-ekipmanın adı</td><td>Zorunludur.</td></tr>
   <tr><td>C</td><td>Markası</td><td>En fazla 150 karakter.</td></tr>
   <tr><td>D</td><td>Modeli</td><td>En fazla 150 karakter.</td></tr>
   <tr><td>E</td><td>Adedi</td><td>Sıfırdan büyük sayısal değer.</td></tr>
   <tr><td>F</td><td>Yerleşim planı ve listesindeki sıra numarası</td><td>Boş bırakılabilir; girilirse 1-9999 arasında tam sayı.</td></tr>
   <tr><td>G</td><td>Durum</td><td>Excel'e 1-4 arasında değer girilir:<br>1 - YENİ DESTEK İSTENİYOR<br>2 - YENİ DESTEK İSTEMİYOR<br>3 - MEVCUT KULLANILACAK<br>4 - MEVCUT KULLANILMAYACAK</td></tr>
   <tr><td>H</td><td>İşleme kapasitesi veya kapasite belirleyici özellikleri</td><td>En fazla 2000 karakter.</td></tr>
   <tr><td>I</td><td>Kullanım amacı</td><td>En fazla 2000 karakter.</td></tr>
   <tr><td>J</td><td>Makine-ekipman kapasitesi seçim gerekçesi ve kapasiteyi belirleyen hususlar</td><td>En fazla 4000 karakter.</td></tr>
  </tbody></table></div>
  <p class="mb-0">Adres No başvurudaki yatırım adreslerinde bulunamazsa hiçbir satır yüklenmez ve hata mesajı gösterilir. Yüklenen kayıtlar mevcut ekipmanlara eklenir.</p>
 </div>
 <div class="modal-footer"><a class="btn btn-success mr-auto" href="@Url.Action("YatirimEkipmanlariExcelSablonuIndir", "Basvuru")"><i class="fas fa-download mr-1"></i>Şablon indir</a><button type="button" class="btn btn-primary" data-dismiss="modal">Kapat</button></div>
</div></div></div>
}
