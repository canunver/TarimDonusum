@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using System.Text.Json
@{ var b = Model.Basvuru; bool ro = Model.SaltOkunur; }
<section class="basvuru-panel active" data-panel="@((int)TarimDonusum.Models.enumBasvuruBolum.DbCtpTeknikProje)">
    <div class="section-toolbar">
        <h2 class="mb-0">Teknik Proje (Girdiler)</h2>
        <a class="btn btn-outline-primary" asp-controller="Basvuru" asp-action="OnBilgilerYazdir" asp-route-id="@b.Id"><i class="fas fa-file-excel mr-1"></i>Yazdır</a>
    </div>
    <input type="hidden" id="dbCtpTeknikProjeJson" value="@b.dbCtpTeknikProje.dbCtpTeknikProjeJson" />
    <script type="application/json" id="dbCtpGirdilerJson">@Html.Raw(JsonSerializer.Serialize(b.YatirimOnBilgileri.Where(x => x.tur == TarimDonusum.Models.enumYatirimOnBilgiTuru.Girdi).OrderBy(x => x.siraNo)))</script>
    <div class="yatirim-ozeti-section">
        <div class="section-toolbar">
            <h3>Yatırım Sonrası Girdi Tedarik İhtiyacı</h3>
            @if (!ro)
            {
                <div>
                    <a class="btn btn-outline-success" href="@Url.Action("TeknikProjeGirdileriExcelSablonuIndir", "Basvuru")"><i class="fas fa-download mr-1"></i>Excel Şablonu</a>
                    <label class="btn btn-outline-success mb-0" for="dbCtpGirdiExcelDosya"><i class="fas fa-file-excel mr-1"></i>Excel'den yükle</label>
                    <input id="dbCtpGirdiExcelDosya" type="file" accept=".xlsx,.xls" class="d-none" />
                    <button type="button" class="btn btn-outline-primary" onclick="DbCtpGirdiModalAc(-1)"><i class="fas fa-plus mr-1"></i>Girdi ekle</button>
                </div>
            }
        </div>
        <div id="dbCtpInputs"></div>
    </div>
    <div class="yatirim-ozeti-section">
        <h3>Yenilenebilir Enerji Bilgileri</h3>
        <h4>Güneş enerjisi</h4>
        <div class="form-grid">
            <label>Panel sayısı (adet)<input id="dbCtpSolarPanels" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('solar','panels',this.value)" /></label>
            <label>Bir panelin gücü (W)<input id="dbCtpSolarPanelPower" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('solar','panelPower',this.value)" /></label>
            <label>Toplam güç (kWp)<input id="dbCtpSolarTotalPower" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('solar','totalPower',this.value)" /></label>
        </div>
        <h4 class="mt-4">Kurulu güç</h4>
        <div class="form-grid db-ctp-energy-grid">
            <label>Güneş enerjisi kurulu gücü (kWe)<input id="dbCtpInstalledSolar" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('installedSolar','power',this.value)" /></label>
            <label>Biyogaz kurulu gücü (kWe)<input id="dbCtpInstalledBiogas" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('installedBiogas','power',this.value)" /></label>
            <label>Biyokütle kurulu gücü (kWe)<input id="dbCtpInstalledBiomass" inputmode="decimal" disabled="@ro" oninput="DbCtpEnerjiGuncelle('installedBiomass','power',this.value)" /></label>
        </div>
    </div>
</section>
@if (!ro)
{
    <div class="modal fade" id="dbCtpGirdiModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="dbCtpGirdiModalBaslik">Teknik Proje Girdisi</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <input id="dbCtpGirdiIndex" type="hidden" />
                <div class="form-grid">
                    <label>Girdinin kullanılacağı adres<select id="dbCtpGirdiUygulamaAdresiId"><option value="">Seçiniz</option>@foreach(var adres in b.YatirimAdresleri.OrderBy(x=>x.siraNo)){<option value="@adres.id">@adres.siraNo. @adres.ilAdi / @adres.ilceAdi - @adres.tamAdres</option>}</select></label>
                    <label>Sıra no<input id="dbCtpGirdiSiraNo" type="number" min="1" step="1" /></label>
                    <label>Girdi / Hammadde adı<input id="dbCtpGirdiAdi" maxlength="250" /></label>
                    <label>Yıllık ihtiyaç<input id="dbCtpGirdiMiktar" type="number" min="0.001" step="0.001" /></label>
                    <label>Birim<select id="dbCtpGirdiBirim">@foreach(var birim in TarimDonusum.Models.OlcuBirimleri.Tum){<option value="@birim">@birim</option>}</select></label>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="DbCtpGirdiKaydet()">Kaydet</button></div>
        </div></div>
    </div>
}
