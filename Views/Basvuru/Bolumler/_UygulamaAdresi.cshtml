@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    var b = Model.Basvuru;
    bool ro = Model.SaltOkunur;
    string YatirimTurleriMetni() => string.Join(", ", b.yatirim.yatirimTurleri.Select(x => IsimBul.EnumAdi((enumYatirimTuru)x, L)).Distinct(StringComparer.CurrentCultureIgnoreCase));
    string HarcamaTurleriMetni() => string.Join(", ", b.yatirim.harcamaTurleri.Select(x => IsimBul.EnumAdi((enumHarcamaTuru)x, L)).Distinct(StringComparer.CurrentCultureIgnoreCase));
}
            <section class="basvuru-panel active" data-panel="4">
                <div class="section-toolbar">
                    <h2 class="mb-0">@L["Basvuru.Section4.Title"]</h2>
                    <a class="btn btn-outline-primary" asp-controller="Basvuru" asp-action="YatirimBilgileriYazdir" asp-route-id="@b.Id"><i class="fas fa-file-excel mr-1"></i>Yazdır</a>
                </div>
                <div class="preapp-form">
                    <div class="preapp-line">
                        <label for="yatirimAdi">@L["Basvuru.Field.YatirimAdi"]</label>
                        <input id="yatirimAdi" name="Basvuru.YatirimAdi" value="@b.yatirim.yatirimAdi" disabled="@ro" />
                    </div>
                </div>
                <label class="wide-label">@L["Basvuru.Field.YatiriminAmaci"] <span class="required-mark">*</span><textarea name="Basvuru.yatirim.YatiriminAmaci" disabled="@ro">@b.yatirim.yatiriminAmaci</textarea></label>
                <h3 class="subhead mt-4">Adreslerden Birleştirilen Yatırım Bilgileri</h3>
                <label class="wide-label">@L["Basvuru.Field.YatirimTuru"]<textarea id="adresOzetYatirimTurleri" readonly>@YatirimTurleriMetni()</textarea></label>
                <label class="wide-label">Talep edilen harcama türleri<textarea id="adresOzetHarcamaTurleri" readonly>@HarcamaTurleriMetni()</textarea></label>
                <label class="wide-label">@L["Basvuru.Field.YatirimFaaliyetleri"]<textarea id="adresOzetFaaliyetler" readonly>@b.yatirim.yatirimFaaliyetleri</textarea></label>
                <label class="wide-label">@L["Basvuru.Field.YatirimGirdileri"]<textarea id="adresOzetGirdiler" readonly>@b.yatirim.yatirimGirdileri</textarea></label>
                <label class="wide-label">@L["Basvuru.Field.YatirimCiktilari"]<textarea id="adresOzetCiktilar" readonly>@b.yatirim.yatirimCiktilari</textarea></label>
                <p class="section-description">Bu alanlar aşağıdaki adres kayıtlarından otomatik olarak birleştirilir.</p>
                <h3 class="subhead mt-4">Yatırım Adresleri</h3>
                <div class="adres-toolbar">
                    @if (!ro)
                    {
                        <button type="button" class="btn btn-outline-primary" id="adresYeniBtn"><i class="fas fa-plus"></i> @L["Basvuru.Address.New"]</button>
                    }
                </div>
                <div class="table-responsive uygulama-adres-wrap">
                    <table class="table uygulama-adres-table">
                        <thead>
                            <tr>
                                <th>@L["Basvuru.Field.SiraNo"]</th>
                                <th>@L["Basvuru.Field.Il"]</th>
                                <th>@L["Basvuru.Field.Ilce"]</th>
                                <th>@L["Basvuru.Field.TamAdres"]</th>
                                <th>@L["Basvuru.Field.YatirimYeriStatusu"]</th>
                                <th>@L["Basvuru.Field.KiraTahsis"]</th>
                                <th class="yapi-ruhsati-kolonu">@L["Basvuru.Field.YapiRuhsatiDurumu"]</th>
                                <th>@L["Basvuru.Common.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody id="uygulamaAdresListesi"></tbody>
                    </table>
                </div>
                <p class="section-description">@L["Basvuru.InvestmentPurpose.Help"]</p>
            </section>

