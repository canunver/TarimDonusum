@using System.Text.Json
@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    var b = Model.Basvuru;
    bool ro = Model.SaltOkunur;
    bool anaBilgileriKilitli = ro || b.BasvuruAnaId > 0;
    string T(string key) => L[key].Value;
    string[] Items(string key) => T(key).Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    string[] evetHayir = Items("Basvuru.Options.YesNo");
    string evetMetni = evetHayir.Length > 0 ? evetHayir[0] : T("Basvuru.Common.YesAnswer");
    string hayirMetni = evetHayir.Length > 1 ? evetHayir[1] : T("Basvuru.Common.NoAnswer");
    string kurulusTarihi = b.basvuruFirma.firma.kurulusTarihi?.ToString("yyyy-MM-dd") ?? "";
}

<section class="basvuru-panel active" data-bolum="Firma">
    <div class="basvuru-form-section">
        <h2 class="preapp-subtitle">@L["Basvuru.Applicant.PeriodProvinceTitle"]</h2>
        <div class="form-grid">
            <label>
                @L["Basvuru.Field.BasvuruDonemi"]
                <select id="basvuruDonemi" name="Basvuru.DonemId" disabled="@anaBilgileriKilitli">
                    <option value="">@L["Basvuru.Common.Select"]</option>
                    @foreach (var donem in Model.Donemler)
                    {
                        bool secili = b.basvuruFirma.donem.id == donem.id;
                        bool secilebilir = donem.SecilebilirMi(enumBasvuruKayitTuru.OnBasvuru);
                        string durum = secilebilir ? T("Basvuru.Donem.Open") : T("Basvuru.Donem.Closed");
                        <option value="@donem.id" selected="@secili" disabled="@(!secilebilir && !secili)">
                            @donem.ad (@durum)
                        </option>
                    }
                </select>
            </label>
            <label>
                @L["Basvuru.Field.Il"]
                <select id="basvuruIl" name="Basvuru.IlId" disabled="@anaBilgileriKilitli">
                    <option value="">@L["Basvuru.Common.Select"]</option>
                    @foreach (var il in Model.Iller)
                    {
                        <option value="@il.id" selected="@(b.basvuruFirma.il.id == il.id)">@il.kod.ToString("00") - @il.ad</option>
                    }
                </select>
            </label>
            <label>
                Değer zinciri
                <select id="basvuruDegerZinciri" name="Basvuru.DegerZinciriId" disabled="@(ro || b.YatirimAdresleri.Count > 0)">
                    <option value="">@L["Basvuru.Common.Select"]</option>
                </select>
            </label>
        </div>
    </div>

    <div class="basvuru-form-section">
        <div class="section-toolbar"><h2>@L["Basvuru.Step.1"]</h2><a class="btn btn-outline-primary" href="@Url.Action("OnBasvuruSahibiYazdir", "Basvuru", new { id = b.Id })"><i class="fas fa-file-excel mr-1"></i>Yazdır</a></div>
        <p class="section-description">@L["Basvuru.Applicant.Description"]</p>

        <h4 class="preapp-subtitle">@L["Basvuru.Firma.InfoTitle"]</h4>
        <div class="form-grid company-summary-grid">
            <label>
                @L["Basvuru.Field.VergiKimlikNo"]
                <span class="company-inline">
                    <input type="hidden" id="firmaId" name="Basvuru.FirmaId" value="@b.basvuruFirma.firma.id" />
                    <input id="vergiKimlikNo" name="Basvuru.VergiKimlikNo" value="@b.basvuruFirma.firma.vergiKimlikNo" inputmode="numeric" maxlength="10" disabled="@anaBilgileriKilitli" />
                    @if (!ro)
                    {
                        <button type="button" class="btn btn-outline-primary icon-action" id="firmaSecBtn" title="@L["Basvuru.Firma.SelectTitle"]" aria-label="@L["Basvuru.Firma.SelectTitle"]">
                            <i class="fas fa-search" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-outline-success icon-action" id="firmaYeniBtn" title="@T("Basvuru.Firma.ModalTitle")">+</button>
                        <button type="button" class="btn btn-outline-secondary icon-action" id="firmaDuzenleBtn" title="@T("Basvuru.Common.Edit")">
                            <i class="fas fa-edit"></i>
                        </button>
                    }
                </span>
            </label>
            <label class="company-name-field">@L["Basvuru.Field.TicaretUnvani"]<input id="firmaAdi" name="Basvuru.TicaretUnvani" value="@b.basvuruFirma.firma.ticaretUnvani" readonly /></label>
        </div>

        <div class="form-grid">
            <label>@L["Basvuru.Field.NaceKodu"]<input id="firmaNaceKodu" value="@b.basvuruFirma.firma.naceKodu" readonly /></label>
        </div>
        <label class="wide-label">@L["Basvuru.Field.FaaliyetKonusu"]<textarea id="firmaFaaliyetKonusu" readonly>@b.basvuruFirma.firma.faaliyetKonusu</textarea></label>

        <details class="company-details">
            <summary>@L["Basvuru.Firma.InfoTitle"]</summary>
            <div class="form-grid">
                <label>@L["Basvuru.Field.TicaretSicilNo"]<input id="firmaTicaretSicilNo" value="@b.basvuruFirma.firma.ticaretSicilNo" readonly /></label>
                <label>@L["Basvuru.Field.KurulusTarihi"]<input id="firmaKurulusTarihi" type="date" value="@kurulusTarihi" readonly /></label>
                <label>@L["Basvuru.Field.Telefon"]<input id="firmaTelefon" value="@b.basvuruFirma.firma.telefon" readonly /></label>
                <label>@L["Basvuru.Field.WebSitesi"]<input id="firmaWebSitesi" value="@b.basvuruFirma.firma.webSitesi" readonly /></label>
                <label>@L["Basvuru.Field.MersisNo"]<input id="firmaMersisNo" value="@b.basvuruFirma.firma.mersisNo" readonly /></label>
                <label>@L["Basvuru.Field.KepAdresi"]<input id="firmaKepAdresi" value="@b.basvuruFirma.firma.kepAdresi" readonly /></label>
                <label>@L["Basvuru.Field.Eposta"]<input id="firmaEposta" type="email" value="@b.basvuruFirma.firma.eposta" readonly /></label>
            </div>
            <label class="wide-label">@L["Basvuru.Field.FirmaAdresi"]<textarea id="firmaAdres" readonly>@b.basvuruFirma.firma.adres</textarea></label>
        </details>

        <div class="form-grid">
            <label>
                @L["Basvuru.Field.SonIkiYildirFaalMi"]
                <input type="text" value="@b.FaaliyetSuresiDurumuMetni" readonly />
                @if (b.IkiYillikFaaliyetSartindanMuaf) { <small class="text-success">Organize Tarım Bölgesi yatırım adresi nedeniyle iki yıllık faaliyet şartından muaftır.</small> }
            </label>
            <label>
                @L["Basvuru.Field.BasvuruSahibiTuru"]
                <select id="basvuruTipi" name="Basvuru.BasvuruSahibiTuru" disabled="@ro">
                    <option value="" selected="@(!b.basvuruFirma.basvuruSahibiTuru.HasValue || b.basvuruFirma.basvuruSahibiTuru == TarimDonusum.Models.enumBasvuruSahibiTuru.Tanimsiz)">@L["Basvuru.Common.Select"]</option>
                    @foreach (TarimDonusum.Models.enumBasvuruSahibiTuru item in Enum.GetValues<TarimDonusum.Models.enumBasvuruSahibiTuru>())
                    {
                        if (item == TarimDonusum.Models.enumBasvuruSahibiTuru.Tanimsiz)
                        {
                            continue;
                        }
                        <option value="@((int)item)" selected="@(b.basvuruFirma.basvuruSahibiTuru == item)">@IsimBul.EnumAdi(item, L)</option>
                    }
                </select>
            </label>
            <label>
                @L["Basvuru.Field.HukukiTurSirketTuru"]
                <select id="hukukiTurSirketTuru" name="Basvuru.HukukiTurSirketTuru" disabled="@ro">
                    <option value="" selected="@(!b.basvuruFirma.hukukiTurSirketTuru.HasValue || b.basvuruFirma.hukukiTurSirketTuru == TarimDonusum.Models.enumHukukiTurSirketTuru.Tanimsiz)">@L["Basvuru.Common.Select"]</option>
                    @foreach (TarimDonusum.Models.enumHukukiTurSirketTuru item in Enum.GetValues<TarimDonusum.Models.enumHukukiTurSirketTuru>())
                    {
                        if (item == TarimDonusum.Models.enumHukukiTurSirketTuru.Tanimsiz)
                        {
                            continue;
                        }
                        <option value="@((int)item)" selected="@(b.basvuruFirma.hukukiTurSirketTuru == item)">@IsimBul.EnumAdi(item, L)</option>
                    }
                </select>
            </label>
        </div>
        <h4 class="preapp-subtitle">@L["Basvuru.ContactInformation"]</h4>
        <div class="form-grid">
            <label>@L["Basvuru.Field.IrtibatKisisi"]<input id="irtibatKisisi" name="Basvuru.irtibat.kisi" value="@b.irtibat.kisi" disabled="@ro" /></label>
            <label>@L["Basvuru.Field.IrtibatUnvani"]<input id="irtibatUnvani" name="Basvuru.irtibat.unvan" value="@b.irtibat.unvan" disabled="@ro" /></label>
            <label>@L["Basvuru.Field.IrtibatTelefon"]<input id="irtibatTelefon" name="Basvuru.irtibat.telefon" value="@b.irtibat.telefon" disabled="@ro" /></label>
            <label>@L["Basvuru.Field.IrtibatEposta"]<input id="irtibatEposta" name="Basvuru.irtibat.ePosta" type="email" value="@b.irtibat.ePosta" disabled="@ro" /></label>
        </div>
        <label class="wide-label">@L["Basvuru.Field.IletisimAdresi"]<textarea id="iletisimAdresi" name="Basvuru.irtibat.adres" disabled="@ro">@b.irtibat.adres</textarea></label>

        <script type="application/json" id="adliSicilInitialJson">
            @Html.Raw(JsonSerializer.Serialize(b.AdliSicilKisileri))
        </script>

        <div class="section-toolbar mt-4">
            <h3>
                @L["Basvuru.Documents.CriminalRecordTitle"]
                <button type="button" class="btn btn-outline-info btn-sm ml-2"
                        data-toggle="modal" data-target="#adliSicilBilgiModal"
                        aria-controls="adliSicilBilgiModal" aria-haspopup="dialog"
                        aria-label="Kimleri eklemeliyim?"
                        title="Adli sicil sorgusu yapılacak kişiler hakkında bilgi">Kimleri eklemeliyim?</button>
            </h3>
            @if (!ro)
            {
                <button type="button" class="btn btn-outline-primary" id="adliSicilKisiEkleBtn">@L["Basvuru.Documents.AddPerson"]</button>
            }
        </div>
        <div id="adliSicilKisilerTable"></div>

    </div>
</section>

<div class="modal fade" id="adliSicilBilgiModal" tabindex="-1" aria-labelledby="adliSicilBilgiBaslik" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adliSicilBilgiBaslik">Adli sicil / arşiv kaydı sorgusu yapılacak kişiler</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="@T("Basvuru.Common.Close")">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0" aria-labelledby="adliSicilBilgiBaslik">
                        <thead>
                            <tr>
                                <th scope="col">Başvuru sahibi türü</th>
                                <th scope="col">Adli sicil / arşiv kaydı sorgusu yapılacak kişiler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Anonim şirket</th>
                                <td>Yönetim kurulu üyeleri</td>
                            </tr>
                            <tr>
                                <th scope="row">Limited şirket</th>
                                <td>Şirketi temsil ve ilzama yetkili tüm kişiler; başvuru formunda beyan edilmemiş olsa bile temsil ve ilzama yetkili olanlar dâhil</td>
                            </tr>
                            <tr>
                                <th scope="row">Limited şirket</th>
                                <td>Tüzel kişiliğin %50’den fazla hissesine sahip olan hâkim ortak gerçek kişi</td>
                            </tr>
                            <tr>
                                <th scope="row">Limited şirkette temsil ve ilzama yetkili kişi bulunmaması hâli</th>
                                <td>Şirket ortakları (%25 ve daha fazlası)</td>
                            </tr>
                            <tr>
                                <th scope="row">Kollektif şirket</th>
                                <td>Şirket ortakları (%25 ve daha fazlası)</td>
                            </tr>
                            <tr>
                                <th scope="row">Komandit şirket</th>
                                <td>Şirketi temsil ve ilzama yetkili komanditer ortak ile komandite ortaklar (%25 ve daha fazlası)</td>
                            </tr>
                            <tr>
                                <th scope="row">Üretici örgütü</th>
                                <td>Üretici örgütünün yönetim kurulu üyeleri</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@L["Basvuru.Common.Close"]</button>
            </div>
        </div>
    </div>
</div>
