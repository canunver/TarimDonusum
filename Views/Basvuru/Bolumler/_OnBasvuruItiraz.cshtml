@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@{
    Basvuru b = Model.Basvuru;
    bool basvuranYazabilir = !Model.DenetciGorunumu && b.durum == enumBasvuruDurum.IptalDurumu;
    bool uzmanYazabilir = Model.DenetciGorunumu && b.durum == enumBasvuruDurum.OnBasvuruItirazEdildiDurumu;
}

<section class="basvuru-panel active"
         data-panel="@((int)enumBasvuruBolum.OnBasvuruItiraz)"
         data-appeal-required="İtiraz metni girilmelidir."
         data-reason-required="Karar gerekçesi girilmelidir."
         data-revision-confirm="Ön başvuru revizyona gönderilsin mi?"
         data-reject-confirm="İtiraz reddedilsin mi?"
         data-failed-message="İşlem tamamlanamadı.">
    <div class="section-heading">
        <div>
            <h2>İtiraz / İtiraz Geçmişi</h2>
            <p>Ön başvuruya ait itiraz ve uzman kararlarının tamamı tarih sırasıyla gösterilir.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(b.DenetimGerekcesi))
    {
        <div class="alert alert-danger">
            <strong>Ön başvuru ret gerekçesi</strong>
            <div style="white-space:pre-wrap">@b.DenetimGerekcesi</div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header font-weight-bold">İtiraz Tarihçesi</div>
        <div class="card-body">
            @if (Model.ItirazTarihcesi.Count == 0)
            {
                <div class="text-muted">Henüz itiraz kaydı bulunmuyor.</div>
            }
            else
            {
                foreach (OnBasvuruItiraz kayit in Model.ItirazTarihcesi)
                {
                    string baslik = kayit.IslemTuru switch
                    {
                        enumOnBasvuruItirazIslemTuru.ItirazEdildi => "Başvuran İtirazı",
                        enumOnBasvuruItirazIslemTuru.ItirazReddedildi => "İtiraz Reddedildi",
                        _ => "Revizyona Gönderildi"
                    };
                    string renk = kayit.IslemTuru == enumOnBasvuruItirazIslemTuru.ItirazEdildi
                        ? "border-info"
                        : kayit.IslemTuru == enumOnBasvuruItirazIslemTuru.ItirazReddedildi ? "border-danger" : "border-success";
                    <div class="border-left @renk pl-3 py-2 mb-3">
                        <div class="d-flex flex-wrap justify-content-between">
                            <strong>@baslik</strong>
                            <span class="text-muted">@kayit.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="small text-muted mb-2">@kayit.KullaniciAdi</div>
                        <div style="white-space:pre-wrap">@kayit.Metin</div>
                    </div>
                }
            }
        </div>
    </div>

    @if (basvuranYazabilir)
    {
        <div class="card">
            <div class="card-header font-weight-bold">Yeni İtiraz</div>
            <div class="card-body">
                <p>Ön başvurunuzun neden kabul edilmesi gerektiğini açıklayınız.</p>
                <textarea id="onBasvuruItirazMetni" class="form-control" rows="8" maxlength="4000"></textarea>
                <button type="button" id="onBasvuruItirazGonder" class="btn btn-primary mt-3">İtirazı İlet</button>
            </div>
        </div>
    }
    else if (uzmanYazabilir)
    {
        <div class="card">
            <div class="card-header font-weight-bold">Uzman Kararı</div>
            <div class="card-body">
                <label for="onBasvuruItirazKararGerekcesi">Karar gerekçesi</label>
                <textarea id="onBasvuruItirazKararGerekcesi" class="form-control" rows="6" maxlength="4000"></textarea>
                <div class="mt-3">
                    <button type="button" id="onBasvuruItirazReddet" class="btn btn-danger mr-2">İtirazı Reddet</button>
                    <button type="button" id="onBasvuruItirazRevizyonaGonder" class="btn btn-success">Revizyona Gönder</button>
                </div>
                <div class="alert alert-info mt-3 mb-0">İtiraz üzerinden doğrudan kabul verilemez. Başvuran revizyonu tamamlayıp yeniden sunduktan sonra normal inceleme süreci işletilir.</div>
            </div>
        </div>
    }
    else if (b.durum == enumBasvuruDurum.OnBasvuruItirazEdildiDurumu)
    {
        <div class="alert alert-info">İtirazınız uzman değerlendirmesini bekliyor.</div>
    }
    else
    {
        <div class="alert alert-secondary mb-0">Bu ekranda geçmiş kayıtlar görüntülenmektedir. Mevcut durumda gerçekleştirilebilecek bir itiraz işlemi bulunmuyor.</div>
    }
</section>
