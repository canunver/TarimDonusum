@using System.Text.Json
@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    var b = Model.Basvuru;
    bool ro = Model.SaltOkunur;
    string T(string key) => L[key].Value;
    var ortaklik = b.ortaklik ?? new BasvuruOrtaklik { basvuruId = b.Id };
    ortaklik.basvuruId = b.Id;
    string initialJson = JsonSerializer.Serialize(ortaklik);
    int donemYil = b.basvuruFirma.donem?.yil ?? 0;
    if (donemYil <= 0 && b.basvuruFirma.donemId > 0)
    {
        donemYil = Model.Donemler?.FirstOrDefault(x => x.id == b.basvuruFirma.donemId)?.yil ?? 0;
    }
    string oncekiMaliYil = donemYil > 0 ? (donemYil - 2).ToString() : T("Basvuru.Mali.PreviousYear");
    string sonMaliYil = donemYil > 0 ? (donemYil - 1).ToString() : T("Basvuru.Mali.LatestYear");
}
<section class="basvuru-panel active" data-panel="9">
    <h2>@L["Basvuru.Ortaklik.Title"]</h2>
    <script type="application/json" id="ortaklikInitialJson">@Html.Raw(initialJson)</script>

    <h3 class="subhead">@L["Basvuru.Ortaklik.PartnersTableTitle"]</h3>
    <div id="partnersTable" class="partners-table-wrap"></div>
    @if (!ro)
    {
        <button type="button" class="btn btn-outline-primary no-print" id="ortakEkleBtn">@L["Basvuru.Ortaklik.AddPartner"]</button>
    }

    <div id="partnerAlerts" class="mt-3"></div>

    <h3 class="subhead mt-4">Mali Kontrol Toplamları</h3>
    <p class="text-muted">Başvuru sahibi ile hesaba dahil edilen tüzel ortakların ağırlıklı tutarları birlikte gösterilir.</p>
    <div class="table-responsive">
        <table class="table table-bordered mali-table mali-kontrol-table">
            <thead><tr><th>Kontrol kalemi</th><th>@oncekiMaliYil @L["Basvuru.Ortaklik.NetSalesShort"] (TL)</th><th>@sonMaliYil @L["Basvuru.Ortaklik.NetSalesShort"] (TL)</th><th>@oncekiMaliYil @L["Basvuru.Ortaklik.AssetsShort"] (TL)</th><th>@sonMaliYil @L["Basvuru.Ortaklik.AssetsShort"] (TL)</th></tr></thead>
            <tbody>
                <tr><th>Başvuru sahibi</th><td id="maliKontrolKendiOncekiNet">0</td><td id="maliKontrolKendiSonNet">0</td><td id="maliKontrolKendiOncekiAktif">0</td><td id="maliKontrolKendiSonAktif">0</td></tr>
                <tr><th>Ağırlıklı tüzel ortak toplamı</th><td id="maliKontrolOrtakOncekiNet">0</td><td id="maliKontrolOrtakSonNet">0</td><td id="maliKontrolOrtakOncekiAktif">0</td><td id="maliKontrolOrtakSonAktif">0</td></tr>
                <tr class="font-weight-bold table-active"><th>Konsolide kontrol toplamı</th><td id="maliKontrolToplamOncekiNet">0</td><td id="maliKontrolToplamSonNet">0</td><td id="maliKontrolToplamOncekiAktif">0</td><td id="maliKontrolToplamSonAktif">0</td></tr>
                <tr class="private-share-row"><th>@L["Basvuru.Ortaklik.PrivateShareCalculated"]</th><td><strong id="privateShareCalculatedDisplay">%@ortaklik.ozelSektorPayi.GetValueOrDefault().ToString("N2")</strong><input type="hidden" id="privateShareCalculated" name="Basvuru.ortaklik.OzelSektorPayi" value="@ortaklik.ozelSektorPayi" /></td><td colspan="3"></td></tr>
            </tbody>
        </table>
    </div>

</section>
