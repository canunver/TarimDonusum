@using System.Text.Json
@using TarimDonusum.IsKurallari
@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    var b = Model.Basvuru;
    bool ro = Model.SaltOkunur;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<section class="basvuru-panel active" data-panel="12">
    <h2>@L["Basvuru.CevreselSosyal.Title"]</h2>
    <p>@L["Basvuru.CevreselSosyal.Description"]</p>

    <input type="hidden" id="cevreselSosyalJson" value="" />
    <input type="hidden" id="cevreselSosyalYatirimKapsami" value="" />
    <script type="application/json" id="cevreselSosyalAdresleriJson">
        @Html.Raw(JsonSerializer.Serialize(b.YatirimAdresleri.OrderBy(x => x.siraNo).Select(x => new
        {
            id = x.id,
            etiket = $"{x.siraNo}. {x.ilAdi} / {x.ilceAdi} - {x.tamAdres}",
            yatirimTurleri = x.yatirimTurleri,
            cevreselSosyalJson = x.cevreselSosyalJson
        }), jsonOptions))
    </script>
    <script type="application/json" id="cevreselSosyalSoruTanimlariJson">
        @Html.Raw(JsonSerializer.Serialize(CevreselSosyalAnketTanimlari.Tum, jsonOptions))
    </script>
    <script type="application/json" id="cevreselSosyalOtomatikCevaplarJson">
        @Html.Raw(JsonSerializer.Serialize(CevreselSosyalVeriFormuTanimlari.OtomatikCevaplar(b), jsonOptions))
    </script>

    <div class="esf-mode-box">
        <label>
            Yatırım adresi <span class="required-mark">*</span>
            <select id="cevreselSosyalAdresId">
                <option value="">@L["Basvuru.Common.Select"]</option>
                @foreach (var adres in b.YatirimAdresleri.OrderBy(x => x.siraNo))
                {
                    <option value="@adres.id">@adres.siraNo. @adres.ilAdi / @adres.ilceAdi - @adres.tamAdres</option>
                }
            </select>
        </label>
        <div id="cevreselSosyalAdresKapsami" class="esf-sub-note">Önce anketin doldurulacağı adresi seçiniz.</div>
    </div>

    <div id="cevreselSosyalAnket"></div>

    <div id="cevreselSosyalBeyanlari" class="box"></div>
</section>
