        document.getElementById('denetimDosya')?.addEventListener('change', function () {
            dosyaSecimYaz(this, 'denetimDosyaSecim', 'Basvuru.mali.DenetimDosyaAdi');
            DenetimDosyasiYukle();
        });
        document.getElementById('bagimsizDenetimeTabiMi')?.addEventListener('change', DenetimDosyaBolumuGuncelle);

        document.querySelectorAll('.mali-belge-input').forEach(input => {
            const ref = basvuruMaliBelgeReferanslari[input.dataset.refKey] || {};
            MaliDosyaGorunumGuncelle(ref, input.dataset.nameTarget, input.dataset.downloadTarget);
            input.addEventListener('change', function () {
                BasvuruDosyasiYukle('Basvuru_MaliBelge', Number(this.dataset.dosyaNo), this, this.dataset.nameTarget, this.dataset.downloadTarget, sonuc => {
                    const nesne = sonuc?.nesne || sonuc?.Nesne || {};
                    basvuruMaliBelgeReferanslari[this.dataset.refKey] = { dosyaId: nesne.dosyaId || nesne.DosyaId, dosyaAdi: nesne.dosyaAdi || nesne.DosyaAdi || '' };
