    function MakineTeklifDosyasiYukle(input){const teklifId=Number(input.dataset.teklifId||0);if(!teklifId||!input.files?.length)return;const fd=new FormData();fd.append('basvuruId',BasvuruId());fd.append('formAd','BMT_'+teklifId);fd.append('dosyaNo','1');fd.append('dosya',input.files[0]);fetch('/Basvuru/BasvuruDosyasiYukle',{method:'POST',headers:{'RequestVerificationToken':antiForgeryToken()},body:fd}).then(r=>r.json()).then(sonuc=>{SonucGoster(sonuc);if(sonuc?.basarili){input.closest('td').querySelector('.t-dosya-adi').textContent=sonuc.nesne?.dosyaAdi||input.files[0].name;}});}
