    function AdresModalIlVeIlceleriGuncelle(seciliIlceId) {
        const ilAlani = document.querySelector('[name="Basvuru.IlId"]');
        const ilId = Number(ilAlani?.value || basvuruIlId || 0);
        const ilAdi = ilAlani?.selectedOptions?.[0]?.textContent?.trim()
            || uygulamaAdresiIlleri.find(il => Number(il.id) === ilId)?.ad
            || '';
        modalSet('adresModalIl', ilAdi);

        const ilceAlani = document.getElementById('adresModalIlce');
        if (!ilceAlani) return;
        ilceAlani.innerHTML = `<option value="">${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Common.Select"))))}</option>`;
        uygulamaAdresiIlceleri
            .filter(ilce => Number(ilce.ilId) === ilId)
            .forEach(ilce => {
                const option = document.createElement('option');
                option.value = String(ilce.id);
                option.textContent = ilce.ad || '';
                if (Number(ilce.segeKademesi) > 0) option.dataset.sege = String(ilce.segeKademesi);
                ilceAlani.appendChild(option);
            });
        modalSet('adresModalIlce', seciliIlceId);
        AdresSegeKademesiniGuncelle();
