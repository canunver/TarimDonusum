    function MakineKaydet(){const eski=JSON.parse(document.getElementById('makineIndex').dataset.model||'{}');const model={...eski,id:eski.id||0,basvuruId:BasvuruId(),teklifKontroluYapilsin:true,siraNo:Number(document.getElementById('makineSira').value),ad:document.getElementById('makineAd').value,birim:document.getElementById('makineBirim').value,miktar:Number(document.getElementById('makineMiktar').value),aciklama:document.getElementById('makineAciklama').value,teknikOzellikler:[...document.querySelectorAll('#makineOzellikler tr')].map(r=>({id:Number(r.dataset.id||0),siraNo:Number(r.querySelector('.o-sira').value),baslik:r.querySelector('.o-baslik').value,aciklamaAsgariGereklilik:r.querySelector('.o-aciklama').value,zorunluMu:r.querySelector('.o-zorunlu').value==='true'})),teklifler:[...document.querySelectorAll('#makineTeklifler .makine-teklif')].map(r=>{const d=r.nextElementSibling;return {id:Number(r.dataset.id||0),siraNo:Number(r.querySelector('.t-sira').value),basvuruyaEsas:r.querySelector('.t-esas').checked,tedarikci:r.querySelector('.t-tedarikci').value,marka:r.querySelector('.t-marka').value,model:r.querySelector('.t-model').value,paraBirimi:r.querySelector('.t-para').value,kur:Number(r.querySelector('.t-kur').value)||null,birimFiyat:YatirimOzetiSayi(r.querySelector('.t-fiyat').value)||null,teklifTarihi:d.querySelector('.t-tarih').value||null,gecerlilikTarihi:d.querySelector('.t-gecerlilik').value||null,teklifBelgesiDosyaId:(eski.teklifler||[]).find(x=>x.id===Number(r.dataset.id||0))?.teklifBelgesiDosyaId||null,teklifBelgesiDosyaAdi:(eski.teklifler||[]).find(x=>x.id===Number(r.dataset.id||0))?.teklifBelgesiDosyaAdi||'',aciklama:d.querySelector('.t-aciklama').value};})};AjaxPost('/Basvuru/MakineKaydet',model,sonuc=>{SonucGoster(sonuc);if(sonuc?.basarili&&sonuc.nesne){const i=Number(document.getElementById('makineIndex').value);if(i>=0)basvuruMakineleri[i]=sonuc.nesne;else basvuruMakineleri.push(sonuc.nesne);$('#makineModal').modal('hide');MakineListeRender(