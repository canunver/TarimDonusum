    function RenderUygulamaAdresleri(uygulamaAdresleri) {
        const tbody = document.getElementById('uygulamaAdresListesi');
        if (!tbody) return;
        const hakTbody = document.getElementById('yatirimYeriKullanimHaklariListesi');
        const basvuruYatirimSayfasi = active === bolumBasvuruYatirimBilgileri;
        sonUygulamaAdresleri = uygulamaAdresleri || [];
        tbody.innerHTML = '';
        if (hakTbody) hakTbody.innerHTML = '';
        if (sonUygulamaAdresleri.length === 0) {
            const bosSatir = (hedef, sutun) => { if (!hedef) return; const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=String(sutun);td.className='text-muted text-center';td.textContent=adresBosMesaj;tr.appendChild(td);hedef.appendChild(tr); };
            bosSatir(tbody, basvuruYatirimSayfasi ? (basvuruReadonly ? 8 : 9) : (YapimIsiSecili() ? 8 : 7));
            bosSatir(hakTbody, 9);
            return;
        }
        sonUygulamaAdresleri.forEach((adres, index) => {
            const tr = document.createElement('tr');
            const alanlar = basvuruYatirimSayfasi
                ? [adres.siraNo, adres.ilAdi, adres.ilceAdi, adres.segeKademesi, adres.tamAdres, adres.koordinat, adres.adaParsel, adres.adresBelgeDosyaAdi]
                : [adres.siraNo, adres.ilAdi, adres.ilceAdi, adres.tamAdres, adres.yatirimYeriStatusuAd, adres.kiraTahsisBitis];
            if (!basvuruYatirimSayfasi && YapimIsiSecili()) alanlar.push(adres.yapiRuhsatiDurumuAd);
            alanlar.forEach((value, alanIndex) => { const td=document.createElement('td');
                if (basvuruYatirimSayfasi && alanIndex === 7) BelgeBaglantisiEkle(td, adres.adresBelgeDosyaId, adres.adresBelgeDosyaAdi);
                else td.textContent=value || '';
                if((basvuruYatirimSayfasi && alanIndex===4)||(!basvuruYatirimSayfasi && alanIndex===3))td.className='adres-tam-adres';tr.appendChild(td); });
            if (!basvuruReadonly) {
                const actionTd=document.createElement('td');
                const editBtn=document.createElement('button');editBtn.type='button';editBtn.className='btn btn-sm btn-outline-secondary mr-1';editBtn.innerHTML='<i class="fas fa-edit"></i>';editBtn.addEventListener('click',()=>adresModalAc(index));
                const deleteBtn=document.createElement('button');deleteBtn.type='button';deleteBtn.className='btn btn-sm btn-outline-danger';deleteBtn.innerHTML='<i class="fas fa-trash"></i>';deleteBtn.addEventListener('click',()=>{if(confirm(adresSilOnay))adresSil(adres.id);});
                actionTd.appendChild(editBtn);actionTd.appendChild(deleteBtn);tr.appendChild(actionTd);
            }
            tbody.appendChild(tr);
            if (hakTbody) {
                const hakTr=document.createElement('tr');
                const hakAlanlar=[adres.siraNo,adres.yatirimYeriStatusuAd,tarihGorunum(adres.kullanimHakkiBaslangicTarihi),tarihGorunum(adres.kiraTahsisBitisTarihi),adres.donemleriKapsiyorMu==null?'':(adres.donemleriKapsiyorMu?'Evet':'Hayır'),adres.kullanimHakkiDosyaAdi,adres.yapiRuhsatiDurumuAd,adres.izinTakvimAciklama,adres.kanitDosyaAdi];
                hakAlanlar.forEach((value, alanIndex)=>{const td=document.createElement('td');
                    if(alanIndex===5) BelgeBaglantisiEkle(td, adres.kullanimHakkiDosyaId, adres.kullanimHakkiDosyaAdi);
                    else if(alanIndex===8) BelgeBaglantisiEkle(td, adres.kanitDosyaId, adres.kanitDosyaAdi);
                    else td.textContent=value || '';
                    hakTr.appendChild(td);});
                hakTbody.appendChild(hakTr);
            }
        });
    }

    function BelgeBaglantisiEkle(hucre, dosyaId, dosyaAdi) {
        if (!dosyaId) { hucre.textContent = 'Yüklenmedi'; hucre.classList.add('text-muted'); return; }
        const link = document.createElement('a');
        link.href = `/Basvuru/DosyaIndir/${dosyaId}`;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = dosyaAdi || 'İndir';
        link.className = 'document-download-link';
        hucre.appendChild(link);
    }
    function tarihGorunum(value) {
        if (!value) return '';
        const parca=String(value).substring(0,10).split('-');
        return parca.length===3 ? `${parca[2]}.${parca[1]}.${parca[0]}` : value;
    }
