    function BasvuruBeyanBolumuIlklendir() {
        let data = {};
        try { data = JSON.parse(document.getElementById('basvuruBeyanJson')?.textContent || '{}'); } catch { data = {}; }
        const kayitlar = Array.isArray(data.satirlar) ? data.satirlar : [];
        document.querySelectorAll('#basvuruBeyanSatirlari tr').forEach(row => {
            const no = Number(row.dataset.no || 0);
            const kayit = kayitlar.find(x => Number(x.no) === no) || {};
            row.querySelector('.beyan-kabul').value = kayit.kabul ? String(kayit.kabul) : '';
            row.querySelector('.beyan-aciklama').value = kayit.aciklama || '';
        });
        const yetkili = document.getElementById('beyanYetkiliKisi'); if (yetkili) yetkili.value = data.yetkiliKisi || '';
        const gorev = document.getElementById('beyanGorevi'); if (gorev) gorev.value = data.gorevi || '';
    }

    function BasvuruBeyanKaydet(afterSuccess) {
