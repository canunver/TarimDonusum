            return;
        }

        BasvuruDosyasiYukle(UboKycFormAdOlustur(ortak.tcknVkn), 1, input, 'ortakUboKycDosyaAdi', 'ortakUboKycIndirBtn', function (sonuc) {
            const nesne = sonuc?.nesne || sonuc?.Nesne || {};
            ortak.uboKycDosyaId = nesne.dosyaId || nesne.DosyaId || null;
            ortak.uboKycBelgeAdi = nesne.dosyaAdi || nesne.DosyaAdi || '';
            OrtakModalUboKycDurumGuncelle();
            OrtaklarRender();
        });
    }

    function UboKycFormAdOlustur(tcknVkn) {
        return `OBOKYC_${TcknVknNormalize(tcknVkn)}`;
    }

    function TcknVknNormalize(tcknVkn) {
        return String(tcknVkn || '').trim().replace(/[^0-9A-Za-z]/g, '').toLocaleUpperCase('tr-TR');
    }

    function SadeceRakamAlaniIlklendir(alan, uzunluk) {
        if (!alan || alan.dataset.numericInitialized === 'true') return;
        alan.dataset.numericInitialized = 'true';
        alan.inputMode = 'numeric';
        alan.maxLength = uzunluk;
        alan.addEventListener('input', () => {
            alan.value = alan.value.replace(/\D/g, '').slice(0, alan.maxLength);
        });
    }

    function TcknGecerliMi(value) {
        const tckn = String(value || '').trim();
        if (!/^\d{11}$/.test(tckn) || tckn[0] === '0' || /^(\d)\1{10}$/.test(tckn)) return false;
        const d = [...tckn].map(Number);
        const onuncu = ((7 * (d[0] + d[2] + d[4] + d[6] + d[8]) - (d[1] + d[3] + d[5] + d[7])) % 10 + 10) % 10;
        return d[9] === onuncu && d[10] === d.slice(0, 10).reduce((toplam, x) => toplam + x, 0) % 10;
    }

    function VknGecerliMi(value) {
        const vkn = String(value || '').trim();
        if (!/^\d{10}$/.test(vkn) || /^(\d)\1{9}$/.test(vkn)) return false;
        const d = [...vkn].map(Number);
        let toplam = 0;
        for (let i = 0; i < 9; i++) {
            const basamak = (d[i] + 9 - i) % 10;
            toplam += basamak === 9 ? 9 : (basamak * (2 ** (9 - i))) % 9;
        }
        return d[9] === (10 - (toplam % 10)) % 10;
    }

    function OrtakSecimMetni(value) {
        if (value === 'Gerçek Kişi') return ortakMetinleri.naturalPerson;
        if (value === 'Tüzel Kişi') return ortakMetinleri.legalEntity;
        if (value === 'Özel') return ortakMetinleri.privateSector;
        if (value === 'Kamu') return ortakMetinleri.publicSector;
        return value || '';
    }

    function OrtaklikOzetGuncelle() {
        const toplamPay = basvuruOrtaklari.reduce((sum, ortak) => sum + Number(ortak.payOrani || 0), 0);
        const ozelPay = basvuruOrtaklari
            .filter(ortak => ortak.ozelKamuNiteligi === 'Özel')
            .reduce((sum, ortak) => sum + Number(ortak.payOrani || 0), 0);
        const ozelInput = document.getElementById('privateShareCalculated');
        if (ozelInput) ozelInput.value = sayiYaz(ozelPay);
        const kadinPay = basvuruOrtaklari.filter(x => x.sahiplikNiteligi === 'Kadın' || x.sahiplikNiteligi === 'Her ikisi').reduce((s,x)=>s+Number(x.payOrani||0),0);
        const gencPay = basvuruOrtaklari.filter(x => x.sahiplikNiteligi === '40 yaş altı' || x.sahiplikNiteligi === 'Her ikisi').reduce((s,x)=>s+Number(x.payOrani||0),0);
        const toplamInput=document.getElementById('partnershipTotal'); if(toplamInput) toplamInput.value=sayiYaz(toplamPay);
        const kadinInput=document.getElementById('femaleOwnershipCalculated'); if(kadinInput) kadinInput.value=sayiYaz(kadinPay);
        const gencInput=document.getElementById('youngOwnershipCalculated'); if(gencInput) gencInput.value=sayiYaz(gencPay);

        const alert = document.getElementById('partnerAlerts');
        if (!alert) return;
        if (toplamPay > 100) {
            alert.innerHTML = `<div class="alert alert-danger">${htmlEncode(ortakMetinleri.totalShareExceeded)}</div>`;
        }
        else {
            alert.innerHTML = '';
        }
    }

    function TuzelOrtakMaliRender() {
        const container = document.getElementById('legalPartnerFinancials');
        if (!container) return;
        const tuzelOrtaklar = basvuruOrtaklari.filter(ortak => ortak.kisiTuru === 'Tüzel Kişi');
        if (tuzelOrtaklar.length === 0) {
            container.innerHTML = '';
            return;
        }

        const toplamlar = tuzelOrtaklar.reduce((toplam, ortak) => {
            const carpan = HesabaDahilOranHesapla(ortak.payOrani) / 100;
            toplam.oncekiNet += Number(ortak.oncekiYilNetSatis || 0) * carpan;
            toplam.sonNet += Number(ortak.sonYilNetSatis || 0) * carpan;
            toplam.oncekiAktif += Number(ortak.oncekiYilAktifToplami || 0) * carpan;
            toplam.sonAktif += Number(ortak.sonYilAktifToplami || 0) * carpan;
            return toplam;
        }, { oncekiNet: 0, sonNet: 0, oncekiAktif: 0, sonAktif: 0 });

        let html = `<h3 class="subhead">${htmlEncode(ortakMetinleri.legalFinancialTitle)}</h3>
            <div class="table-responsive"><table class="table table-bordered legal-financial-table"><thead><tr>
                <th>${htmlEncode(oncekiMaliYil)} ${htmlEncode(ortakMetinleri.netSalesShort)}</th><th>${htmlEncode(sonMaliYil)} ${htmlEncode(ortakMetinleri.netSalesShort)}</th><th>${htmlEncode(oncekiMaliYil)} ${htmlEncode(ortakMetinleri.assetsShort)}</th><th>${htmlEncode(sonMaliYil)} ${htmlEncode(ortakMetinleri.assetsShort)}</th>
            </tr></thead><tbody>`;
        html += `<tr class="font-weight-bold"><td>${sayiYaz(toplamlar.oncekiNet)}</td><td>${sayiYaz(toplamlar.sonNet)}</td><td>${sayiYaz(toplamlar.oncekiAktif)}</td><td>${sayiYaz(toplamlar.sonAktif)}</td></tr>`;
        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    function OrtaklikKaydet(afterSuccess, bosBagliSecimiHayirSay) {
        const bagliOrtakVarMi = basvuruOrtaklari.some(ortak => ortak.kisiTuru === 'Tüzel Kişi');
        const model = {
            ...BasvuruKimlikleri(),
            bagliOrtakIsletmeVarMi: bagliOrtakVarMi,
            ozelSektorPayi: sayiOkuId('privateShareCalculated'),
            ortaklar: [basvuruOrtaklari.find(x => x.siraNo === degisenOrtakSiraNo)],
            bagliOrtakUnvani: '',
            bagliOrtakKimlikNo: '',
            bagliOrtakOncekiYilNetSatis: null,
            bagliOrtakSonYilNetSatis: null,
            bagliOrtakOncekiYilAktifToplami: null,
            bagliOrtakSonYilAktifToplami: null
        };
        AjaxPost('/Basvuru/KaydetOrtaklik', model, function (sonuc) {
            if (sonuc?.basarili) {
                dirty = false;
                if (afterSuccess) afterSuccess(sonuc);
            }
            SonucGoster(sonuc);
        });
    }

    function OrtaklarKaydet(afterSuccess, degisenOrtakSiraNo) {
        const model = {
            ...BasvuruKimlikleri(),
            ortaklar: [basvuruOrtaklari.find(x => x.siraNo === degisenOrtakSiraNo)],
            degisenOrtakSiraNo: degisenOrtakSiraNo || null
        };
        AjaxPost('/Basvuru/KaydetOrtaklar', model, function (sonuc) {
            if (sonuc?.basarili) {
