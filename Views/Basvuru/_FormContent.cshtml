    function adresKaydet(adres) {
        AjaxPost('/Basvuru/UygulamaAdresiKaydet', adres, function (sonuc) {
            if (!sonuc?.basarili || !sonuc?.nesne) { SonucGoster(sonuc); return; }
            const adresId = sonuc.nesne.id || sonuc.nesne.Id;
            const dosyalar = [
                { input: 'adresModalAdresBelgeDosya', no: 1 },
                { input: 'adresModalKullanimHakkiDosya', no: 2 },
                { input: 'adresModalKanitDosya', no: 3 }
            ].filter(x => document.getElementById(x.input)?.files?.length);
            const tamamla = () => { UygulamaAdresleriListele(); uygulamaAdresModal?.hide(); SonucGoster(sonuc); };
            if (!dosyalar.length) { tamamla(); return; }
            let kalan = dosyalar.length;
            dosyalar.forEach(x => BasvuruDosyasiYukle(`BYAT_${adresId}`, x.no, document.getElementById(x.input), '', '', () => { if (--kalan === 0) tamamla(); }));
        });
