    function YatirimEkipmanModalAc(index){const m=index>=0?yatirimEkipmanlari[index]:{id:0,basvuruId:BasvuruId(),siraNo:yatirimEkipmanlari.length+1,ad:'',birim:'Adet',miktar:1,aciklama:'',teknikOzellikler:[],teklifler:[]};document.getElementById('yatirimEkipmanIndex').value=index;document.getElementById('yatirimEkipmanIndex').dataset.model=JSON.stringify(m);modalSet('yeAd',m.ad);modalSet('yeMarka',m.marka);modalSet('yeModel',m.model);modalSet('yeAdet',m.miktar);modalSet('yePlanSira',m.yerlesimPlaniSiraNo);modalSet('yeDurum',m.durum);modalSet('yeKapasite',m.kapasiteOzellikleri);modalSet('yeKullanimAmaci',m.kullanimAmaci);modalSet('yeKapasiteGerekcesi',m.kapasiteSecimGerekcesi);YatirimEkipmanDurumAlanlariGuncelle();$('#yatirimEkipmanModal').modal('show');}
