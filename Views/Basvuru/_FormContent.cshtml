            });
        });
        document.querySelectorAll('[name^="Basvuru.mali."]').forEach(input => {
            input.addEventListener('input', BasvuruMaliKonsolideGuncelle);
            input.addEventListener('change', BasvuruMaliKonsolideGuncelle);
        });
        DenetimDosyaBolumuGuncelle();
        BasvuruMaliIsletmeleriRender();
        BasvuruMaliKonsolideGuncelle();
    }

