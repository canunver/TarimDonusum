    function BilancoGelirBolumuIlklendir(){document.querySelectorAll('.bilanco-gelir-input').forEach(x=>x.addEventListener('input',BilancoGelirHesapla));BilancoGelirHesapla();}
    function BilancoGelirHesapla(){
        const v=(kod,yil)=>BilancoGelirSayiOku(document.querySelector(`.bilanco-gelir-input[data-kod="${kod}"][data-yil="${yil}"]`))||0;
        const yaz=(kod,yil,deger)=>{const e=document.querySelector(`.bilanco-hesap[data-hesap="${kod}"][data-yil="${yil}"]`);if(e)e.textContent=deger==null?'':deger.toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2});};
        for(let y=1;y<=3;y++){const donen=v('DONEN_VARLIKLAR',y),aktif=donen+v('DURAN_VARLIKLAR',y),kvyk=v('KISA_VADELI_YABANCI_KAYNAKLAR',y),uvyk=v('UZUN_VADELI_YABANCI_KAYNAKLAR',y),oz=v('OZ_KAYNAKLAR',y),pasif=kvyk+uvyk+oz,netSatis=v('BRUT_SATISLAR',y)-v('SATIS_INDIRIMLERI',y),brut=netSatis-v('SATISLARIN_MALIYETI',y),faaliyet=brut-v('FAALIYET_GIDERLERI',y),olagan=faaliyet+v('DIGER_OLAGAN_GELIR_KARLAR',y)-v('DIGER_OLAGAN_GIDER_ZARARLAR',y)-v('FINANSMAN_GIDERLERI',y),donem=olagan+v('OLAGANDISI_GELIR_KARLAR',y)-v('OLAGANDISI_GIDER_ZARARLAR',y),net=donem-v('VERGI_YASAL_YUKUMLULUK',y),bol=(a,b,c=1)=>b===0?null:a/b*c;
        const h={AKTIF_TOPLAMI:aktif,PASIF_TOPLAMI:pasif,NET_SATISLAR:netSatis,BRUT_SATIS_KARI:brut,FAALIYET_KARI:faaliyet,OLAGAN_KAR:olagan,DONEM_KARI:donem,NET_KAR:net,NET_ISLETME_SERMAYESI:donen-kvyk,CARI_ORAN:bol(donen,kvyk),LIKIDITE_ORANI:bol(donen-v('STOKLAR',y),kvyk),FINANSMAN_ORANI:bol(kvyk+uvyk,oz,100),FAALIYET_KARLILIGI:bol(faaliyet,netSatis,100),BILANCO_KARLILIGI:bol(donem,kvyk,100),OZSERMAYE_KARLILIGI:bol(net,oz,100),AKTIF_KARLILIGI:bol(net,aktif,100),FAVOK:faaliyet+v('DONEM_AMORTISMAN',y)};Object.entries(h).forEach(([k,d])=>yaz(k,y,d));}
    }
