    function FinansTutarlariniHesapla() {
        const toplamAlani = document.querySelector('[name="Basvuru.finans.ToplamYatirimTutari"]');
        const oranAlani = document.querySelector('[name="Basvuru.finans.TalepEdilenFinansmanOrani"]');
        // Toplam yatırım alanı kuruşsuz para alanıdır; nokta/virgül gibi
        // görüntüleme ayraçlarından bağımsız olarak yalnızca rakamları oku.
        const toplamMetni = (toplamAlani?.value || '').replace(/[^0-9]/g, '');
        const toplam = Number(toplamMetni || 0);
        const oran = Number(oranAlani?.value || 0);
        const finansman = Math.round(toplam * oran) / 100;
        const ozKaynak = Math.max(0, toplam - finansman);
        const finansmanAlani = document.querySelector('[name="Basvuru.finans.TalepEdilenDestekTutari"]');
        const ozKaynakAlani = document.querySelector('[name="Basvuru.finans.BasvuruSahibiKatkisi"]');
        if (finansmanAlani) finansmanAlani.value = Math.round(finansman).toLocaleString('tr-TR');
        if (ozKaynakAlani) ozKaynakAlani.value = Math.round(ozKaynak).toLocaleString('tr-TR');
        const onceki = degerDec('Basvuru.finans.OncekiRffOnayliTutar') || 0;
        const kumulatif = document.getElementById('finansKumulatifKontrol');
        const islem = document.getElementById('finansIslemKontrol');
        const teminat = document.getElementById('finansTeminatTutari');
        const finansPaneli = document.querySelector('[data-finans-alt-limit]');
        const altLimit = Number(finansPaneli?.dataset.finansAltLimit || 0);
        const ustLimit = Number(finansPaneli?.dataset.finansUstLimit || 0);
        if (kumulatif) kumulatif.value = ustLimit <= 0 || onceki + finansman <= ustLimit ? 'UYGUN' : 'UYGUN DEĞİL';
        if (islem) islem.value = (altLimit <= 0 || finansman >= altLimit) && (ustLimit <= 0 || finansman <= ustLimit) ? 'UYGUN' : 'UYGUN DEĞİL';
        if (teminat) teminat.value = Math.round(finansman * 1.1).toLocaleString('tr-TR');
    }

    // Form partial olarak DOMContentLoaded sonrasında yüklense de hesaplama çalışsın.
    window.FinansTutarlariniHesapla = FinansTutarlariniHesapla;

