    function MakineTeklifSatir(t,i){return `<tr class="makine-teklif" data-id="${t.id||0}" style="border-top:3px solid #8da2b8"><td rowspan="2" style="width:90px;min-width:90px;vertical-align:middle;text-align:center;background:#f2f5f9;border-right:2px solid #8da2b8;border-bottom:3px solid #8da2b8"><div class="d-flex flex-column align-items-center"><input class="t-sira form-control text-center" type="number" min="1" max="99" style="width:58px;min-width:58px;font-size:1.15rem;font-weight:700" value="${t.siraNo||i+1}"><label class="mt-2 mb-0 font-weight-bold" title="Başvuruya esas teklif"><input class="t-esas" type="radio" name="makineEsasTeklif" ${t.basvuruyaEsas?'checked':''}> Esas</label></div></td><td><input class="t-tedarikci form-control" value="${htmlEncode(t.tedarikci||'')}"></td><td><input class="t-marka form-control" value="${htmlEncode(t.marka||'')}"></td><td><input class="t-model form-control" value="${htmlEncode(t.model||'')}"></td><td><select class="t-para form-control">${genelParaBirimleri.map(x=>`<option ${t.paraBirimi===x?'selected':''}>${x}</option>`).join('')}</select></td><td><input class="t-kur form-control" type="number" min="0" step="0.000001" value="${t.kur||''}"></td><td><input class="t-fiyat form-control" type="text" inputmode="decimal" value="${t.birimFiyat?htmlEncode(YatirimOzetiParaKuruslu(YatirimOzetiSayi(t.birimFiyat))):''}" onblur="MakineTeklifBirimFiyatCikis(this)"></td></tr><tr class="makine-teklif-detay" style="border-bottom:3px solid #8da2b8"><td colspan="6"><div style="display:grid;grid-template-columns:190px 190px minmax(320px,1fr) minmax(240px,.75fr);gap:16px;align-items:start"><label class="mb-0">Teklif tarihi<input class="t-tarih form-control" type="date" value="${(t.teklifTarihi||'').substring(0,10)}"></label><label class="mb-0">Geçerlilik tarihi<input class="t-gecerlilik form-control" type="date" value="${(t.gecerlilikTarihi||'').substring(0,10)}"></label><label class="mb-0">Açıklama<textarea class="t-aciklama form-control">${htmlEncode(t.aciklama||'')}</textarea></label><label class="mb-0">Teklif belgesi<input class="t-dosya form-control-file mt-1" type="file" data-teklif-id="${t.id||0}" onchange="MakineTeklifDosyasiYukle(this)" ${t.id?'':'disabled'}><small class="t-dosya-adi">${htmlEncode(t.teklifBelgesiDosyaAdi||'')}${t.id?'':' (Belge için önce teklifi kaydedin)'}</small></label></div></td></tr>`;}
