    let metrajVerisi={binalar:[],pozlar:[]},metrajBinaIndex=0,metrajBolumIndex=0,metrajDetayTaslak=[];
    const MetrajPara=v=>(Number(v)||0).toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2})+' TL';
    const MetrajSayi=v=>(Number(v)||0).toLocaleString('tr-TR',{maximumFractionDigits:4});
    function MetrajMiktar(d){const a=[d.adet,d.boy,d.en,d.yukseklik].filter(x=>x!==null&&x!==undefined&&x!=='').map(Number);return a.length?a.reduce((t,x)=>t*x,1):0;}
    function MetrajPozMiktar(p){return (p.detaylar||[]).reduce((t,d)=>t+MetrajMiktar(d),0);}
    function MetrajPozMaliyet(p){return MetrajPozMiktar(p)*(Number(p.birimFiyat)||0);}
    function MetrajBolumMaliyet(b){return (b?.pozlar||[]).reduce((t,p)=>t+MetrajPozMaliyet(p),0);}
    function MetrajBinaMaliyet(b){return (b?.bolumler||[]).reduce((t,x)=>t+MetrajBolumMaliyet(x),0);}
