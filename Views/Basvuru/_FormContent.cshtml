    function BasvuruMaliKonsolideGuncelle() {
        const own = { oncekiNet:degerDec('Basvuru.mali.OncekiYilNetSatis')||0, sonNet:degerDec('Basvuru.mali.SonYilNetSatis')||0, oncekiAktif:degerDec('Basvuru.mali.OncekiYilAktifToplami')||0, sonAktif:degerDec('Basvuru.mali.SonYilAktifToplami')||0 };
        basvuruMaliIsletmeleri.forEach(x => { const oran=Number(x.hesabaDahilOran||0)/100; own.oncekiNet+=Number(x.oncekiYilNetSatis||0)*oran; own.sonNet+=Number(x.sonYilNetSatis||0)*oran; own.oncekiAktif+=Number(x.oncekiYilAktifToplami||0)*oran; own.sonAktif+=Number(x.sonYilAktifToplami||0)*oran; });
        const set=(id,value)=>{const el=document.getElementById(id);if(el)el.value=sayiYaz(value);};
        set('maliKonsolideOncekiNet',own.oncekiNet); set('maliKonsolideSonNet',own.sonNet); set('maliKonsolideOncekiAktif',own.oncekiAktif); set('maliKonsolideSonAktif',own.sonAktif);
        const degerler=[own.oncekiNet,own.sonNet,own.oncekiAktif,own.sonAktif];
        const olcekUygun=degerler.some(x=>x>=100000000&&x<=4000000000);
        const olcek=document.getElementById('maliKonsolideOlcek'); if(olcek)olcek.value=olcekUygun?'Uygun':'Uygun Değil';
        const satis=(degerDec('Basvuru.mali.OncekiYilNetSatis')||0)+(degerDec('Basvuru.mali.SonYilNetSatis')||0);
        const ihracat=(degerDec('Basvuru.mali.OncekiYilIhracatSatis')||0)+(degerDec('Basvuru.mali.SonYilIhracatSatis')||0);
        const oran=document.getElementById('basvuruMaliIhracatOrani'); if(oran)oran.textContent=satis>0?(ihracat/satis*100).toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2})+' %':'-';
    }
    function PaneliKaydet(afterSuccess) {
        if (active === bolumFirma || active === bolumBasvuruSahibi) BasvuruSahibiKaydet(afterSuccess);
        else if (active === bolumIrtibat) FirmaIrtibatKaydet(afterSuccess);
        else if (active === bolumYatirim || active === bolumBasvuruDegerZinciri) DegerZinciriKaydet(afterSuccess);
        else if (active === bolumUygulamaAdresi || active === bolumBasvuruYatirimBilgileri) YatirimBilgileriKaydet(afterSuccess);
        else if (active === bolumUygunHarcama) UygunHarcamaKaydet(afterSuccess);
        else if (active === bolumFinans || active === bolumBasvuruFinansman) FinansKaydet(afterSuccess);
        else if (active === bolumYatirimOzeti) YatirimOzetiKaydet(afterSuccess);
        else if (active === bolumDbCtpTeknikProje) DbCtpKaydet(afterSuccess);
        else if (active === bolumTaahhutBeyan) TaahhutBeyanlariKaydet(afterSuccess);
        else if (active === bolumBasvuruTaahhutBeyan) BasvuruBeyanKaydet(afterSuccess);
        else if (active === bolumBasvuruCevreselSosyal) BasvuruCevreselSosyalKaydet(afterSuccess);
        else if (active === bolumMali || active === bolumBasvuruMaliVeriler) MaliKaydet(afterSuccess);
        else if (active === bolumBasvuruBilancoGelir) BilancoGelirKaydet(afterSuccess);
        else if (active === bolumOrtaklik) OrtaklikKaydet(afterSuccess);
        else if (active === bolumCevreselSosyal) CevreselSosyalKaydet(afterSuccess);
        else if (active === bolumSistemSonuclari || active === bolumUzmanSonuclari) {
            const panel = document.querySelector('[data-list-type]');
            const button = document.getElementById('basvuruKaydetBtn');
            if (panel?._denetimListesiKaydet && button) panel._denetimListesiKaydet(button, afterSuccess);
        }
        else if (active === bolumKarar) {
            const button = document.getElementById('basvuruKaydetBtn');
            if (button) DenetimKaydet(button, false, afterSuccess);
        }
        else if (active === bolumBelgeler) PopupMesajGoster(belgeMesajlari.sectionSaveInfo, true);
        else PopupMesajGoster(String(active), false);
    }

    function degerZinciriAsamalariYukle(zincirId) {
        const kimlik = BasvuruKimlikleri();
        const $tbody = $('#degerZinciriAsamaListesi');
        $tbody.empty();
        if (!zincirId) return;
        AjaxGet('/Basvuru/DegerZinciriAsamalariListele', { ...kimlik, zincirId: zincirId }, function (response) {
            if (response && response.nesne) {
                const isReadOnly = $('#degerZinciriSelect').is(':disabled') ? 'disabled' : '';
                $.each(response.nesne, function (_, item) {
                    const checkedAttr = item.secili ? 'checked="checked"' : '';
                    const faaliyet = item.yapilacakFaaliyetler || item.YapilacakFaaliyetler || '';
                    const disabledAttr = isReadOnly || !item.secili ? 'disabled' : '';
                    $tbody.append(`<tr>
                        <td class="text-center"><input type="checkbox" name="Basvuru.DegerZinciriAsamalari" value="${item.id}" ${checkedAttr} ${isReadOnly} /></td>
                        <td><strong>${htmlEncode(item.ad || '')}</strong></td>
                        <td>${htmlEncode(item.aciklama || '')}</td>
                        <td>
                            <textarea class="deger-zinciri-faaliyet" data-asama-id="${item.id}" maxlength="500" ${disabledAttr} placeholder="Seçilen aşama için en fazla 500 karakter">${htmlEncode(faaliyet)}</textarea>
                            <div class="char-counter"><span>${faaliyet.length}</span>/500</div>
                        </td>
                    </tr>`);
                });
                DegerZinciriFaaliyetIlklendir();
            }
        });
    }

    function DegerZinciriFaaliyetIlklendir() {
        $('#degerZinciriAsamaListesi input[name="Basvuru.DegerZinciriAsamalari"]').off('change.faaliyet').on('change.faaliyet', function () {
            const textarea = $(`textarea.deger-zinciri-faaliyet[data-asama-id="${this.value}"]`);
            textarea.prop('disabled', !this.checked);
            dirty = true;
        });
        $('#degerZinciriAsamaListesi textarea.deger-zinciri-faaliyet').off('input.faaliyet').on('input.faaliyet', function () {
            const value = this.value || '';
            $(this).siblings('.char-counter').find('span').text(value.length);
            dirty = true;
        });
    }

    function degerZinciriYukle() {
        const ilAlani = $('#basvuruIl');
        const ilId = ilAlani.length ? ilAlani.val() : basvuruIlId;
        const kimlik = BasvuruKimlikleri();
        const $select = $('#degerZinciriSelect');
        $select.html('<option value="">Seçiniz...</option>');
