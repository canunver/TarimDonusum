            input.addEventListener('change', FinansTutarlariniHesapla);
        });
        document.querySelectorAll('input[name="Basvuru.yatirim.harcamaTurleri"]').forEach(input =>
            input.addEventListener('change', YapiRuhsatiAlanlariniGuncelle));
        document.getElementById('ortakKaydetBtn')?.addEventListener('click', OrtakModalKaydet);
        document.getElementById('ortakUboKycDosya')?.addEventListener('change', OrtakModalUboKycDosyasiYukle);
