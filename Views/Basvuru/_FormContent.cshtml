        AdresDosyaGoster('adresModalKullanimHakkiDosyaAdi', 'adresModalKullanimHakkiIndir', adres.kullanimHakkiDosyaAdi, adres.kullanimHakkiDosyaId);
        AdresDosyaGoster('adresModalKanitDosyaAdi', 'adresModalKanitIndir', adres.kanitDosyaAdi, adres.kanitDosyaId);
        ['adresModalAdresBelgeDosya','adresModalKullanimHakkiDosya','adresModalKanitDosya'].forEach(id => { const e=document.getElementById(id); if(e)e.value=''; });
        YapiRuhsatiAlanlariniGuncelle();
