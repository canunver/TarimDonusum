    function modalOlustur(element) {
        if (!element) return null;
        if (window.bootstrap?.Modal) return new bootstrap.Modal(element);
        return {
            show: () => window.jQuery(element).modal('show'),
            hide: () => window.jQuery(element).modal('hide')
        };
    }

    function modalValue(id) {
        return document.getElementById(id)?.value || '';
    }

    function BasvuruId() {
        return degerInt('Basvuru.Id') || 0;
    }

    function BasvuruKimlikleri() {
        return {
            basvuruId: BasvuruId()
        };
    }

    function modalSet(id, value) {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.type === 'date' && value) {
            el.value = String(value).substring(0, 10);
            return;
        }
        el.value = value || '';
    }

    function KomsuBolum(yon) {
        const index = basvuruBolumleri.indexOf(active);
        if (index < 0) return active;
        return basvuruBolumleri[index + yon] || active;
    }

    function BasvuruBolumGoster(bolum) {
        if (!basvuruBolumleri.includes(bolum) || bolum === active) {
            BasvuruStepSec(active);
            return;
        }
        if (locked && bolum !== bolumFirma) {
            alert(lockedMessage);
            BasvuruStepSec(active);
            return;
        }
        if (dirty && (BolumKayitGerektirir(active) || active === bolumKarar || active === bolumSistemSonuclari || active === bolumUzmanSonuclari) && !confirm(unsavedMessage)) {
            BasvuruStepSec(active);
            return;
        }

        const container = document.getElementById('basvuruBolumContainer');
        const url = container?.dataset.url;
        if (!container || !url) return;

        $.ajax({
            url: url,
            type: 'GET',
            data: { ...BasvuruKimlikleri(), bolum: bolum },
            dataType: 'html'
        })
            .done(function (html) {
                container.innerHTML = html;
                active = bolum;
                dirty = false;
                BasvuruStepSec(active);
                BasvuruBolumIlklendir(active);
                BasvuruAksiyonButonlariGuncelle();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            })
            .fail(function () {
                PopupMesajGoster(partialLoadFailedMessage, false);
                BasvuruStepSec(active);
            });
    }

    function BasvuruStepSec(bolum) {
        document.querySelectorAll('.basvuru-step').forEach(step => {
            const secili = Number(step.dataset.step) === bolum;
            step.classList.toggle('active', secili);
            if (secili) step.setAttribute('aria-current', 'step');
            else step.removeAttribute('aria-current');
        });
        BasvuruAksiyonButonlariGuncelle();
    }

    function BasvuruAksiyonButonlariGuncelle() {
        const kaydetBtn = document.getElementById('basvuruKaydetBtn');
        const kayitGerekir = AktifBolumKaydedilebilir();
        const sonBolum = AktifBolumSonMu();
        if (kaydetBtn) kaydetBtn.classList.toggle('d-none', !kayitGerekir);
        const footerPrimary = document.getElementById('footerPrimaryBtn');
        if (footerPrimary) {
            footerPrimary.classList.toggle('d-none', sonBolum && !kayitGerekir);
            footerPrimary.textContent = kayitGerekir && !sonBolum ? basvuruAkisMetinleri.saveAndContinue
                : kayitGerekir ? '@L["Basvuru.Common.Save"]' : basvuruAkisMetinleri.continue;
        }
        document.querySelectorAll('.footer-prev').forEach(btn => btn.classList.toggle('invisible', basvuruBolumleri.indexOf(active) <= 0));
    }

    function AktifBolumSonMu() {
        return basvuruBolumleri.indexOf(active) === basvuruBolumleri.length - 1;
    }

    function BolumKayitGerektirir(bolum) {
        return [
            bolumFirma,
            bolumBasvuruSahibi,
            bolumBasvuruMaliVeriler,
            bolumBasvuruBilancoGelir,
            bolumBasvuruYatirimBilgileri,
            bolumBasvuruDegerZinciri,
            bolumBasvuruFinansman,
            bolumIrtibat,
            bolumYatirim,
            bolumUygulamaAdresi,
            bolumUygunHarcama,
            bolumFinans,
            bolumYatirimOzeti,
            bolumBasvuruTaahhutBeyan,
            bolumBasvuruCevreselSosyal,
            bolumDbCtpTeknikProje,
            bolumTaahhutBeyan,
            bolumMali,
            bolumOrtaklik,
            bolumCevreselSosyal
        ].includes(bolum);
    }

    function AktifBolumKaydedilebilir() {
        if (!basvuruReadonly && BolumKayitGerektirir(active)) return true;
        if (active === bolumSistemSonuclari || active === bolumUzmanSonuclari)
            return document.querySelector('[data-list-type]')?.dataset.editable === 'true';
        if (active === bolumKarar)
            return document.querySelector('[data-panel="' + bolumKarar + '"]')?.dataset.editable === 'true';
        return false;
    }

    function FooterBirincilAksiyon() {
        const sonraki = KomsuBolum(1);
        if (AktifBolumKaydedilebilir()) {
            PaneliKaydet(() => { if (!AktifBolumSonMu()) BasvuruBolumGoster(sonraki); });
            return;
        }
        if (AktifBolumSonMu()) return;
        BasvuruBolumGoster(sonraki);
    }

    function BasvuruBolumIlklendir(bolum) {
        const container = document.getElementById('basvuruBolumContainer');
        if (BolumKayitGerektirir(bolum)) {
            container?.querySelectorAll('input, select, textarea').forEach(el => {
                if (el.dataset.autoSave === 'true') return;
                el.addEventListener('change', () => dirty = true);
                el.addEventListener('input', () => dirty = true);
            });
        }

        if (bolum === bolumFirma || bolum === bolumBasvuruSahibi) FirmaBolumuIlklendir();
        if (bolum === bolumYatirim || bolum === bolumBasvuruDegerZinciri) YatirimBolumuIlklendir();
        if (bolum === bolumUygulamaAdresi || bolum === bolumBasvuruYatirimBilgileri) UygulamaAdresiBolumuIlklendir();
        if (bolum === bolumFinans || bolum === bolumBasvuruFinansman || bolum === bolumMali || bolum === bolumBasvuruMaliVeriler || bolum === bolumOrtaklik || bolum === bolumBasvuruBilancoGelir) ParaTamsayiAyarla();
        if (bolum === bolumBasvuruBilancoGelir) BilancoGelirBolumuIlklendir();
        if (bolum === bolumFinans || bolum === bolumBasvuruFinansman) FinansTutarlariniHesapla();
        if (bolum === bolumMali) MaliBolumuIlklendir();
        if (bolum === bolumBasvuruMaliVeriler) BasvuruMaliBolumuIlklendir();
        if (bolum === bolumBasvuruOrtaklikYetki) BasvuruOrtaklikYetkiBolumuIlklendir();
        if (bolum === bolumBasvuruYatirimOnBilgileri) YatirimOnBilgileriIlklendir();
        if (bolum === bolumBasvuruMakineEkipman) MakineBolumuIlklendir();
        if (bolum === bolumBasvuruYatirimdaKullanilacakEkipmanlar) YatirimEkipmanBolumuIlklendir();
        if (bolum === bolumBasvuruUrunSurecMakine) UrunSurecBolumuIlklendir();
        if (bolum === bolumBasvuruBinaListesi) BinaBolumuIlklendir();
        if (bolum === bolumBasvuruMetraj) MetrajBolumuIlklendir();
        if (bolum === bolumBasvuruIstihdam) IstihdamBolumuIlklendir();
        if (bolum === bolumBasvuruTedarikciEntegrasyonu) TedarikciEntegrasyonuIlklendir();
        if (bolum === bolumBasvuruTaahhutBeyan) BasvuruBeyanBolumuIlklendir();
        if (bolum === bolumBasvuruCevreselSosyal) BasvuruCevreselSosyalBolumuIlklendir();
        if (bolum === bolumBasvuruZorunluBelgeler) ZorunluBelgeMerkeziIlklendir();
        if (bolum === bolumBasvuruOzeti) BasvuruOzetiIlklendir();
        if (bolum === bolumBasvuruIzlemeGostergeleri) IzlemeGostergeleriIlklendir();
        if (bolum === bolumOrtaklik) OrtaklikBolumuIlklendir();
        if (bolum === bolumUygunHarcama) UygunHarcamaBolumuIlklendir();
        if (bolum === bolumYatirimOzeti) YatirimOzetiBolumuIlklendir();
        if (bolum === bolumDbCtpTeknikProje) DbCtpBolumuIlklendir();
        if (bolum === bolumCevreselSosyal) CevreselSosyalBolumuIlklendir();
        if (bolum === bolumTaahhutBeyan) TaahhutBeyanBolumuIlklendir();
        if (bolum === bolumBelgeler || bolum === bolumTaahhutBeyan || bolum === bolumBasvuruTaahhutBeyan) BelgelerBolumuIlklendir();
        if (bolum === bolumOzet) OzetBolumuIlklendir();
        if (bolum === bolumSistemSonuclari || bolum === bolumUzmanSonuclari) DenetimListesiIlklendir();
        if (bolum === bolumKarar) DenetimBolumuIlklendir();
    }

    function DenetimListesiIlklendir() {
        const panel = document.querySelector('[data-list-type]');
        const tbody = panel?.querySelector('tbody');
        if (!panel || !tbody) return;
        let satirlar = [];
        try { satirlar = JSON.parse(panel.querySelector('.denetim-listesi-json')?.value || '[]'); } catch { satirlar = []; }
        const sistemListesi = panel.dataset.listType === 'sistem';
        if (sistemListesi) {
            tbody.innerHTML = satirlar.map((x, i) => `<tr data-index="${i}">
                <td>${htmlEncode(x.no || '')}</td><td>${htmlEncode(x.konu || '')}</td><td>${htmlEncode(x.soru || '')}</td><td>${htmlEncode(x.kaynak || '')}</td>
                <td><select class="form-control denetim-liste-sonuc"><option value="Tam" ${x.sonuc === 'Tam' ? 'selected' : ''}>Tam</option><option value="Eksik" ${x.sonuc === 'Eksik' ? 'selected' : ''}>Eksik</option></select></td>
                <td><textarea class="form-control denetim-liste-aciklama" maxlength="1000">${htmlEncode(x.aciklama || '')}</textarea></td></tr>`).join('');
        } else {
            tbody.innerHTML = satirlar.map((x, i) => `<tr data-index="${i}">
                <td>${htmlEncode(x.no || '')}</td><td>${htmlEncode(x.konu || '')}</td><td>${htmlEncode(x.soru || '')}</td><td>${htmlEncode(x.kaynak || '')}</td>
                <td><select class="form-control denetim-liste-sonuc"><option value="">Seçiniz</option><option value="E" ${x.sonuc === 'E' ? 'selected' : ''}>Evet</option><option value="H" ${x.sonuc === 'H' ? 'selected' : ''}>Hayır</option><option value="UD" ${x.sonuc === 'UD' ? 'selected' : ''}>Uygulanabilir Değil</option></select></td>
                <td><textarea class="form-control denetim-liste-aciklama" maxlength="1000">${htmlEncode(x.aciklama || '')}</textarea></td></tr>`).join('');
        }
        if (panel.dataset.editable !== 'true') tbody.querySelectorAll('select,textarea').forEach(x => x.disabled = true);
        tbody.querySelectorAll('select,textarea').forEach(x => x.addEventListener('input', () => dirty = true));
        document.getElementById('sistemSonuclariYenidenUretBtn')?.addEventListener('click', function () {
            if (!window.confirm('Kayıtlı sistem sonuçları güncel başvuru verilerine göre yeniden oluşturulacaktır. Devam edilsin mi?')) return;
            const button = this;
            button.disabled = true;
            AjaxPost('/Denetleme/SistemSonuclariniYenidenUret', { basvuruId: BasvuruId() }, sonuc => {
                SonucGoster(sonuc);
                if (sonuc?.basarili && sonuc.nesne) {
                    panel.querySelector('.denetim-listesi-json').value = sonuc.nesne;
                    dirty = false;
                    DenetimListesiIlklendir();
                }
                button.disabled = false;
            });
        });
        panel._denetimListesiKaydet = function (button, afterSuccess) {
            const guncel = satirlar.map((x, i) => {
                const tr = tbody.querySelector(`tr[data-index="${i}"]`);
                const sonuc = tr?.querySelector('.denetim-liste-sonuc')?.value || '';
                const aciklama = tr?.querySelector('.denetim-liste-aciklama')?.value || '';
                return sistemListesi
                    ? { no:x.no, konu:x.konu, soru:x.soru, kaynak:x.kaynak, sonuc, aciklama }
                    : { no:x.no, konu:x.konu, soru:x.soru, kaynak:x.kaynak, sonuc, aciklama };
            });
            button.disabled = true;
            AjaxPost('/Denetleme/DenetimListesiKaydet', { basvuruId: BasvuruId(), listeTuru: panel.dataset.listType, json: JSON.stringify(guncel) }, sonuc => {
                SonucGoster(sonuc);
                if (sonuc?.basarili) { dirty = false; if (typeof afterSuccess === 'function') afterSuccess(); }
                button.disabled = false;
            });
        };
    }

    function DenetimBolumuIlklendir() {
        const sonucAlani = document.getElementById('denetimSonucu');
        const gerekceAlani = document.getElementById('denetimGerekcesi');
        const degisti = function () {
            dirty = true;
            DenetimSonuclandirButonuGuncelle(false);
        };
        sonucAlani?.addEventListener('change', degisti);
        gerekceAlani?.addEventListener('input', degisti);

        document.getElementById('denetimKaydetBtn')?.addEventListener('click', function () {
            DenetimKaydet(this, false);
        });
        document.getElementById('denetimSonuclandirBtn')?.addEventListener('click', function () {
            DenetimKaydet(this, true);
        });
    }

    function DenetimSonuclandirButonuGuncelle(kayitli) {
        const button = document.getElementById('denetimSonuclandirBtn');
        if (!button) return;
        button.disabled = !kayitli;
        button.classList.toggle('d-none', !kayitli);
    }

    function DenetimKaydet(button, sonuclandir, afterSuccess) {
        const sonuc = Number(document.getElementById('denetimSonucu')?.value || 0);
        const gerekce = (document.getElementById('denetimGerekcesi')?.value || '').trim();
        if (!sonuc || !gerekce) {
            const panel = document.querySelector('[data-panel="' + bolumKarar + '"]');
            PopupMesajGoster(panel?.dataset.fieldsRequired || '', false);
            return;
        }
        if (sonuclandir) {
            if (dirty) return;
            const panel = document.querySelector('[data-panel="' + bolumKarar + '"]');
            if (!window.confirm(panel?.dataset.finalizeConfirm || '')) return;
        }

        button.disabled = true;
        AjaxPost(`/Denetleme/OnBasvuruDenetimiKaydet?sonuclandir=${sonuclandir}`, {
            id: BasvuruId(),
            denetimGerekcesi: gerekce,
            denetimSonucu: sonuc || null
        }, function (response) {
            SonucGoster(response);
            if (response?.basarili && sonuclandir) {
                    window.setTimeout(function () { window.location.reload(); }, 900);
                    return;
            }
            if (response?.basarili) {
                dirty = false;
                DenetimSonuclandirButonuGuncelle(true);
                if (typeof afterSuccess === 'function') afterSuccess();
            }
            button.disabled = false;
        });
    }

    function OzetBolumuIlklendir() {
        const button = document.getElementById('incelemeyeGonderBtn');
        if (!button) return;

        button.addEventListener('click', async function () {
            if (!window.confirm(button.dataset.confirm || '')) return;
            button.disabled = true;

            const token = document.querySelector('#basvuruForm input[name="__RequestVerificationToken"]')?.value || '';
            const body = new URLSearchParams({
                basvuruId: button.dataset.basvuruId || BasvuruId(),
                __RequestVerificationToken: token
            });

            try {
                const response = await fetch(button.dataset.url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: body.toString()
                });
                const result = await response.json();
                if (!response.ok || !result.basarili) {
                    PopupMesajGoster(result.mesaj || button.dataset.failedMessage || '', false);
                    button.disabled = false;
                    return;
                }

                PopupMesajGoster(result.mesaj, true);
                window.setTimeout(function () { window.location.reload(); }, 900);
            } catch {
                PopupMesajGoster(button.dataset.failedMessage || '', false);
                button.disabled = false;
            }
        });
    }

    function BasvuruDegisiklikVarIsaretle() {
        if (active !== bolumBasvuruSahibi || basvuruReadonly) return;
        const alan = document.getElementById('basvuruDegisiklikVarMi');
        const gorunum = document.getElementById('basvuruDegisiklikVarMiGorunum');
        const gerekce = document.getElementById('basvuruDegisiklikSebebi');
        if (alan) alan.value = 'true';
        if (gorunum) gorunum.value = 'true';
        if (gerekce) gerekce.required = true;
    }

    function BasvuruDegisiklikTakibiniIlklendir() {
        if (active !== bolumBasvuruSahibi || basvuruReadonly) return;
        const panel = document.querySelector('[data-bolum="BasvuruSahibi"]');
        const gerekce = document.getElementById('basvuruDegisiklikSebebi');
        if (document.getElementById('basvuruDegisiklikVarMi')?.value === 'true' && gerekce)
            gerekce.required = true;
        panel?.querySelectorAll('input:not([type="hidden"]):not([type="file"]), select, textarea').forEach(alan => {
            if (alan.id === 'basvuruDegisiklikVarMiGorunum' || alan.id === 'basvuruDegisiklikSebebi') return;
            alan.addEventListener('change', BasvuruDegisiklikVarIsaretle);
            alan.addEventListener('input', BasvuruDegisiklikVarIsaretle);
        });
    }
    function BasvuruOrtaklikYetkiBolumuIlklendir() {
        OrtaklikBolumuIlklendir();
        AdliSicilInitialOku();
        document.getElementById('adliSicilKisiEkleBtn')?.addEventListener('click', () => AdliSicilModalAc(-1));
        AdliSicilKisilerRender();
    }
    function FirmaBolumuIlklendir() {
        AdliSicilInitialOku();
        document.getElementById('adliSicilKisiEkleBtn')?.addEventListener('click', () => AdliSicilModalAc(-1));
        AdliSicilKisilerRender();
        BasvuruDegisiklikTakibiniIlklendir();
        SadeceRakamAlaniIlklendir(document.getElementById('vergiKimlikNo'), 10);
        document.getElementById('firmaSecBtn')?.addEventListener('click', () => {
            document.getElementById('firmaSecArama').value = '';
            firmaSecModal?.show();
            FirmaSecAra();
        });
        document.getElementById('vergiKimlikNo')?.addEventListener('input', event => {
            if (VknGecerliMi(event.target.value))
                AjaxGet('/Basvuru/FirmaSorgula', { vergiKimlikNo: event.target.value, id: 0 }, sonuc => {
                    if (sonuc?.basarili && sonuc.nesne) setFirma(sonuc.nesne);
                    else PopupMesajGoster(sonuc?.hataStr || @Html.Raw(JsonSerializer.Serialize(T("Basvuru.Firma.NoResults"))), false);
                });
        });
        document.getElementById('firmaYeniBtn')?.addEventListener('click', () => {
            firmaModalDoldur({ id: 0, vergiKimlikNo: $('#vergiKimlikNo').val() || '' });
            firmaModal?.show();
        });
        document.getElementById('firmaDuzenleBtn')?.addEventListener('click', () => {
            const id = document.getElementById('firmaId')?.value || '';
            if (!id) {
                alert(firmaSelectFirstMessage);
                return;
            }
            AjaxGet('/Basvuru/FirmaSorgula', { vergiKimlikNo: $('#vergiKimlikNo').val(), id: 0 }, FirmaBilgiDoldur);
        });
    }

    function FirmaSecAra() {
        const aramaMetni = (document.getElementById('firmaSecArama')?.value || '').trim();
        const liste = document.getElementById('firmaSecListe');
        if (liste) liste.innerHTML = `<div class="text-center text-muted p-3">${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Firma.Searching"))))}</div>`;
        AjaxGet('/Firma/Ara', { aramaMetni }, sonuc => {
            if (!sonuc?.basarili) {
                if (liste) liste.innerHTML = `<div class="alert alert-warning">${htmlEncode(sonuc?.hataStr || '')}</div>`;
                return;
            }
            const firmalar = sonuc.nesne || [];
            if (!firmalar.length) {
                if (liste) liste.innerHTML = `<div class="text-center text-muted p-3">${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Firma.NoResults"))))}</div>`;
                return;
            }
            window.basvuruFirmaSecimListesi = firmalar;
            liste.innerHTML = `<table class="table table-hover mb-0"><thead><tr><th>${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Field.TicaretUnvani"))))}</th><th>${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Field.VergiKimlikNo"))))}</th><th></th></tr></thead><tbody>${firmalar.map((firma, index) => `<tr><td>${htmlEncode(firma.ticaretUnvani)}</td><td>${htmlEncode(firma.vergiKimlikNo)}</td><td class="text-right"><button type="button" class="btn btn-sm btn-primary" onclick="FirmaSec(${index})">${htmlEncode(@Html.Raw(JsonSerializer.Serialize(T("Basvuru.Firma.Select"))))}</button></td></tr>`).join('')}</tbody></table>`;
        });
    }

    function FirmaSec(index) {
        const firma = (window.basvuruFirmaSecimListesi || [])[index];
        if (!firma) return;
        setFirma(firma);
        dirty = true;
        BasvuruDegisiklikVarIsaretle();
        firmaSecModal?.hide();
    }

    function YatirimBolumuIlklendir() {
        $('[name="Basvuru.IlId"]').off('change.basvuruBolum').on('change.basvuruBolum', degerZinciriYukle);
        $('#degerZinciriSelect').off('change.basvuruBolum').on('change.basvuruBolum', function () {
            degerZinciriAsamalariYukle($(this).val());
        });
        degerZinciriYukle();
    }

    function UygulamaAdresiBolumuIlklendir() {
        document.getElementById('adresYeniBtn')?.addEventListener('click', () => adresModalAc(-1));
        UygulamaAdresleriListele();
    }

    function BelgelerBolumuIlklendir() {
        document.querySelectorAll('.basvuru-dosya-input').forEach(input => {
            input.addEventListener('change', function () {
                BasvuruDosyasiYukle(this.dataset.formAd || zorunluBelgeFormAd, Number(this.dataset.dosyaNo || 0), this, this.dataset.nameTarget, this.dataset.downloadTarget);
            });
        });
        document.querySelectorAll('.ortaklik-dosya-input').forEach(input => {
