    function MetrajVerisiYukle(){AjaxGet('/Basvuru/MetrajVerisi',{basvuruId:BasvuruId()},r=>{if(!r?.basarili){SonucGoster(r);return;}metrajVerisi=r.nesne||{binalar:[],pozlar:[]};if(metrajBinaIndex>=metrajVerisi.binalar.length)metrajBinaIndex=0;const b=metrajVerisi.binalar[metrajBinaIndex];if(metrajBolumIndex>=(b?.bolumler?.length||0))metrajBolumIndex=0;MetrajRender();});}
    function MetrajRender(){
        const bs=metrajVerisi.binalar||[],edit=!!document.getElementById('metrajBolumModal');
        let html='';
        bs.forEach((b,bi)=>{
            html+=`<tr class="table-secondary"><th colspan="3"><div class="d-flex justify-content-between align-items-center"><span><i class="fas fa-building mr-2"></i>${htmlEncode(b.siraNo)}. ${htmlEncode(b.ad)}</span>${edit?`<button type="button" class="btn btn-sm btn-success" onclick="MetrajBolumSatiriEkle(${bi})"><i class="fas fa-plus mr-1"></i>Bölüm ekle</button>`:''}</div></th><th class="text-right align-middle">${MetrajPara(MetrajBinaMaliyet(b))}</th></tr>`;
            const bolumler=b.bolumler||[];
            if(!bolumler.length)html+=`<tr><td></td><td colspan="2" class="text-muted pl-4">Bu bina için yapım bölümü eklenmedi.</td><td class="text-right">0,00 TL</td></tr>`;
            bolumler.forEach((bl,bli)=>{
                html+=`<tr class="table-light"><td></td><th colspan="2"><div class="d-flex justify-content-between align-items-center"><span><i class="fas fa-layer-group mr-2 text-muted"></i>${htmlEncode(bl.siraNo)}. ${htmlEncode(bl.ad)}</span>${edit?`<span><button type="button" class="btn btn-sm btn-outline-primary mr-1" onclick="MetrajBolumSatiriDuzenle(${bi},${bli})">Düzenle</button><button type="button" class="btn btn-sm btn-success" onclick="MetrajPozSatiriEkle(${bi},${bli})"><i class="fas fa-plus mr-1"></i>Poz ekle</button></span>`:''}</div></th><th class="text-right align-middle">${MetrajPara(MetrajBolumMaliyet(bl))}</th></tr>`;
                const ps=bl.pozlar||[];
