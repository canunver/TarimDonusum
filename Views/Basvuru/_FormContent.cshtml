    function YatirimOnBilgiSatirHtml(x,tur,index){const islemler=document.getElementById('yobiDuzenlenebilir')?`<div class="btn-group btn-group-sm"><button type="button" class="btn btn-outline-primary" onclick="YatirimOnBilgiModalAc(${tur},${index})">Düzenle</button><button type="button" class="btn btn-outline-danger" onclick="YatirimOnBilgisiSil(${index})">Sil</button></div>`:'';if(tur===4)return `<tr><td>${htmlEncode(x.siraNo)}</td><td>${htmlEncode(x.ad)}</td><td>${htmlEncode(x.miktar??'')}</td><td>${htmlEncode(x.birim||'')}</td><td>${htmlEncode(x.tekPanelGucu??'')}</td><td>${htmlEncode(x.tekPanelGucuBirim||'')}</td><td>${htmlEncode(x.toplamGuc??'')}</td><td>${htmlEncode(x.toplamGucBirim||'')}</td><td>${islemler}</td></tr>`;return `<tr><td>${htmlEncode(x.siraNo)}</td><td>${htmlEncode(x.ad)}</td><td>${htmlEncode(x.miktar??'')}</td><td>${htmlEncode(x.birim||'')}</td><td>${islemler}</td></tr>`;}
    function YatirimOnBilgiModalAc(tur,index){const mevcut=index>=0?yatirimOnBilgileri[index]:null,adet=yatirimOnBilgileri.filter(x=>Number(x.tur)===tur).length,basliklar=['','Mevcut Ürün','Üretilecek Ürün','Girdi','Enerji Kullanımı','Kurulu Güç'];document.getElementById('yobiIndex').value=index;document.getElementById('yobiTur').value=tur;document.getElementById('yobiId').value=mevcut?.id||0;document.getElementById('yobiModalBaslik').textContent=(mevcut?'Güncelle - ':'Yeni - ')+basliklar[tur];document.getElementById('yobiSira').value=mevcut?.siraNo||adet+1;document.getElementById('yobiAd').value=mevcut?.ad||'';document.getElementById('yobiMiktar').value=mevcut?.miktar??'';document.getElementById('yobiBirim').value=mevcut?.birim||(tur===4?'Adet':tur===5?'kWe':'Kg');document.getElementById('yobiTekPanelGucu').value=mevcut?.tekPanelGucu??'';document.getElementById('yobiTekPanelGucuBirim').value=mevcut?.tekPanelGucuBirim||'W';document.getElementById('yobiToplamGuc').value=mevcut?.toplamGuc??'';document.getElementById('yobiToplamGucBirim').value=mevcut?.toplamGucBirim||'kWp';document.getElementById('yobiEnerjiAlanlari').style.display=tur===4?'grid':'none';document.getElementById('yobiAdLabel').firstChild.textContent=tur===3?'Girdi / Hammadde':tur>=4?'Yenilenebilir Enerji Çeşidi':'Ürün / Hayvan Türü';document.getElementById('yobiMiktarLabel').firstChild.textContent=tur===4?'Panel sayısı':tur===5?'Kurulu güç':'Miktar / Hayvan sayısı';$('#yatirimOnBilgiModal').modal('show');}
    function YatirimOnBilgisiKaydet(){const tur=Number(document.getElementById('yobiTur').value),index=Number(document.getElementById('yobiIndex').value),model={id:Number(document.getElementById('yobiId').value),basvuruId:BasvuruId(),tur,siraNo:Number(document.getElementById('yobiSira').value),ad:document.getElementById('yobiAd').value,miktar:Number(document.getElementById('yobiMiktar').value)||null,birim:document.getElementById('yobiBirim').value,tekPanelGucu:tur===4?(Number(document.getElementById('yobiTekPanelGucu').value)||null):null,tekPanelGucuBirim:tur===4?document.getElementById('yobiTekPanelGucuBirim').value:null,toplamGuc:tur===4?(Number(document.getElementById('yobiToplamGuc').value)||null):null,toplamGucBirim:tur===4?document.getElementById('yobiToplamGucBirim').value:null};AjaxPost('/Basvuru/YatirimOnBilgisiKaydet',model,sonuc=>{SonucGoster(sonuc);if(sonuc?.basarili&&sonuc.nesne){if(index>=0)yatirimOnBilgileri[index]=sonuc.nesne;else yatirimOnBilgileri.push(sonuc.nesne);YatirimOnBilgileriRender();$('#yatirimOnBilgiModal').modal('hide');dirty=false;}});}
