    function YapiRuhsatiAlanlariniGuncelle() {
        const gizle = !YapimIsiSecili();
        document.getElementById('adresModalYapiRuhsatiAlani')?.classList.toggle('d-none', gizle);
        document.querySelectorAll('.yapi-ruhsati-kolonu').forEach(element => element.classList.toggle('d-none', gizle));
        if (gizle) modalSet('adresModalYapiRuhsatiDurumu', 5);
        if (sonUygulamaAdresleri.length) RenderUygulamaAdresleri(sonUygulamaAdresleri);
