    function BasvuruMaliIsletmeKaydet() {
        const indexText = modalValue('basvuruMaliIsletmeIndex');
        const index = indexText === '' ? -1 : Number(indexText);
        const mevcut = index >= 0 ? basvuruMaliIsletmeleri[index] : {};
        const dec = id => { const raw=modalValue(id); if(!raw) return null; const normalized=raw.includes(',')?raw.replace(/\./g,'').replace(',','.'):raw.replace(/\s/g,''); const parsed=Number(normalized); return Number.isFinite(parsed)?parsed:null; };
        const model = { ...mevcut, id:Number(mevcut.id||0), basvuruId:BasvuruId(), adUnvan:modalValue('basvuruMaliOrtakAdUnvan'), tcknVkn:modalValue('basvuruMaliOrtakVkn'), kisiTuru:'Tüzel Kişi', iliskiTuru:modalValue('basvuruMaliOrtakIliski'), hesabaDahilOran:dec('basvuruMaliOrtakOran'), oncekiYilNetSatis:dec('basvuruMaliOrtakOncekiNet'), sonYilNetSatis:dec('basvuruMaliOrtakSonNet'), oncekiYilAktifToplami:dec('basvuruMaliOrtakOncekiAktif'), sonYilAktifToplami:dec('basvuruMaliOrtakSonAktif'), belgeReferansi:mevcut.belgeReferansi||'' };
