@model List<TarimDonusum.Models.Basvuru>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["Basvuru.Index.Title"];
    var listeTuru = ViewBag.ListeTuru is enumBasvuruKayitTuru tur ? tur : enumBasvuruKayitTuru.OnBasvuru;
}

<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>@L["Basvuru.Index.Heading"]</h1>
            <p>@L["Basvuru.Index.Description"]</p>
        </div>
        @if (ViewBag.YeniBasvuruYetkisi == true)
        {
            <a class="btn btn-primary" asp-controller="Basvuru" asp-action="Yeni">@L["Basvuru.Index.New"]</a>
        }
    </div>

    <div class="nav nav-pills mb-3" role="navigation" aria-label="Başvuru listeleri">
        <a class="nav-link @(listeTuru == enumBasvuruKayitTuru.OnBasvuru ? "active" : "")"
           asp-action="Index" asp-route-tur="on-basvuru">Ön Başvurular</a>
        <a class="nav-link @(listeTuru == enumBasvuruKayitTuru.Basvuru ? "active" : "")"
           asp-action="Index" asp-route-tur="basvuru">Başvurular</a>
    </div>
    <div id="ajaxMesaj"
         class="alert alert-info alert-dismissible floating-message"
         style="display:@(TempData["Mesaj"] != null ? "block" : "none")">
        <span id="ajaxMesajMetin">@TempData["Mesaj"]</span>
        <button type="button" id="ajaxMesajKapat" class="close" aria-label="@L["Basvuru.Common.Close"]">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="table-responsive basvuru-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Basvuru.Common.No"]</th>
                    <th>@L["Basvuru.Field.TicaretUnvani"]</th>
                    <th>@L["Basvuru.Field.VergiKimlikNo"]</th>
                    <th>@L["Basvuru.Field.YatirimAdi"]</th>
                    <th>@L["Basvuru.Field.Durum"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted">@L["Basvuru.Index.Empty"]</td>
                    </tr>
                }
                @foreach (var grup in Model.GroupBy(x => x.BasvuruAnaId))
                {
                    var versiyonlar = grup.OrderByDescending(x => x.basvuruFirma.revizyonNo).ThenByDescending(x => x.Id).ToList();
                    var item = versiyonlar.FirstOrDefault(x => x.basvuruFirma.siraNo == 0) ?? versiyonlar[0];
                    var duzenleLinkId = $"basvuruDuzenle_{item.BasvuruAnaId}";
                    <tr>
                        <td>
                            <select class="form-select form-select-sm basvuru-version-select"
                                    aria-label="Başvuru versiyonu"
                                    data-target="@duzenleLinkId"
                                    data-url="@Url.Action("Duzenle", "Basvuru")">
                                @foreach (var versiyon in versiyonlar)
                                {
                                    if (versiyon.Id == item.Id)
                                    {
                                        <option value="@versiyon.Id" selected>V@(versiyon.basvuruFirma.revizyonNo + 1)</option>
                                    }
                                    else
                                    {
                                        <option value="@versiyon.Id">V@(versiyon.basvuruFirma.revizyonNo + 1)</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>@item.basvuruFirma.firma.ticaretUnvani</td>
                        <td>@item.basvuruFirma.firma.vergiKimlikNo</td>
                        <td>@(string.IsNullOrWhiteSpace(item.yatirim.yatirimAdi) ? "-" : item.yatirim.yatirimAdi)</td>
                        <td><span class="badge bg-secondary">@DurumMetni(item)</span></td>
                        <td class="text-end">
                            <a id="@duzenleLinkId" class="btn btn-sm btn-outline-primary" asp-controller="Basvuru" asp-action="Duzenle" asp-route-id="@item.Id">@L["Basvuru.Common.Edit"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        if (typeof PopupMesajIlklendir === 'function') {
            PopupMesajIlklendir();
        }

        $('.basvuru-version-select').on('change', function () {
            const hedef = document.getElementById(this.dataset.target);
            if (hedef) {
                hedef.href = this.dataset.url + '?id=' + encodeURIComponent(this.value);
            }
        });
    });
</script>
}

@functions {
    private static string DurumMetni(Basvuru item)
    {
        if (item.kayitTuru == enumBasvuruKayitTuru.OnBasvuru)
        {
            return item.durum switch
            {
                enumBasvuruDurum.OnBasvuruDurumu => "Ön Başvuru",
                enumBasvuruDurum.OnBasvuruDuzeltmeDurumu => "Ön Başvuru Düzeltme",
                enumBasvuruDurum.OnBasvuruIncelemeDurumu => "Ön Başvuru İnceleme",
                enumBasvuruDurum.BasvuruDurumu => "Ön Başvuru Kabul Edildi",
                enumBasvuruDurum.IptalDurumu => "Ön Başvuru Red / İptal",
                _ => "Ön Başvuru"
            };
        }

        return item.durum switch
        {
            enumBasvuruDurum.BasvuruDurumu => "Başvuru",
            enumBasvuruDurum.BasvuruIncelemeDurumu => "Başvuru İnceleme",
            enumBasvuruDurum.KabulEdildiDurumu => "Başvuru Kabul",
            enumBasvuruDurum.ReddedildiDurumu => "Başvuru Red",
            enumBasvuruDurum.BasvuruSecilmediDurumu => "Başvuru Seçilmedi",
            _ => "Başvuru"
        };
    }
}
