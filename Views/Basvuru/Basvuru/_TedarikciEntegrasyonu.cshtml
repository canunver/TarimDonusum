@using System.Text.Json
@using TarimDonusum.Models
@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@{
    bool edit = !Model.DenetciGorunumu && !Model.SaltOkunur;
    var urunler = Model.Basvuru.YatirimOnBilgileri.Where(x => x.tur == enumYatirimOnBilgiTuru.UretilecekUrun).OrderBy(x => x.siraNo).ThenBy(x => x.id).ToList();
}
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruTedarikciEntegrasyonu)">
 <div class="section-toolbar"><div><h2 class="mb-0">Tedarikçi Entegrasyonu</h2><p class="text-muted mb-0">Ürünlerin elde edilmesi için çiftçilerden alınacak tarımsal ürünleri giriniz.</p></div><a class="btn btn-outline-primary" href="@Url.Action("TedarikciEntegrasyonuYazdir","Basvuru",new{id=Model.Basvuru.Id})"><i class="fas fa-file-excel mr-1"></i>Yazdır</a></div>
 <script type="application/json" id="tedarikEntegrasyonJson">@Html.Raw(JsonSerializer.Serialize(Model.Basvuru.TedarikciEntegrasyonlari))</script>
 <script type="application/json" id="tedarikUrunJson">@Html.Raw(JsonSerializer.Serialize(urunler.Select(x => new { x.id, x.ad, x.siraNo })))</script>
 <div class="basvuru-card mb-3">
  <label class="wide-label mb-2">ENTEGRASYON PLANININ KISA AÇIKLAMASI<textarea id="tedarikPlanAciklama" maxlength="2000" placeholder="Yeni tedarikçilerin nasıl bulunacağını ve doğrulanacağını, tedarikin ne zaman başlayacağını ve hangi sözleşme/niyet belgesiyle destekleneceğini en fazla 5 cümlede açıklayınız." disabled="@(!edit)">@Model.Basvuru.tedarikciEntegrasyonuAciklama</textarea></label>
  @if(edit){<div class="text-right"><button type="button" class="btn btn-primary" onclick="TedarikPlaniAciklamaKaydet()">Kaydet</button></div>}
 </div>
 <div id="tedarikEntegrasyonAlani"></div>
 @if(edit){
 <div class="modal fade" id="tedarikEntegrasyonModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Çiftçilerden Alınan Ürün</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
  <div class="modal-body"><input id="tedIndex" type="hidden"><input id="tedId" type="hidden"><input id="tedUrunId" type="hidden"><div class="form-grid">
   <label>Çiftçilerden Alınan Tarımsal Ürün<input id="tedTarimsalUrun" maxlength="250"></label>
   <label>Tedarik İli<select id="tedIl" onchange="TedarikIlceleriYukle()"><option value="">Seçiniz</option>@foreach(var il in Model.Iller){<option value="@il.id">@il.ad</option>}</select></label>
   <label>Tedarik İlçesi<select id="tedIlce"><option value="">Seçiniz</option></select></label>
   <label>Birim<input value="Ton" readonly></label>
   <label>Mevcut Yıllık Miktar<input id="tedMevcutMiktar" type="number" min="0" step="0.001"></label><label>Hedef Yıllık Miktar<input id="tedHedefMiktar" type="number" min="0" step="0.001"></label>
   <label>Mevcut Kayıtlı Çiftçi<input id="tedMevcutCiftci" type="number" min="0" step="1"></label><label>Eklenecek Kayıtlı Çiftçi<input id="tedEklenecekCiftci" type="number" min="0" step="1"></label>
   <label>Tedarik Şekli<select id="tedTedarikSekli"><option value="1">Sözleşmeli tedarik</option><option value="2">Niyet / protokol etiketi</option></select></label>
   <label>Dayanak Belge<input id="tedDosya" type="file" onchange="TedarikDayanakBelgesiYukle()"><small id="tedDosyaBilgi" class="form-text text-muted"></small><span id="tedDosyaAdi" class="document-file-name"></span><a id="tedDosyaIndir" class="btn btn-sm btn-outline-secondary d-none" target="_blank">İndir</a></label>
  </div><label class="wide-label mt-3">Kısa Açıklama<textarea id="tedAciklama" maxlength="1000"></textarea></label></div>
  <div class="modal-footer"><button id="tedSilBtn" type="button" class="btn btn-outline-danger mr-auto" onclick="TedarikKaydiSil()">Sil</button><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="TedarikKaydiKaydet()">Kaydet</button></div>
 </div></div></div>}
</section>
