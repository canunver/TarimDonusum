@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@using System.Text.Json
@{
    bool uzman = Model.DenetciGorunumu;
    // Teknik özellik ve teklifler başvuru sahibi tarafından satır satır eklenir/düzenlenir; makine bilgileri Teknik Proje (Makine Ekipman) sayfasından gelir.
    bool duzenlenebilir = !uzman && !Model.SaltOkunur;
    var yeniMakineler = Model.Basvuru.Makineler.Where(m => string.Equals(m.durum, "YENİ DESTEK İSTENİYOR", StringComparison.Ordinal)).ToList();
    var basvuranVerisi = yeniMakineler.Select(m => new { m.id,m.basvuruId,m.siraNo,m.ad,m.birim,m.miktar,m.aciklama,m.marka,m.model,m.kapasiteOzellikleri,m.yerlesimPlaniSiraNo,m.kullanimAmaci,m.durum,m.kapasiteSecimGerekcesi,teknikOzellikler=m.teknikOzellikler,teklifler=m.teklifler });
}
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruMakineEkipman)" data-makine-duzenlenebilir="@duzenlenebilir.ToString().ToLowerInvariant()">
    <div class="section-toolbar"><h2 class="mb-0">Yeni Makine Ekipman Listesi</h2><div class="d-flex align-items-center" style="gap:8px"><a class="btn btn-outline-primary" href="@Url.Action("MakineEkipmanYazdir","Basvuru",new{id=Model.Basvuru.Id})"><i class="fas fa-file-excel mr-1"></i>Yazdır</a></div></div>
    <div class="alert alert-info">Teknik Proje (Makine Ekipman) sayfasında durumu <strong>Yeni destek isteniyor</strong> olan makineler listelenir; makine bilgileri o sayfadan değiştirilir. Bu sayfada her makine için teknik özellik ve teklif ekleyebilir, eklenen satırı kalem simgesiyle düzenleyebilirsiniz.</div>
    <script type="application/json" id="makineListeJson">@Html.Raw(JsonSerializer.Serialize(basvuranVerisi))</script>
    <div id="makineListeAlani"></div>
</section>
@if(!uzman&&!Model.SaltOkunur)
{
<div class="modal fade" id="makineOzellikModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="makineOzellikBaslik">Teknik özellik</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
    <div class="modal-body">
        <input type="hidden" id="moMakineId" /><input type="hidden" id="moId" />
        <div class="form-grid"><label>Sıra no<input id="moSira" type="number" min="1" /></label><label>Zorunlu mu?<select id="moZorunlu"><option value="true">Evet</option><option value="false">Hayır</option></select></label></div>
        <label class="wide-label">Özellik başlığı<input id="moBaslik" maxlength="250" /></label>
        <label class="wide-label">Açıklama / asgari gereklilik<textarea id="moAciklama" rows="4" maxlength="2000"></textarea></label>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="MakineOzellikKaydet()">Kaydet</button></div>
</div></div></div>
<div class="modal fade" id="makineTeklifModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="makineTeklifBaslik">Teklif</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
    <div class="modal-body">
        <input type="hidden" id="mtMakineId" /><input type="hidden" id="mtId" />
        <div class="form-grid">
            <label>Sıra no<input id="mtSira" type="number" min="1" max="99" /></label>
            <label>Tedarikçi<input id="mtTedarikci" maxlength="250" /></label>
            <label>Marka<input id="mtMarka" maxlength="150" /></label>
            <label>Model<input id="mtModel" maxlength="150" /></label>
            <label>Para birimi<select id="mtPara">@foreach(var p in ParaBirimleri.Tum){<option value="@p">@p</option>}</select></label>
            <label>Kur<input id="mtKur" type="number" min="0" step="0.000001" /></label>
            <label>Birim fiyat<input id="mtFiyat" type="text" inputmode="decimal" onblur="MakineTeklifBirimFiyatCikis(this)" /></label>
            <label>Teklif tarihi<input id="mtTarih" type="date" /></label>
            <label>Geçerlilik tarihi<input id="mtGecerlilik" type="date" /></label>
        </div>
        <input type="hidden" id="mtEsas" />
        <small class="form-text text-muted">Başvuruya esas teklif, teklif tablosundaki "Esas" sütunundan seçilir. İlk eklenen teklif otomatik olarak esas olur.</small>
        <label class="wide-label">Açıklama<textarea id="mtAciklama" rows="3" maxlength="2000"></textarea></label>
        <label class="wide-label">Teklif belgesi<input id="mtDosya" class="form-control-file mt-1" type="file" onchange="MakineTeklifDosyasiYukle(this)" /><small id="mtDosyaAdi" class="text-muted"></small></label>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="MakineTeklifKaydet()">Kaydet</button></div>
</div></div></div>
}
