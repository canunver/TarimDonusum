@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@using System.Text.Json
@using System.Globalization
@{ var i=Model.Basvuru.istihdam; bool edit=!Model.DenetciGorunumu&&!Model.SaltOkunur; int sonYil=Model.Basvuru.basvuruFirma.donem.yil-1; decimal kredi=Model.Basvuru.HesaplananTalepEdilenFinansmanTutari.GetValueOrDefault(); }
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruIstihdam)" data-istihdam-basvuru-yili="@Model.Basvuru.basvuruFirma.donem.yil" data-istihdam-kredi="@kredi.ToString(CultureInfo.InvariantCulture)">
 <div class="section-toolbar"><h2 class="mb-0">Tam Zamanlı İstihdam</h2><a class="btn btn-outline-primary" href="@Url.Action("IstihdamYazdir","Basvuru",new{id=Model.Basvuru.Id})"><i class="fas fa-file-excel mr-1"></i>Yazdır</a></div>
 <div class="alert alert-info">@sonYil gerçekleşen yıllık ortalama tam zamanlı istihdam ile mevcut aylık ortalama brüt ücreti ve planlanan net ek tam zamanlı istihdam verisi girilmelidir. Mevcut/ilk ücret bilgisi yalnız veri amacıyla alınır ve hesaplamaya dahil edilmez.</div>
 <script type="application/json" id="istihdamJson">@Html.Raw(JsonSerializer.Serialize(i))</script>
 <h5>Son iki tamamlanmış yılda kadın / erkek tam zamanlı istihdam</h5>
 <div class="form-grid mb-3">
  <label>Önceki yıl<input id="istOncekiYil" type="number" readonly></label>
  <label>Kadın tam zamanlı istihdam<input id="istOncekiKadin" type="number" min="0" step="1" disabled="@(!edit)" oninput="IstihdamOzetiRender()"></label>
  <label>Erkek tam zamanlı istihdam<input id="istOncekiErkek" type="number" min="0" step="1" disabled="@(!edit)" oninput="IstihdamOzetiRender()"></label>
  <label>Son yıl<input id="istSonYil" type="number" readonly></label>
  <label>Kadın tam zamanlı istihdam<input id="istSonKadin" type="number" min="0" step="1" disabled="@(!edit)" oninput="IstihdamOzetiRender()"></label>
  <label>Erkek tam zamanlı istihdam<input id="istSonErkek" type="number" min="0" step="1" disabled="@(!edit)" oninput="IstihdamOzetiRender()"></label>
 </div>
 <div class="d-flex justify-content-between align-items-center mb-2"><h5 class="mb-0">İstihdam planı – @sonYil gerçekleşen ve planlanan durum</h5>@if(edit){<button type="button" class="btn btn-sm btn-success" onclick="IstihdamSatirModalAc(-1)"><i class="fas fa-plus mr-1"></i>Yeni kayıt</button>}</div>
 <div id="istihdamSatirAlani"></div>
 <h5 class="mt-3">Otomatik özet ve sıralama puanı</h5>
 <div id="istihdamOzetAlani"></div>
 <div class="form-group mt-3"><label for="istihdamGerekce"><strong>@sonYil GERÇEKLEŞEN DURUMU VE İSTİHDAM PLANININ DAYANAKLARI</strong></label><textarea id="istihdamGerekce" class="form-control" rows="5" maxlength="4000" disabled="@(!edit)" placeholder="@sonYil gerçekleşen tam zamanlı istihdam ve mevcut/ilk ücret bilgilerinin kaynaklarını; planlanan istihdamın yatırımla bağını ve işe alım takvimini açıklayınız. Gelecek dönem ücret tahmini bu formda istenmez."></textarea></div>
 <div class="form-group mt-3"><label><strong>Mevcut durumu gösteren belge (SGK dökümü)</strong></label><div class="document-file-row mb-0"><label for="istihdamSgkDosya" class="btn btn-outline-primary mb-0 @(!edit?"disabled":"")">Dosya Seç</label><input id="istihdamSgkDosya" type="file" class="document-file-input" disabled="@(!edit)" onchange="IstihdamSgkDosyaSecildi(this)"><span id="istihdamSgkAdi" class="document-file-name">@(string.IsNullOrWhiteSpace(i.sgkDosyaAdi)?"Dosya seçilmedi":i.sgkDosyaAdi)</span><button type="button" class="btn btn-primary" onclick="IstihdamSgkYukle()" disabled="@(!edit)">Yükle</button><a id="istihdamSgkIndir" class="btn btn-outline-secondary @(i.sgkDosyaId.HasValue?"":"d-none")" href="@(i.sgkDosyaId.HasValue?Url.Action("DosyaIndir","Basvuru",new{id=i.sgkDosyaId.Value}):"#")" target="_blank">İndir</a></div></div>
 @if(edit){<div class="text-right"><button type="button" class="btn btn-primary" onclick="IstihdamKaydet()">Kaydet</button></div>}
 @if(edit){<div class="modal fade" id="istihdamSatirModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="istihdamSatirBaslik">İstihdam Planı Kaydı</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input type="hidden" id="istSatirIndex"><input type="hidden" id="istSatirId"><div class="form-grid"><label>Sıra no<input id="istSatirSira" type="number" min="1"></label><label>Birim / Ünite<input id="istSatirBirim" maxlength="250"></label><label>Görev / Üretim Hattı<input id="istSatirGorev" maxlength="250"></label><label>Cinsiyet<select id="istSatirCinsiyet"><option>Kadın</option><option>Erkek</option></select></label><label>Yaş durumu<select id="istSatirYas"><option>Genç</option><option>40 yaş ve üstü</option></select></label><label>@sonYil gerçekleşen ortalama tam zamanlı istihdam<input id="istSatirMevcut" type="number" min="0" step="0.01"></label><label>Planlanan net ek tam zamanlı istihdam<input id="istSatirArtis" type="number" step="0.01"></label><label>@sonYil mevcut ortalama brüt ücret (TL)<input id="istSatirBaz" type="number" min="0" step="0.01"></label></div></div><div class="modal-footer"><button type="button" id="istSatirSilBtn" class="btn btn-outline-danger mr-auto" onclick="IstihdamSatirSil()">Sil</button><button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button type="button" class="btn btn-primary" onclick="IstihdamSatirKaydet()">Kaydet</button></div></div></div></div>}
</section>
