@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@{bool edit=!Model.DenetciGorunumu&&!Model.SaltOkunur;}
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruMetraj)">
 <div class="section-toolbar"><div><h2 class="mb-0">Metraj ve İnşaat Maliyeti</h2><small class="text-muted">Yeni binaların yapım bölümleri, pozları ve ölçü detayları</small></div><div class="text-right"><small>Toplam İnşaat Bedeli</small><h3 id="metrajGenelToplam" class="text-primary mb-0">0,00 TL</h3></div></div>
 <div class="alert alert-info">Bina listesindeki <strong>Yeni</strong> binalar burada gösterilir. Önce bina, sonra yapım bölümü seçerek poz ve metraj detaylarını girin.</div>
 <div class="table-responsive basvuru-card">
  <table class="table table-bordered table-hover mb-0 metraj-hiyerarsi-tablosu">
   <thead><tr><th style="width:7%">Bina</th><th style="width:8%">Bölüm</th><th>Tanım / Poz Bilgileri</th><th style="width:190px" class="text-right">Toplam Maliyet</th></tr></thead>
   <tbody id="metrajHiyerarsi"></tbody>
   <tfoot><tr class="table-primary"><th colspan="3" class="text-right">Toplam İnşaat Bedeli</th><th id="metrajTabloGenelToplam" class="text-right">0,00 TL</th></tr></tfoot>
  </table>
 </div>
 @if(edit){
 <div class="modal fade" id="metrajBolumModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Yapım Bölümü</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="metrajBolumIndex" type="hidden"><div class="form-row"><div class="form-group col-3"><label>Bölüm No</label><input id="metrajBolumSira" class="form-control" type="number" min="1" step="1" placeholder="1"></div><div class="form-group col-9"><label>Yapım Bölümü</label><select id="metrajBolumAd" class="form-control"><option value="">Seçiniz</option><option>Hazırlık ve Hafriyat İşleri</option><option>Temel</option><option>Taşıyıcı Sistem</option><option>Çatı</option><option>Duvar</option><option>Döşeme</option><option>Sıva ve Kaplama</option><option>Kapı ve Pencere</option><option>Boya</option><option>Isı ve Su Yalıtımı</option><option>Mekanik Tesisat</option><option>Elektrik Tesisatı</option><option>Yangın Tesisatı</option><option>Asansör</option><option>Çevre Düzenleme</option><option>Diğer İnşaat İşleri</option></select></div></div><small class="text-muted">Bölüm numarası seçili bina içinde 1, 2, 3 şeklinde sıralanır.</small></div><div class="modal-footer"><button id="metrajBolumSilBtn" class="btn btn-outline-danger mr-auto" type="button" onclick="MetrajBolumSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button class="btn btn-primary" type="button" onclick="MetrajBolumKaydet()">Kaydet</button></div></div></div></div>
 <div class="modal fade" id="metrajPozModal" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Poz ve Metraj Detayları</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="metrajPozIndex" type="hidden"><div class="form-row"><div class="form-group col-md-2"><label>Sıra no</label><input id="metrajPozSira" class="form-control" type="number" min="1"></div><div class="form-group col-md-7"><label>Poz</label><select id="metrajPozSecim" class="form-control"></select></div><div class="form-group col-md-3"><label>Birim fiyat</label><div id="metrajPozFiyat" class="form-control bg-light">—</div></div></div><div class="d-flex justify-content-between align-items-center mb-2"><strong>Alt işlemler / ölçüler</strong><button type="button" class="btn btn-sm btn-outline-success" onclick="MetrajDetaySatirEkle()"><i class="fas fa-plus mr-1"></i>Satır ekle</button></div><div class="table-responsive"><table class="table table-bordered table-sm"><thead><tr><th style="min-width:190px">Açıklama</th><th>Adet</th><th>Boy</th><th>En</th><th>Yükseklik</th><th>Miktar</th><th></th></tr></thead><tbody id="metrajDetayListe"></tbody><tfoot><tr><th colspan="5" class="text-right">Poz toplam miktarı</th><th id="metrajModalMiktar">0</th><th></th></tr></tfoot></table></div></div><div class="modal-footer"><button id="metrajPozSilBtn" class="btn btn-outline-danger mr-auto" type="button" onclick="MetrajPozSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button class="btn btn-primary" type="button" onclick="MetrajPozKaydet()">Kaydet</button></div></div></div></div>
 }
</section>
