@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@{bool edit=!Model.DenetciGorunumu&&!Model.SaltOkunur;}
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruMetraj)">
 <div class="section-toolbar"><div><h2 class="mb-0">Metraj Bilgileri</h2><small class="text-muted">Yeni binaların yapım bölümleri, pozları ve ölçü detayları</small></div></div>
 <div class="alert alert-info">Bina listesindeki <strong>Yeni</strong> binalar burada gösterilir. Önce bina, sonra yapım bölümü seçerek poz ve metraj detaylarını girin.</div>
 <div class="table-responsive basvuru-card">
  <table class="table table-bordered table-hover mb-0 metraj-hiyerarsi-tablosu">
   <thead><tr><th style="width:7%">Bina</th><th style="width:8%">Bölüm</th><th>Tanım / Poz Bilgileri</th><th style="width:230px" class="text-right">Poz Toplamı</th></tr></thead>
   <tbody id="metrajHiyerarsi"></tbody>
  </table>
 </div>
 @if(edit){
 <div class="modal fade" id="metrajBolumModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Yapım Bölümü</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="metrajBolumIndex" type="hidden"><input id="metrajBolumSira" type="hidden"><div class="form-group mb-0"><label>Yapım kategorisi</label><select id="metrajBolumKategori" class="form-control"><option value="">Seçiniz</option><option value="1">Temel</option><option value="2">Taşıyıcı Sistem</option><option value="3">Duvar İmalatları</option><option value="4">Çatı Kaplaması</option><option value="5">Diğer İmalatlar</option><option value="6">Çevre Düzenleme İmalatları</option></select></div><small class="text-muted">Her kategori seçili binaya yalnızca bir kez eklenebilir.</small></div><div class="modal-footer"><button id="metrajBolumSilBtn" class="btn btn-outline-danger mr-auto" type="button" onclick="MetrajBolumSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button class="btn btn-primary" type="button" onclick="MetrajBolumKaydet()">Kaydet</button></div></div></div></div>
 <div class="modal fade" id="metrajPozModal" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Poz ve Metraj Detayları</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="metrajPozIndex" type="hidden"><div class="form-row"><div class="form-group col-md-2"><label>Sıra no</label><input id="metrajPozSira" class="form-control" type="number" min="1"></div><div class="form-group col-md-7"><label>Poz</label><select id="metrajPozSecim" class="form-control"></select></div><div class="form-group col-md-3"><label>Birim fiyat</label><div id="metrajPozFiyat" class="form-control bg-light">—</div></div></div><div class="d-flex justify-content-between align-items-center mb-2"><strong>Alt işlemler / ölçüler</strong><button type="button" class="btn btn-sm btn-outline-success" onclick="MetrajDetaySatirEkle()"><i class="fas fa-plus mr-1"></i>Satır ekle</button></div><div class="table-responsive"><table class="table table-bordered table-sm"><thead><tr><th style="min-width:190px">Açıklama</th><th class="metraj-agirlik-alani" style="min-width:150px">Ürün cinsi</th><th class="metraj-agirlik-alani">Birim ağırlık<br><small id="metrajBirimAgirlikBirimi"></small></th><th>Benzer sayısı</th><th>Adet</th><th>Boy</th><th>En</th><th>Yükseklik</th><th>Miktar</th><th></th></tr></thead><tbody id="metrajDetayListe"></tbody><tfoot><tr><th id="metrajToplamEtiket" colspan="8" class="text-right">Poz toplam miktarı</th><th id="metrajModalMiktar">0</th><th></th></tr></tfoot></table></div></div><div class="modal-footer"><button id="metrajPozSilBtn" class="btn btn-outline-danger mr-auto" type="button" onclick="MetrajPozSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">İptal</button><button class="btn btn-primary" type="button" onclick="MetrajPozKaydet()">Kaydet</button></div></div></div></div>
 }
</section>
