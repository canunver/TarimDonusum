@model TarimDonusum.ViewModels.Basvuru.BasvuruFormViewModel
@using TarimDonusum.Models
@using System.Text.Json
@{ bool duzenlenebilir = !Model.DenetciGorunumu && !Model.SaltOkunur; }
<section class="basvuru-panel active" data-panel="@((int)enumBasvuruBolum.BasvuruYatirimdaKullanilacakEkipmanlar)">
 <div class="section-toolbar"><h2 class="mb-0">Teknik Proje (Makine Ekipman)</h2><div class="d-flex align-items-center justify-content-end flex-wrap ml-auto" style="gap:8px"><partial name="_AdresAsamaFiltresi" model="Model" /><a id="yatirimEkipmanYazdirBtn" data-adres-asama-yazdir class="btn btn-outline-primary" href="@Url.Action("YatirimMakineEkipmanListesiYazdir","Basvuru",new{id=Model.Basvuru.Id})" data-base-url="@Url.Action("YatirimMakineEkipmanListesiYazdir","Basvuru",new{id=Model.Basvuru.Id})"><i class="fas fa-file-excel mr-1"></i>Yazdır</a>@if(duzenlenebilir){<a class="btn btn-outline-success" asp-controller="Basvuru" asp-action="YatirimEkipmanlariExcelSablonuIndir"><i class="fas fa-download mr-1"></i>Excel Şablonu</a><label class="btn btn-outline-success mb-0" for="yatirimEkipmanExcelDosya"><i class="fas fa-file-excel mr-1"></i>Excel'den yükle</label><button type="button" class="btn btn-outline-info" title="Excel formatı hakkında bilgi" onclick="$('#yatirimEkipmanExcelYardimModal').modal('show')"><i class="fas fa-question"></i></button><input id="yatirimEkipmanExcelDosya" type="file" accept=".xlsx,.xls" class="d-none" /><button type="button" class="btn btn-primary" id="yatirimEkipmanYeniBtn">Yeni ekipman ekle</button>}</div></div>
 <script type="application/json" id="yatirimEkipmanJson">@Html.Raw(JsonSerializer.Serialize(Model.Basvuru.Makineler.Select(m => new { m.id,m.basvuruId,m.uygulamaAdresiId,m.uygulamaAdresiAciklama,m.degerZinciriAsamaTuru,m.degerZinciriAsamaTuruAdi,m.siraNo,m.ad,m.birim,m.miktar,m.aciklama,m.marka,m.model,m.kapasiteOzellikleri,m.yerlesimPlaniSiraNo,m.kullanimAmaci,m.durum,m.kapasiteSecimGerekcesi,m.teklifKontroluYapilsin,teknikOzellikler=m.teknikOzellikler,teklifler=m.teklifler })))</script>

 <div id="yatirimEkipmanListeAlani"></div>
</section>
@if(duzenlenebilir)
{
<partial name="_YatirimEkipmanModal" model="Model" />

<div class="modal fade" id="yatirimEkipmanExcelYardimModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl"><div class="modal-content">
 <div class="modal-header"><h5 class="modal-title">Yatırım Ekipmanları Excel Formatı</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
 <div class="modal-body">
  <p>İlk satır başlık, ikinci satırdan itibaren ekipman kayıtları olmalıdır. Sütun başlıkları aşağıdaki sırayla ve aynı metinlerle yazılmalıdır.</p>
  <div class="table-responsive"><table class="table table-bordered table-sm"><thead><tr><th>Sütun</th><th>Başlık</th><th>Açıklama</th></tr></thead><tbody>
   <tr><td>A</td><td>Adres No</td><td>Yatırım adresinin ekranda görünen sıra numarasıdır (1, 2 gibi).</td></tr>
   <tr><td>B</td><td>Değer Zinciri Aşaması</td><td>1 - Birincil Üretim, 2 - Depolama / Soğuk Zincir, 3 - Lojistik, 4 - İşleme, 5 - İleri İşleme, 6 - Tarımsal Bileşen Üretimi, 7 - Atık ve Yan Ürün Değerlendirme.</td></tr>
   <tr><td>C</td><td>Makine-ekipmanın adı</td><td>Zorunludur.</td></tr>
   <tr><td>D</td><td>Markası</td><td>En fazla 150 karakter.</td></tr>
   <tr><td>E</td><td>Modeli</td><td>En fazla 150 karakter.</td></tr>
   <tr><td>F</td><td>Adedi</td><td>Sıfırdan büyük sayısal değer.</td></tr>
   <tr><td>G</td><td>Yerleşim planı ve listesindeki sıra numarası</td><td>Boş bırakılabilir; girilirse 1-9999 arasında tam sayı.</td></tr>
   <tr><td>H</td><td>Durum</td><td>Excel'e 1-4 arasında değer girilir:<br>1 - YENİ DESTEK İSTENİYOR<br>2 - YENİ DESTEK İSTEMİYOR<br>3 - MEVCUT KULLANILACAK<br>4 - MEVCUT KULLANILMAYACAK</td></tr>
   <tr><td>I</td><td>İşleme kapasitesi veya kapasite belirleyici özellikleri</td><td>En fazla 2000 karakter.</td></tr>
   <tr><td>J</td><td>Kullanım amacı</td><td>En fazla 2000 karakter.</td></tr>
   <tr><td>K</td><td>Makine-ekipman kapasitesi seçim gerekçesi ve kapasiteyi belirleyen hususlar</td><td>En fazla 4000 karakter.</td></tr>
  </tbody></table></div>
  <p class="mb-0">Adres No başvurudaki yatırım adreslerinde bulunamazsa hiçbir satır yüklenmez ve hata mesajı gösterilir. Yüklenen kayıtlar mevcut ekipmanlara eklenir.</p>
 </div>
 <div class="modal-footer"><a class="btn btn-success mr-auto" href="@Url.Action("YatirimEkipmanlariExcelSablonuIndir", "Basvuru")"><i class="fas fa-download mr-1"></i>Şablon indir</a><button type="button" class="btn btn-primary" data-dismiss="modal">Kapat</button></div>
</div></div></div>
}
