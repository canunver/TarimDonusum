@model List<TarimDonusum.Models.Basvuru>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["Denetleme.Index.Title"];
}

<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>@L["Denetleme.Index.Heading"]</h1>
            <p>@L["Denetleme.Index.Description"]</p>
        </div>
    </div>

    <div id="ajaxMesaj"
         class="alert alert-info alert-dismissible floating-message"
         style="display:@(TempData["Mesaj"] != null ? "block" : "none")">
        <span id="ajaxMesajMetin">@TempData["Mesaj"]</span>
        <button type="button" id="ajaxMesajKapat" class="close" aria-label="@L["Basvuru.Common.Close"]">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="table-responsive basvuru-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Basvuru.Common.No"]</th>
                    <th>@L["Basvuru.Field.TicaretUnvani"]</th>
                    <th>@L["Basvuru.Field.YatirimAdi"]</th>
                    <th>@L["Basvuru.Field.Durum"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grup in Model.GroupBy(x => x.BasvuruAnaId))
                {
                    var versiyonlar = grup.OrderByDescending(x => x.basvuruFirma.revizyonNo).ThenByDescending(x => x.Id).ToList();
                    var item = versiyonlar.FirstOrDefault(x => x.basvuruFirma.siraNo == 0) ?? versiyonlar[0];
                    var inceleLinkId = $"basvuruIncele_{item.BasvuruAnaId}";
                    <tr>
                        <td>
                            <select class="form-select form-select-sm basvuru-version-select"
                                    aria-label="Başvuru versiyonu"
                                    data-target="@inceleLinkId"
                                    data-url="@Url.Action("Basvuru", "Denetleme")">
                                @foreach (var versiyon in versiyonlar)
                                {
                                    if (versiyon.Id == item.Id)
                                    {
                                        <option value="@versiyon.Id" selected>V@(versiyon.basvuruFirma.revizyonNo + 1)</option>
                                    }
                                    else
                                    {
                                        <option value="@versiyon.Id">V@(versiyon.basvuruFirma.revizyonNo + 1)</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>@item.basvuruFirma.firma.ticaretUnvani</td>
                        <td>@(string.IsNullOrWhiteSpace(item.yatirim.yatirimAdi) ? "-" : item.yatirim.yatirimAdi)</td>
                        <td><span class="badge bg-secondary">@IsimBul.EnumAdi(item.durum, L)</span></td>
                        <td class="text-end">
                            <a id="@inceleLinkId" class="btn btn-sm btn-outline-primary" asp-controller="Denetleme" asp-action="Basvuru" asp-route-id="@item.Id">@L["Basvuru.Common.View"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    $(function () {
        if (typeof PopupMesajIlklendir === 'function') {
            PopupMesajIlklendir();
        }

        $('.basvuru-version-select').on('change', function () {
            const hedef = document.getElementById(this.dataset.target);
            if (hedef) {
                hedef.href = this.dataset.url + '?id=' + encodeURIComponent(this.value);
            }
        });
    });
</script>
