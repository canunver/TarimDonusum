@{ ViewData["Title"] = "Tamlık ve Uygunluk Soruları"; }
<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>Detaylı Tamlık ve Uygunluk Soruları</h1>
            <p>Tam başvuru uygunluk kontrolünde uzmanın Evet / Hayır ile değerlendireceği soruları buradan ekleyebilir ve düzenleyebilirsiniz.</p>
        </div>
        <button class="btn btn-primary" onclick="ac()"><i class="fas fa-plus mr-1"></i>Yeni soru</button>
    </div>
    <div class="table-responsive basvuru-card">
        <table class="table table-hover">
            <thead><tr><th style="width:70px">No</th><th>Kontrol sorusu</th><th>Kontrol açıklaması / uygulama esası</th><th style="width:200px">Kaynak belge / form</th><th style="width:90px">Durum</th><th style="width:110px"></th></tr></thead>
            <tbody id="liste"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 id="modalBaslik">Uygunluk sorusu</h5><button class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <input id="id" type="hidden">
                <div class="form-grid">
                    <label>Sıra no<input id="sira" type="number" min="1"></label>
                    <label>Kaynak belge / form<input id="kaynakBelge" maxlength="500"></label>
                    <label>Durum<select id="aktif"><option value="true">Aktif</option><option value="false">Pasif</option></select></label>
                </div>
                <label class="wide-label">Kontrol sorusu<textarea id="soru" rows="3" maxlength="1000"></textarea></label>
                <label class="wide-label">Kontrol açıklaması / uygulama esası<textarea id="kontrolAciklamasi" rows="4" maxlength="2000"></textarea></label>
                <small class="form-text text-muted">Sorular olumlu ifade edilir; karşılanıyorsa Evet, karşılanmıyorsa Hayır işaretlenir. Pasif sorular yeni kontrollerde gösterilmez.</small>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button>
                <button class="btn btn-primary" onclick="kaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {<script>
let veriler = [];
const esc = x => $('<div>').text(x ?? '').html();
function hata(s) { PopupMesajGoster(s?.hataStr || 'İşlem gerçekleştirilemedi.', false); }
function listele() {
    AjaxGet('/TamBasvuruUygunlukSorusu/Listele', null, s => {
        if (!s?.basarili) return hata(s);
        veriler = s.nesne || [];
        $('#liste').html(veriler.length
            ? veriler.map(x => `<tr class="${x.aktif ? '' : 'text-muted'}"><td>${x.siraNo}</td><td>${esc(x.soru)}</td><td class="small">${esc(x.kontrolAciklamasi)}</td><td>${esc(x.kaynakBelge)}</td><td>${x.aktif ? 'Aktif' : 'Pasif'}</td><td><button class="btn btn-sm btn-outline-primary" onclick="ac(${x.id})">Düzenle</button></td></tr>`).join('')
            : '<tr><td colspan="6" class="text-muted">Henüz uygunluk sorusu tanımlanmadı.</td></tr>');
    });
}
function ac(id) {
    const x = veriler.find(y => y.id === id) || { id: 0, siraNo: Math.max(0, ...veriler.map(y => Number(y.siraNo) || 0)) + 1, soru: '', kontrolAciklamasi: '', kaynakBelge: '', aktif: true };
    $('#modalBaslik').text(x.id ? 'Uygunluk sorusu düzenle' : 'Yeni uygunluk sorusu');
    $('#id').val(x.id); $('#sira').val(x.siraNo); $('#soru').val(x.soru);
    $('#kontrolAciklamasi').val(x.kontrolAciklamasi); $('#kaynakBelge').val(x.kaynakBelge); $('#aktif').val(String(x.aktif));
    $('#modal').modal('show');
}
function kaydet() {
    const tanim = { id: +$('#id').val(), siraNo: +$('#sira').val(), soru: $('#soru').val(), kontrolAciklamasi: $('#kontrolAciklamasi').val(), kaynakBelge: $('#kaynakBelge').val(), aktif: $('#aktif').val() === 'true' };
    AjaxPost('/TamBasvuruUygunlukSorusu/Kaydet', tanim, s => {
        if (!s?.basarili) return hata(s);
        $('#modal').modal('hide');
        PopupMesajGoster(s.mesaj || 'Uygunluk sorusu kaydedildi.', true);
        listele();
    });
}
$(listele);
</script>}
