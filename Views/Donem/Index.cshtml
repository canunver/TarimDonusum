@model List<TarimDonusum.Models.Il>
@{
    ViewData["Title"] = "Dönemler";
}

<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>Dönemler</h1>
            <p>Başvuru dönemlerini oluşturun ve düzenleyin.</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="DonemModalAc()">
            <i class="fas fa-plus-circle mr-1"></i>Yeni
        </button>
    </div>

    @Html.AntiForgeryToken()
    <div class="table-responsive basvuru-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Yıl</th>
                    <th>Dönem adı</th>
                    <th>Başvuru başlangıcı</th>
                    <th>Başvuru bitişi</th>
                    <th>Durum</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody id="donemListe"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="donemModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content firma-modal-content">
            <div class="modal-header firma-modal-header">
                <h5 class="modal-title" id="donemModalBaslik">Yeni dönem</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span>&times;</span></button>
            </div>
            <div class="modal-body firma-modal-body">
                <input type="hidden" id="donemId" value="0" />
                <div class="donem-form-grid">
                    <label>Yıl<input id="donemYil" type="number" min="2000" max="2200" class="form-control" /></label>
                    <label>Dönem adı<input id="donemAd" maxlength="150" class="form-control" /></label>
                    <label>Ön Başvuru başlangıç tarihi<input id="onBasvuruBaslangic" type="date" class="form-control" /></label>
                    <label>Ön başvuru bitiş tarihi<input id="onBasvuruBitis" type="date" class="form-control" /></label>
                    <label>Başvuru başlangıç tarihi<input id="basvuruBaslangic" type="date" class="form-control" /></label>
                    <label>Başvuru bitiş tarihi<input id="basvuruBitis" type="date" class="form-control" /></label>
                    <label>Ön Başvuru Çevrim kuru<input id="onBasvuruCevrimKuru" type="number" min="0" step="0.000001" class="form-control" /></label>
                    <label>Başvuru Çevrim kuru<input id="basvuruCevrimKuru" type="number" min="0" step="0.000001" class="form-control" /></label>
                    <label>Başvuru durumu
                        <select id="basvuruyaAcik" class="form-control"><option value="true">Açık</option><option value="false">Kapalı</option></select>
                    </label>
                    <label>Minimum yatırım tutarı<input id="minimumYatirim" type="text" inputmode="numeric" class="form-control money-integer" /></label>
                    <label>Maksimum yatırım tutarı<input id="maksimumYatirim" type="text" inputmode="numeric" class="form-control money-integer" /></label>
                    <label>Maksimum destek tutarı (EUR)<input id="maksimumDestek" type="text" inputmode="numeric" class="form-control money-integer" /></label>
                    <label>Destek oranı (%)<input id="destekOrani" type="number" min="0" max="100" step="0.01" class="form-control" /></label>
                    <label>İstisna kredi oranı (%)<input id="istisnaDestekOrani" type="number" min="0" max="100" step="0.01" class="form-control" /></label>
                    <label>Uygulama adresi sınırlı mı?
                        <select id="uygulamaAdresiSinirliMi" class="form-control"><option value="false">Hayır</option><option value="true">Evet (en fazla 1 adres)</option></select>
                    </label>
                    <label class="donem-form-full">Açıklama<textarea id="aciklama" rows="3" class="form-control"></textarea></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" onclick="DonemKaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="istisnaIlceModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content firma-modal-content istisna-ilce-modal-content">
            <div class="modal-header firma-modal-header">
                <div>
                    <h5 class="modal-title">İstisna ilçeleri düzenle</h5>
                    <small id="istisnaIlceDonemAdi" class="text-muted"></small>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span>&times;</span></button>
            </div>
            <div class="modal-body firma-modal-body istisna-ilce-modal-body">
                <input type="hidden" id="istisnaIlceDonemId" value="0" />
                <select id="istisnaIlceIds" class="d-none" multiple>
                    @foreach (var il in Model.OrderBy(x => x.kod))
                    {
                        @foreach (var ilce in il.ilceler.Where(x => x.Aktif).OrderBy(x => x.Ad))
                        {
                            <option value="@ilce.Id" data-il-id="@il.id" data-il-adi="@il.ad">@ilce.Ad</option>
                        }
                    }
                </select>
                <div class="istisna-ilce-araclar">
                    <div class="form-row align-items-end">
                        <div class="col-md-4">
                            <label>İl
                                <select id="istisnaIl" class="form-control" onchange="IstisnaIlDegisti()">
                                    <option value="">İl seçiniz</option>
                                    @foreach (var il in Model.Where(x => x.aktif).OrderBy(x => x.kod))
                                    {
                                        <option value="@il.id">@il.ad</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <label>İlçe
                                <select id="istisnaIlce" class="form-control" disabled><option value="">Önce il seçiniz</option></select>
                            </label>
                        </div>
                        <div class="col-md-2 mt-2 mt-md-0">
                            <button type="button" class="btn btn-outline-primary btn-block" onclick="IstisnaIlceEkle()"><i class="fas fa-plus mr-1"></i>Ekle</button>
                        </div>
                        <div class="col-md-2 mt-2 mt-md-0">
                            <button type="button" class="btn btn-primary btn-block" onclick="IstisnaIlceleriKaydet()"><i class="fas fa-save mr-1"></i>Kaydet</button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive istisna-ilce-liste">
                    <table class="table table-sm table-bordered mb-0">
                        <thead><tr><th>İl</th><th>İlçe</th><th class="text-right">İşlem</th></tr></thead>
                        <tbody id="istisnaIlceListesi"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .donem-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem 1.25rem;
    }
    .donem-form-grid label { margin: 0; }
    .donem-form-full { grid-column: 1 / -1; }
    .istisna-ilce-modal-content { height: min(760px, calc(100vh - 3.5rem)); }
    .istisna-ilce-modal-body { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
    .istisna-ilce-araclar { flex: 0 0 auto; position: sticky; top: 0; z-index: 2; padding-bottom: 1rem; background: #fff; }
    .istisna-ilce-araclar label { display: block; margin-bottom: 0; }
    .istisna-ilce-liste { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
    .istisna-ilce-liste thead th { position: sticky; top: 0; z-index: 1; background: #f8f9fa; }
    @@media (max-width: 767.98px) {
        .donem-form-grid { grid-template-columns: 1fr; }
        .donem-form-full { grid-column: auto; }
    }
</style>

@section Scripts {
<script>
    const donemler = [];
    const tarihDegeri = value => value ? String(value).substring(0, 10) : '';
    const paraDegeri = id => {
        const deger = paraTamsayiDegeri($(id).val());
        return deger === '' ? null : Number(deger);
    };
    const htmlEncode = value => $('<div/>').text(value == null ? '' : String(value)).html();

    function IstisnaIlDegisti() {
        const ilId = Number($('#istisnaIl').val() || 0);
        const ilce = $('#istisnaIlce').empty();
        ilce.append(`<option value="">${ilId ? 'İlçe seçiniz' : 'Önce il seçiniz'}</option>`);
        $('#istisnaIlceIds option').filter(function () { return Number(this.dataset.ilId) === ilId; }).each(function () {
            ilce.append($('<option/>').val(this.value).text(this.textContent));
        });
        ilce.prop('disabled', ilId <= 0);
    }

    function IstisnaIlceEkle() {
        const ilceId = String($('#istisnaIlce').val() || '');
        if (!ilceId) { PopupMesajGoster('İlçe seçiniz.', false); return; }
        $(`#istisnaIlceIds option[value="${ilceId}"]`).prop('selected', true);
        IstisnaIlceListesiniYaz();
    }

    function IstisnaIlceCikart(ilceId) {
        $(`#istisnaIlceIds option[value="${Number(ilceId)}"]`).prop('selected', false);
        IstisnaIlceListesiniYaz();
    }

    function IstisnaIlceListesiniYaz() {
        const tbody = $('#istisnaIlceListesi').empty();
        const secili = $('#istisnaIlceIds option:selected').get().sort((a, b) =>
            String(a.dataset.ilAdi).localeCompare(String(b.dataset.ilAdi), 'tr') || a.text.localeCompare(b.text, 'tr'));
        if (!secili.length) {
            tbody.append('<tr><td colspan="3" class="text-center text-muted">Henüz istisna ilçesi eklenmedi.</td></tr>');
            return;
        }
        secili.forEach(option => tbody.append(`<tr><td>${htmlEncode(option.dataset.ilAdi)}</td><td>${htmlEncode(option.text)}</td><td class="text-right"><button type="button" class="btn btn-sm btn-outline-danger" onclick="IstisnaIlceCikart(${Number(option.value)})"><i class="fas fa-times mr-1"></i>Çıkart</button></td></tr>`));
    }

    function DonemListeYaz() {
        const tbody = $('#donemListe').empty();
        donemler.forEach(d => tbody.append(`<tr>
            <td>${htmlEncode(d.yil)}</td><td>${htmlEncode(d.ad)}</td>
            <td>${htmlEncode(tarihDegeri(d.basvuruBaslangicTarihi) || '-')}</td>
            <td>${htmlEncode(tarihDegeri(d.basvuruBitisTarihi) || '-')}</td>
            <td><span class="badge ${d.basvuruyaAcikMi ? 'badge-success' : 'badge-secondary'}">${d.basvuruyaAcikMi ? 'Açık' : 'Kapalı'}</span></td>
            <td class="text-right text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="DonemModalAc(${d.id})">Düzenle</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ml-1" onclick="IstisnaIlceModalAc(${d.id})">İlçe Düzenle</button>
            </td>
        </tr>`));
    }

    function DonemModalAc(id) {
        const d = donemler.find(x => Number(x.id) === Number(id)) || { id: 0, yil: new Date().getFullYear(), basvuruyaAcikMi: false };
        $('#donemModalBaslik').text(d.id ? 'Dönem düzenle' : 'Yeni dönem');
        $('#donemId').val(d.id || 0); $('#donemYil').val(d.yil || ''); $('#donemAd').val(d.ad || '');
        $('#basvuruBaslangic').val(tarihDegeri(d.basvuruBaslangicTarihi));
        $('#onBasvuruBaslangic').val(tarihDegeri(d.onBasvuruBaslangicTarihi));
        $('#onBasvuruBitis').val(tarihDegeri(d.onBasvuruBitisTarihi)); $('#basvuruBitis').val(tarihDegeri(d.basvuruBitisTarihi));
        $('#onBasvuruCevrimKuru').val(d.onBasvuruCevrimKuru ?? ''); $('#basvuruCevrimKuru').val(d.basvuruCevrimKuru ?? '');
        $('#minimumYatirim').val(d.minimumYatirimTutari ?? ''); $('#maksimumYatirim').val(d.maksimumYatirimTutari ?? '');
        $('#maksimumDestek').val(d.maksimumDestekTutari ?? ''); $('#destekOrani').val(d.destekOrani ?? '');
        $('#istisnaDestekOrani').val(d.istisnaDestekOrani ?? '');
        $('#uygulamaAdresiSinirliMi').val(String(d.uygulamaAdresiSinirliMi === true));
        $('#basvuruyaAcik').val(String(d.basvuruyaAcikMi === true)); $('#aciklama').val(d.aciklama || '');
        document.querySelectorAll('#donemModal .money-integer').forEach(paraFormatla);
        $('#donemModal').modal('show');
    }

    function IstisnaIlceModalAc(id) {
        const d = donemler.find(x => Number(x.id) === Number(id));
        if (!d) { PopupMesajGoster('Dönem bulunamadı.', false); return; }
        $('#istisnaIlceDonemId').val(d.id);
        $('#istisnaIlceDonemAdi').text(`${d.yil} - ${d.ad}`);
        $('#istisnaIlceIds').val((d.istisnaIlceIds || []).map(String));
        $('#istisnaIl').val('');
        IstisnaIlDegisti();
        IstisnaIlceListesiniYaz();
        $('#istisnaIlceModal').modal('show');
    }

    function DonemKayitModeli(d) {
        return {
            ...d,
            istisnaIlceIds: Array.isArray(d.istisnaIlceIds) ? d.istisnaIlceIds.map(Number) : []
        };
    }

    function IstisnaIlceleriKaydet() {
        const id = Number($('#istisnaIlceDonemId').val() || 0);
        const d = donemler.find(x => Number(x.id) === id);
        if (!d) { PopupMesajGoster('Dönem bulunamadı.', false); return; }
        const model = DonemKayitModeli(d);
        model.istisnaIlceIds = ($('#istisnaIlceIds').val() || []).map(Number);
        AjaxPost('/Donem/Kaydet', model, function (sonuc) {
            if (!sonuc || !sonuc.basarili) { PopupMesajGoster((sonuc && sonuc.hataStr) || 'İstisna ilçeleri kaydedilemedi.', false); return; }
            $('#istisnaIlceModal').modal('hide');
            PopupMesajGoster('İstisna ilçeleri kaydedildi.', true);
            DonemListele();
        });
    }

    function DonemKaydet() {
        const donemId = Number($('#donemId').val() || 0);
        const mevcutDonem = donemler.find(x => Number(x.id) === donemId);
        AjaxPost('/Donem/Kaydet', {
            id: donemId, yil: Number($('#donemYil').val() || 0), ad: $('#donemAd').val(),
            basvuruyaAcikMi: $('#basvuruyaAcik').val() === 'true',
            basvuruBaslangicTarihi: $('#basvuruBaslangic').val() || null,
            onBasvuruBaslangicTarihi: $('#onBasvuruBaslangic').val() || null, onBasvuruBitisTarihi: $('#onBasvuruBitis').val() || null,
            basvuruBitisTarihi: $('#basvuruBitis').val() || null, minimumYatirimTutari: paraDegeri('#minimumYatirim'),
            maksimumYatirimTutari: paraDegeri('#maksimumYatirim'), maksimumDestekTutari: paraDegeri('#maksimumDestek'),
            onBasvuruCevrimKuru: $('#onBasvuruCevrimKuru').val() === '' ? null : Number($('#onBasvuruCevrimKuru').val()),
            basvuruCevrimKuru: $('#basvuruCevrimKuru').val() === '' ? null : Number($('#basvuruCevrimKuru').val()),
            destekOrani: $('#destekOrani').val() === '' ? null : Number($('#destekOrani').val()),
            istisnaDestekOrani: $('#istisnaDestekOrani').val() === '' ? null : Number($('#istisnaDestekOrani').val()),
            istisnaIlceIds: (mevcutDonem?.istisnaIlceIds || []).map(Number),
            uygulamaAdresiSinirliMi: $('#uygulamaAdresiSinirliMi').val() === 'true', aciklama: $('#aciklama').val()
        }, function (sonuc) {
            if (!sonuc || !sonuc.basarili) { PopupMesajGoster((sonuc && sonuc.hataStr) || 'Dönem kaydedilemedi.', false); return; }
            $('#donemModal').modal('hide'); PopupMesajGoster(sonuc.mesaj || 'Dönem kaydedildi.', true); DonemListele();
        });
    }

    function DonemListele() {
        AjaxGet('/Donem/Listele', null, function (sonuc) {
            if (!sonuc || !sonuc.basarili) { PopupMesajGoster((sonuc && sonuc.hataStr) || 'Dönemler alınamadı.', false); return; }
            donemler.splice(0, donemler.length, ...(sonuc.nesne || [])); DonemListeYaz();
        });
    }
    $(function () { PopupMesajIlklendir(); ParaTamsayiAyarla(); DonemListele(); });
</script>
}
