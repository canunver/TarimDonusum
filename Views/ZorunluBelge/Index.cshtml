@{ ViewData["Title"] = "Zorunlu Belgeler"; }
<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>Zorunlu Belgeler</h1>
            <p>Ön başvurunun Zorunlu Belgeler sayfasında ve tüzel kişi ortaklardan istenen belgeleri buradan ekleyebilir ve düzenleyebilirsiniz.</p>
        </div>
        <div class="d-flex" style="gap:8px">
            <button class="btn btn-outline-info" title="Belge adında kullanılabilecek yer tutucular" onclick="$('#yardimModal').modal('show')"><i class="fas fa-question"></i></button>
            <button class="btn btn-primary" onclick="ac()"><i class="fas fa-plus mr-1"></i>Yeni belge</button>
        </div>
    </div>
    <div class="table-responsive basvuru-card">
        <table class="table table-hover">
            <thead><tr><th style="width:70px">Sıra</th><th style="width:90px">Belge no</th><th>Belge adı</th><th>Örnek görünüm (<span class="ornek-yil"></span> dönemi)</th><th style="width:150px">Kimden istenir</th><th style="width:90px">Durum</th><th style="width:110px"></th></tr></thead>
            <tbody id="liste"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 id="modalBaslik">Zorunlu belge</h5><button class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <input id="id" type="hidden">
                <div class="form-grid">
                    <label>Sıra no<input id="sira" type="number" min="1"></label>
                    <label>Kimden istenir<select id="sadeceKooperatif"><option value="false">Tüm başvuru sahipleri ve tüzel kişi ortaklar</option><option value="true">Yalnızca kooperatif / üretici örgütü başvuru sahipleri</option></select></label>
                    <label>Durum<select id="aktif"><option value="true">Aktif</option><option value="false">Pasif</option></select></label>
                </div>
                <label class="wide-label">Belge adı <button type="button" class="btn btn-sm btn-link p-0 ml-1" title="Yer tutucular" onclick="$('#yardimModal').modal('show')"><i class="fas fa-question-circle"></i></button><input id="ad" maxlength="500" oninput="onizle()"></label>
                <small class="form-text text-muted">Önizleme (<span class="ornek-yil"></span> dönemi): <strong id="onizleme"></strong></small>
                <small class="form-text text-muted">Pasif belgeler başvuru sayfalarında gösterilmez; daha önce yüklenmiş dosyalar silinmez.</small>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button>
                <button class="btn btn-primary" onclick="kaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="yardimModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5>Belge adında yıl yer tutucuları</h5><button class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <p>Belge adına aşağıdaki ifadeler yazılırsa, başvuru sayfasında başvurunun dönem yılına göre gerçek yıla çevrilir.</p>
                <table class="table table-sm table-bordered">
                    <thead><tr><th>Yazılan</th><th>Anlamı</th><th>2027 döneminde görünen</th></tr></thead>
                    <tbody>
                        <tr><td><code>[dönem]</code></td><td>Başvuru dönem yılı</td><td>2027</td></tr>
                        <tr><td><code>[dönem-1]</code></td><td>Dönem yılından bir önceki yıl (son tamamlanmış yıl)</td><td>2026</td></tr>
                        <tr><td><code>[dönem-2]</code></td><td>Dönem yılından iki önceki yıl</td><td>2025</td></tr>
                        <tr><td><code>[dönem+1]</code></td><td>Dönem yılından bir sonraki yıl</td><td>2028</td></tr>
                    </tbody>
                </table>
                <p>Tablodakiler yalnızca örnektir; işaretten sonra 0–99 arası istenen sayı yazılabilir (ör. <code>[dönem-5]</code> → 2022, <code>[dönem+3]</code> → 2030).</p>
                <p class="mb-2"><strong>Örnek:</strong> <code>[dönem-1] yılına ait gelir tablosu</code> → 2027 döneminde "2026 yılına ait gelir tablosu".</p>
                <ul class="mb-0">
                    <li>Büyük/küçük harf fark etmez; <code>[donem-1]</code> veya <code>[DÖNEM-1]</code> de yazılabilir.</li>
                    <li>Belge adında geçmiş bir yıl varsa (ör. <code>[dönem-2]</code>), firma o yıldan sonra kurulduysa bu belge firmadan istenmez.</li>
                </ul>
            </div>
            <div class="modal-footer"><button class="btn btn-primary" data-dismiss="modal">Kapat</button></div>
        </div>
    </div>
</div>

@section Scripts {<script>
let veriler = [];
const ornekYil = new Date().getFullYear() + 1;
const esc = x => $('<div>').text(x ?? '').html();
// Sunucudaki ZorunluBelgeTanimSaglayici.YillariYaz ile aynı kural.
const yillariYaz = (ad, yil) => (ad || '').replace(/\[\s*d[öo]nem\s*(?:([+-])\s*(\d{1,2}))?\s*\]/gi, (m, isaret, fark) => String(isaret === '-' ? yil - Number(fark || 0) : yil + Number(fark || 0)));
function hata(s) { PopupMesajGoster(s?.hataStr || 'İşlem gerçekleştirilemedi.', false); }
function onizle() { $('#onizleme').text(yillariYaz($('#ad').val(), ornekYil)); }
function listele() {
    AjaxGet('/ZorunluBelge/Listele', null, s => {
        if (!s?.basarili) return hata(s);
        veriler = s.nesne || [];
        $('#liste').html(veriler.length
            ? veriler.map(x => `<tr class="${x.aktif ? '' : 'text-muted'}"><td>${x.siraNo}</td><td>${x.belgeNo}</td><td>${esc(x.ad)}</td><td>${esc(yillariYaz(x.ad, ornekYil))}</td><td>${x.sadeceKooperatif ? 'Yalnızca kooperatif / üretici örgütü' : 'Tümü'}</td><td>${x.aktif ? 'Aktif' : 'Pasif'}</td><td><button class="btn btn-sm btn-outline-primary" onclick="ac(${x.id})">Düzenle</button></td></tr>`).join('')
            : '<tr><td colspan="7" class="text-muted">Henüz zorunlu belge tanımlanmadı.</td></tr>');
    });
}
function ac(id) {
    const x = veriler.find(y => y.id === id) || { id: 0, siraNo: Math.max(0, ...veriler.map(y => Number(y.siraNo) || 0)) + 1, ad: '', sadeceKooperatif: false, aktif: true };
    $('#modalBaslik').text(x.id ? `Zorunlu belge düzenle (belge no ${x.belgeNo})` : 'Yeni zorunlu belge');
    $('#id').val(x.id); $('#sira').val(x.siraNo); $('#ad').val(x.ad);
    $('#sadeceKooperatif').val(String(x.sadeceKooperatif)); $('#aktif').val(String(x.aktif));
    onizle();
    $('#modal').modal('show');
}
function kaydet() {
    const tanim = { id: +$('#id').val(), siraNo: +$('#sira').val(), ad: $('#ad').val(), sadeceKooperatif: $('#sadeceKooperatif').val() === 'true', aktif: $('#aktif').val() === 'true' };
    AjaxPost('/ZorunluBelge/Kaydet', tanim, s => {
        if (!s?.basarili) return hata(s);
        $('#modal').modal('hide');
        PopupMesajGoster(s.mesaj || 'Zorunlu belge kaydedildi.', true);
        listele();
    });
}
$(() => { $('.ornek-yil').text(ornekYil); listele(); });
</script>}
