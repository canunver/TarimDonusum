@model TarimDonusum.Models.OnBasvuruItirazViewModel
@using TarimDonusum.Models
@{
    ViewData["Title"] = "Ön Başvuru İtirazı";
    var b=Model.Basvuru;
    bool basvuranYazabilir=!Model.UzmanGorunumu && b.durum==enumBasvuruDurum.IptalDurumu;
    bool uzmanYazabilir=Model.UzmanGorunumu && b.durum==enumBasvuruDurum.OnBasvuruItirazEdildiDurumu;
    string no=string.IsNullOrWhiteSpace(b.basvuruFirma.basvuruNo)?$"#{b.Id}":b.basvuruFirma.basvuruNo!;
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div><h1>Ön Başvuru İtirazı</h1><div class="text-muted">@no — @b.basvuruFirma.firma.ticaretUnvani</div></div>
        <a class="btn btn-outline-secondary" asp-controller="@(Model.UzmanGorunumu?"Denetleme":"Basvuru")" asp-action="Index">Listeye Dön</a>
    </div>
    @if(!string.IsNullOrWhiteSpace(b.DenetimGerekcesi)){
        <div class="alert alert-danger"><strong>Ön başvuru ret gerekçesi</strong><div style="white-space:pre-wrap">@b.DenetimGerekcesi</div></div>
    }
    <div class="card mb-4"><div class="card-header font-weight-bold">İtiraz Tarihçesi</div><div class="card-body">
        @if(Model.Tarihce.Count==0){<div class="text-muted">Henüz itiraz kaydı bulunmuyor.</div>}
        else { foreach(var x in Model.Tarihce){
            string baslik=x.IslemTuru switch { enumOnBasvuruItirazIslemTuru.ItirazEdildi=>"Başvuran İtirazı",enumOnBasvuruItirazIslemTuru.ItirazReddedildi=>"İtiraz Reddedildi",_=>"Revizyona Gönderildi"};
            string renk=x.IslemTuru==enumOnBasvuruItirazIslemTuru.ItirazEdildi?"border-info":x.IslemTuru==enumOnBasvuruItirazIslemTuru.ItirazReddedildi?"border-danger":"border-success";
            <div class="border-left @renk pl-3 py-2 mb-3"><div class="d-flex justify-content-between"><strong>@baslik</strong><span class="text-muted">@x.IslemTarihi.ToString("dd.MM.yyyy HH:mm")</span></div><div class="small text-muted mb-2">@x.KullaniciAdi</div><div style="white-space:pre-wrap">@x.Metin</div></div>
        }}
    </div></div>
    @if(basvuranYazabilir){
        <div class="card"><div class="card-header font-weight-bold">Yeni İtiraz</div><div class="card-body">
            <p>Ön başvurunuzun neden kabul edilmesi gerektiğini açıklayınız.</p>
            <textarea id="itirazMetni" class="form-control" rows="8" maxlength="4000"></textarea>
            <button id="itirazGonder" class="btn btn-primary mt-3">İtirazı İlet</button>
        </div></div>
    } else if(uzmanYazabilir){
        <div class="card"><div class="card-header font-weight-bold">Uzman Kararı</div><div class="card-body">
            <label for="kararGerekcesi">Karar gerekçesi</label><textarea id="kararGerekcesi" class="form-control" rows="6" maxlength="4000"></textarea>
            <div class="mt-3"><button id="itirazReddet" class="btn btn-danger mr-2">İtirazı Reddet</button><button id="revizyonaGonder" class="btn btn-success">Revizyona Gönder</button></div>
            <div class="alert alert-info mt-3 mb-0">İtiraz üzerinden doğrudan kabul verilemez. Başvuran revizyonu tamamlayıp yeniden sunduktan sonra normal inceleme süreci işletilir.</div>
        </div></div>
    } else if(b.durum==enumBasvuruDurum.OnBasvuruItirazEdildiDurumu){<div class="alert alert-info">İtirazınız uzman değerlendirmesini bekliyor.</div>}
</div>
<form id="tokenForm">@Html.AntiForgeryToken()</form>
@section Scripts {<script>
(()=>{const token=document.querySelector('#tokenForm input')?.value;const mesaj=(m,ok)=>PopupMesajGoster(m,ok);
const post=(url,data)=>fetch(url,{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token},body:JSON.stringify(data)}).then(r=>r.json()).then(x=>{mesaj(x.mesaj||(x.hatalar||[]).join(' '),!!x.basarili);if(x.basarili)setTimeout(()=>location.reload(),800);}).catch(()=>mesaj('İşlem tamamlanamadı.',false));
document.getElementById('itirazGonder')?.addEventListener('click',()=>{const metin=document.getElementById('itirazMetni').value.trim();if(!metin)return mesaj('İtiraz metni girilmelidir.',false);post('/Itiraz/Gonder',{basvuruId:@b.Id,metin});});
const karar=revizyonaGonder=>{const metin=document.getElementById('kararGerekcesi').value.trim();if(!metin)return mesaj('Karar gerekçesi girilmelidir.',false);if(!confirm(revizyonaGonder?'Ön başvuru revizyona gönderilsin mi?':'İtiraz reddedilsin mi?'))return;post('/Itiraz/Karar',{basvuruId:@b.Id,metin,revizyonaGonder});};
document.getElementById('itirazReddet')?.addEventListener('click',()=>karar(false));document.getElementById('revizyonaGonder')?.addEventListener('click',()=>karar(true));})();
</script>}
