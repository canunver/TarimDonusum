@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TarimDonusum.SharedResource> L
@{
    var title = ViewData["Title"] ?? L["Layout.DefaultTitle"];
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var kullaniciAdSoyad = Context.Session.GetString("KULLANICI_ADSOYAD") ?? "";
    var kullaniciId = Context.Session.GetInt32("KULLANICI_ID") ?? 0;
    var temaCookieAdi = $"KullaniciTema_{kullaniciId}";
    var izinliTemalar = new HashSet<string>(StringComparer.Ordinal)
    {
        "sidebar-dark-primary",
        "sidebar-dark-success",
        "sidebar-dark-info",
        "sidebar-light-primary"
    };
    var kullaniciTemasi = Context.Request.Cookies[temaCookieAdi] ?? "sidebar-dark-primary";
    if (!izinliTemalar.Contains(kullaniciTemasi))
        kullaniciTemasi = "sidebar-dark-primary";
}

<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TarimDonusum.styles.css" asp-append-version="true" />
    <style>
        .flag {
            width: 24px;
            height: 18px;
            border: 1px solid #ced4da;
            border-radius: 2px;
        }

        .flag-active {
            width: 24px;
            height: 18px;
            border: 2px solid #007bff;
            border-radius: 2px;
        }

        .basvuru-content {
            background: #f4f6f9;
        }

        .user-chip {
            color: #495057;
            font-weight: 600;
        }
    </style>
</head>

<body class="hold-transition sidebar-mini layout-fixed basvuru-layout kullanici-tema-@kullaniciTemasi">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>

            <span class="navbar-brand mb-0 h1">
                @L["Layout.ApplicationPortal"]
            </span>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item mr-2">
                    <a class="nav-link p-1 flag-link"
                       asp-controller="Dil"
                       asp-action="Degistir"
                       asp-route-culture="tr"
                       asp-route-returnUrl="@returnUrl"
                       title="Turkce">
                        <img src="~/img/flags/tr.svg" class="@(culture == "tr" ? "flag-active" : "flag")" />
                    </a>
                </li>

                <li class="nav-item mr-3">
                    <a class="nav-link p-1 flag-link"
                       asp-controller="Dil"
                       asp-action="Degistir"
                       asp-route-culture="en"
                       asp-route-returnUrl="@returnUrl"
                       title="English">
                        <img src="~/img/flags/gb.svg" class="@(culture == "en" ? "flag-active" : "flag")" />
                    </a>
                </li>

                <li class="nav-item dropdown user-menu-dropdown">
                    <a class="nav-link user-chip dropdown-toggle"
                       href="#"
                       id="kullaniciMenu"
                       role="button"
                       data-toggle="dropdown"
                       aria-haspopup="true"
                       aria-expanded="false">
                        <i class="far fa-user mr-1"></i>
                        @kullaniciAdSoyad
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="kullaniciMenu">
                        <button type="button"
                                class="dropdown-item"
                                data-toggle="modal"
                                data-target="#parolaDegistirModal">
                            <i class="fas fa-key mr-2"></i>
                            @L["Layout.ChangePassword"]
                        </button>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Home" asp-action="Cikis" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt mr-2"></i>
                                @L["Layout.Logout"]
                            </button>
                        </form>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-submenu">
                            <button class="dropdown-item dropdown-toggle tema-menu-ac"
                                    type="button"
                                    aria-expanded="false">
                                <i class="fas fa-palette mr-2"></i>
                                @L["Layout.ThemeSelection"]
                            </button>
                            <div class="tema-alt-menu">
                                <button type="button" class="dropdown-item tema-sec" data-tema="sidebar-dark-primary">
                                    <span class="tema-renk tema-lacivert"></span>@L["Layout.Theme.Navy"]
                                </button>
                                <button type="button" class="dropdown-item tema-sec" data-tema="sidebar-dark-success">
                                    <span class="tema-renk tema-yesil"></span>@L["Layout.Theme.Green"]
                                </button>
                                <button type="button" class="dropdown-item tema-sec" data-tema="sidebar-dark-info">
                                    <span class="tema-renk tema-mavi"></span>@L["Layout.Theme.Blue"]
                                </button>
                                <button type="button" class="dropdown-item tema-sec" data-tema="sidebar-light-primary">
                                    <span class="tema-renk tema-acik"></span>@L["Layout.Theme.Light"]
                                </button>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar @kullaniciTemasi elevation-4">
            <a href="/Basvuru" class="brand-link">
                <img src="~/img/TKDKLogoBeyaz.png"
                     alt="TKDK"
                     class="brand-image"
                     style="float:none;margin:0;max-height:42px;">

                <div style="display:inline-block;vertical-align:middle;margin-left:8px;">
                    <div style="font-size:16px;font-weight:600;">TKDK</div>
                    <div style="font-size:11px;line-height:12px;">
                        @L["Layout.ApplicationPortal"]
                    </div>
                </div>
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul id="basvuruMenu"
                        class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview"
                        role="menu"
                        data-accordion="false">
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper basvuru-content">
            <section class="content pt-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer text-sm basvuru-main-footer">
            <strong>@L["Layout.InstitutionName"]</strong>
            <div class="float-right d-none d-sm-inline">
                v1.0.0 © 2027
            </div>
        </footer>

    </div>

    <div class="modal fade" id="parolaDegistirModal" tabindex="-1" role="dialog" aria-labelledby="parolaDegistirBaslik" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form id="parolaDegistirForm" asp-controller="Home" asp-action="ParolaDegistir" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="parolaDegistirBaslik">@L["Layout.ChangePassword"]</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="@L["Layout.Close"]">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="parolaDegistirMesaj" class="alert d-none" role="alert"></div>
                        <div class="form-group">
                            <label for="yeniParola">@L["Layout.NewPassword"]</label>
                            <input id="yeniParola" name="parola" type="password" class="form-control" autocomplete="new-password" required />
                        </div>
                        <div class="form-group mb-2">
                            <label for="yeniParolaTekrar">@L["Layout.NewPasswordAgain"]</label>
                            <input id="yeniParolaTekrar" name="parolaTekrar" type="password" class="form-control" autocomplete="new-password" required />
                        </div>
                        <small class="text-muted">@L["Layout.PasswordRule"]</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@L["Layout.Cancel"]</button>
                        <button type="submit" class="btn btn-primary" id="parolaDegistirKaydet">
                            <i class="fas fa-save mr-1"></i>@L["Layout.Save"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script>
        window.paraLocale = '@System.Globalization.CultureInfo.CurrentCulture.Name';
        window.kullaniciTemaCookieAdi = '@temaCookieAdi';
        window.kullaniciTemasi = '@kullaniciTemasi';
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            BasvuruMenuYukle();

            $("#parolaDegistirForm").on("submit", function (event) {
                event.preventDefault();
                const form = $(this);
                const mesaj = $("#parolaDegistirMesaj");
                const kaydet = $("#parolaDegistirKaydet");
                mesaj.addClass("d-none").removeClass("alert-success alert-danger");
                kaydet.prop("disabled", true);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize()
                }).done(function (cevap) {
                    mesaj
                        .removeClass("d-none")
                        .addClass(cevap.basarili ? "alert-success" : "alert-danger")
                        .text(cevap.mesaj);
                    if (cevap.basarili) {
                        form[0].reset();
                        setTimeout(function () { $("#parolaDegistirModal").modal("hide"); }, 1200);
                    }
                }).fail(function () {
                    mesaj.removeClass("d-none").addClass("alert-danger").text("@L["Kullanici.ChangePassword.Failed"]");
                }).always(function () {
                    kaydet.prop("disabled", false);
                });
            });

            $("#parolaDegistirModal").on("hidden.bs.modal", function () {
                $("#parolaDegistirForm")[0].reset();
                $("#parolaDegistirMesaj").addClass("d-none").removeClass("alert-success alert-danger").text("");
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
