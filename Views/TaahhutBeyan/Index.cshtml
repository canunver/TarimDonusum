@{ ViewData["Title"] = "Taahhüt/Beyan"; }
<div class="basvuru-page">
    <div class="basvuru-titlebar">
        <div>
            <h1>Taahhüt/Beyan</h1>
            <p>Ön başvurunun 13. sayfasında (Taahhüt/Beyan) gösterilen maddeleri buradan ekleyebilir ve düzenleyebilirsiniz.</p>
        </div>
        <button class="btn btn-primary" onclick="ac()"><i class="fas fa-plus mr-1"></i>Yeni taahhüt/beyan</button>
    </div>
    <div class="table-responsive basvuru-card">
        <table class="table table-hover">
            <thead><tr><th style="width:70px">Sıra</th><th>Metin</th><th style="width:110px">Zorunlu</th><th style="width:90px">Durum</th><th style="width:110px"></th></tr></thead>
            <tbody id="liste"></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 id="modalBaslik">Taahhüt/Beyan</h5><button class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <input id="id" type="hidden">
                <div class="form-grid">
                    <label>Sıra no<input id="sira" type="number" min="1"></label>
                    <label>Onay zorunlu mu?<select id="zorunlu"><option value="true">Evet</option><option value="false">Hayır</option></select></label>
                    <label>Durum<select id="aktif"><option value="true">Aktif</option><option value="false">Pasif</option></select></label>
                </div>
                <label class="wide-label">Metin<textarea id="metin" rows="12" maxlength="10000"></textarea></label>
                <small class="form-text text-muted">Pasif maddeler başvuru sayfasında gösterilmez. Zorunlu maddeler onaylanmadan sayfa kaydedilemez.</small>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button>
                <button class="btn btn-primary" onclick="kaydet()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {<script>
let veriler = [];
const esc = x => $('<div>').text(x ?? '').html();
function hata(s) { PopupMesajGoster(s?.hataStr || 'İşlem gerçekleştirilemedi.', false); }
function listele() {
    AjaxGet('/TaahhutBeyan/Listele', null, s => {
        if (!s?.basarili) return hata(s);
        veriler = s.nesne || [];
        $('#liste').html(veriler.length
            ? veriler.map(x => `<tr class="${x.aktif ? '' : 'text-muted'}"><td>${x.siraNo}</td><td style="white-space:pre-line">${esc(x.metin)}</td><td>${x.zorunlu ? 'Evet' : 'Hayır'}</td><td>${x.aktif ? 'Aktif' : 'Pasif'}</td><td><button class="btn btn-sm btn-outline-primary" onclick="ac(${x.id})">Düzenle</button></td></tr>`).join('')
            : '<tr><td colspan="5" class="text-muted">Henüz taahhüt/beyan tanımlanmadı.</td></tr>');
    });
}
function ac(id) {
    const x = veriler.find(y => y.id === id) || { id: 0, siraNo: Math.max(0, ...veriler.map(y => Number(y.siraNo) || 0)) + 1, metin: '', zorunlu: true, aktif: true };
    $('#modalBaslik').text(x.id ? 'Taahhüt/Beyan düzenle' : 'Yeni taahhüt/beyan');
    $('#id').val(x.id); $('#sira').val(x.siraNo); $('#metin').val(x.metin);
    $('#zorunlu').val(String(x.zorunlu)); $('#aktif').val(String(x.aktif));
    $('#modal').modal('show');
}
function kaydet() {
    const tanim = { id: +$('#id').val(), siraNo: +$('#sira').val(), metin: $('#metin').val(), zorunlu: $('#zorunlu').val() === 'true', aktif: $('#aktif').val() === 'true' };
    AjaxPost('/TaahhutBeyan/Kaydet', tanim, s => {
        if (!s?.basarili) return hata(s);
        $('#modal').modal('hide');
        PopupMesajGoster(s.mesaj || 'Taahhüt/beyan kaydedildi.', true);
        listele();
    });
}
$(listele);
</script>}
