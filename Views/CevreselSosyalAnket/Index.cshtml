@{ ViewData["Title"]="Çevresel Sosyal V.F Yönetimi"; }
<div class="basvuru-page">
 <div class="basvuru-titlebar"><div><h1 id="anketBaslik">Çevresel Sosyal V.F</h1><p>Formun ekranda nasıl görüneceğini buradan izleyebilirsiniz.</p></div><div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" onclick="anketAdiAc()">Anket adını düzenle</button><button class="btn btn-outline-secondary" onclick="kapsamAc()">İstisna faaliyetleri</button><button class="btn btn-outline-primary" onclick="bolumAc()"><i class="fas fa-plus mr-1"></i>Bölüm ekle</button><button class="btn btn-outline-primary" onclick="soruAc()"><i class="fas fa-plus mr-1"></i>Soru ekle</button><button class="btn btn-outline-primary" onclick="taslakOlustur()">Taslak oluştur</button><button id="yayinlaBtn" class="btn btn-success" onclick="yayinla()">Yayınla</button></div></div>
 <div class="basvuru-card p-3 mb-3"><div class="row align-items-end"><div class="col-md-4"><label>Sürüm<select id="surum" class="form-control" onchange="yukle(this.value)"></select></label></div><div class="col-md-3"><span id="durum" class="badge badge-secondary"></span></div></div><div class="alert alert-info mt-3 mb-0">Ekrandaki alanlar önizlemedir. Değişiklikler “düzenle” tuşu ile açılan pencereden yapılır ve kaydedilir.</div></div>
 <div id="formOnizleme"></div>
</div>

<div class="modal fade" id="adModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Anket adını düzenle</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><label>Anket adı<input id="anketAdi" class="form-control" maxlength="1000"></label></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button><button class="btn btn-primary" onclick="anketAdiKaydet()">Kaydet</button></div></div></div></div>
<div class="modal fade" id="kapsamModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5>İstisna faaliyetleri</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><div class="form-group"><label for="kapsamBaslik" class="d-block">Başlık</label><input id="kapsamBaslik" class="form-control w-100" maxlength="500"></div><div class="form-group"><label for="kapsamHtml" class="d-block">HTML içeriği</label><textarea id="kapsamHtml" class="form-control font-monospace w-100" rows="18"></textarea></div><h6 class="mt-4">Önizleme</h6><div id="kapsamOnizleme" class="esf-info"></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button><button class="btn btn-primary" onclick="kapsamKaydet()">Kaydet</button></div></div></div></div>
<div class="modal fade" id="bolumModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 id="bolumModalBaslik">Bölüm</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="bolumId" type="hidden"><label>Bölüm numarası<input id="bolumKod" class="form-control" maxlength="100"></label><label>Bölüm başlığı<input id="bolumBaslik" class="form-control" maxlength="1000"></label></div><div class="modal-footer"><button id="bolumSilBtn" class="btn btn-outline-danger mr-auto" onclick="bolumSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button><button class="btn btn-primary" onclick="bolumKaydet()">Kaydet</button></div></div></div></div>
<div class="modal fade" id="soruModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="soruModalBaslik">Soru</h5><button class="close" data-dismiss="modal">&times;</button></div><div class="modal-body"><input id="soruId" type="hidden"><div class="row"><div class="col-md-4"><label>Bölüm<select id="soruBolum" class="form-control"></select></label></div><div class="col-md-2"><label>Soru no<input id="soruKod" class="form-control"></label></div><div class="col-md-6"><label>Soru metni<textarea id="soruMetin" class="form-control" rows="2"></textarea></label></div><div class="col-md-3"><label>Cevap tipi<select id="soruTur" class="form-control"></select></label></div><div class="col-md-3"><label>Otomatik veri kaynağı<select id="soruKaynak" class="form-control"></select></label></div><div class="col-md-3"><label>Maksimum uzunluk<input id="soruMaks" type="number" min="1" class="form-control"></label></div><div class="col-md-3 pt-4"><label><input id="soruAktif" type="checkbox"> Aktif</label></div></div><div class="row mt-2"><div class="col-md-4"><label>Gösterim</label><label class="d-block"><input id="soruOrtak" type="checkbox"> Ortak alan</label><label class="d-block"><input id="soruYapim" type="checkbox"> Planlanan yatırım</label><label class="d-block"><input id="soruGuncelleme" type="checkbox"> Mevcut tesis</label></div><div class="col-md-4"><label>Kurallar</label><label class="d-block"><input id="soruZorunlu" type="checkbox"> Zorunlu</label><label class="d-block"><input id="soruAciklama" type="checkbox"> Her zaman açıklama</label><label class="d-block"><input id="soruKapsam" type="checkbox"> Kapsam dışı bırakır</label><label class="d-block"><input id="soruListe" type="checkbox"> Kapsam dışı faaliyet listesini göster</label></div><div class="col-md-4"><label>Seçenekler (satır başına)<textarea id="soruSecenek" class="form-control" rows="6"></textarea></label></div></div><div class="row"><div class="col-md-4"><label>Açıklama istenecek cevaplar<textarea id="soruAciklamaKosul" class="form-control" rows="4"></textarea></label></div><div class="col-md-4"><label>Dosya istenecek cevaplar<textarea id="soruDosyaKosul" class="form-control" rows="4"></textarea></label></div><div class="col-md-4"><label>Not<textarea id="soruNot" class="form-control" rows="4"></textarea></label></div><div class="col-md-6"><label>Bilgi metni<textarea id="soruBilgi" class="form-control" rows="3"></textarea></label></div><div class="col-md-6"><label>Yer tutucu<input id="soruYer" class="form-control"></label></div></div></div><div class="modal-footer"><button id="soruSilBtn" class="btn btn-outline-danger mr-auto" onclick="soruSil()">Sil</button><button class="btn btn-outline-secondary" data-dismiss="modal">Kapat</button><button class="btn btn-primary" onclick="soruKaydet()">Kaydet</button></div></div></div></div>

@section Scripts {<script>
let anket=null,seciliSoru=null;const onizlemeCevaplari={};const esc=x=>$('<div>').text(x??'').html(),satir=x=>(x||[]).join('\n'),liste=x=>(x||'').split(/\r?\n/).map(y=>y.trim()).filter(Boolean);
const turler=[['yesno','Evet / Hayır'],['select','Seçim listesi'],['text','Kısa metin'],['textarea','Uzun metin'],['percent','Yüzde'],['staff','Çalışan tablosu']],kaynaklar=[['','Elle girilecek'],['Firma.TicaretUnvani','Firma ticaret unvanı'],['Yatirim.Adi','Yatırım adı'],['Yatirim.Adresleri','Yatırım adresleri'],['Yatirim.Turleri','Yatırım türleri'],['Yatirim.OzetVeGerekce','Yatırım özeti ve gerekçesi'],['Yatirim.HarcamaTurleri','Harcama türleri'],['Yatirim.KullanimHakkiBelgesiDurumu','Kullanım hakkı belgesi durumu'],['Yatirim.AraziStatusleri','Arazi statüleri']];
function hata(s){PopupMesajGoster(s?.hataStr||'İşlem gerçekleştirilemedi.',false)}function basarili(s,modal){if(!s?.basarili)return hata(s);$(modal).modal('hide');PopupMesajGoster(s.mesaj,true);yukle(anket.id)}
function yukle(id){AjaxGet('/CevreselSosyalAnket/SayfaVerisi',id?{surumId:id}:{},s=>{if(!s?.basarili)return hata(s);const d=s.nesne||{};anket=d.anket;$('#surum').html((d.surumler||[]).map(x=>`<option value="${x.id}" ${anket?.id===x.id?'selected':''}>Sürüm ${x.surumNo} - ${x.durum===1?'Yayında':x.durum===0?'Taslak':'Arşiv'}</option>`).join(''));render()})}
function render(){if(!anket){$('#formOnizleme').html('<div class="alert alert-warning">Form bulunamadı.</div>');return}$('#anketBaslik').text(anket.aciklama||'Çevresel Sosyal V.F');$('#durum').text(anket.durum===1?'Yayında':anket.durum===0?'Taslak':'Arşiv').attr('class','badge '+(anket.durum===1?'badge-success':anket.durum===0?'badge-warning':'badge-secondary'));$('#yayinlaBtn').toggle(anket.durum===0);$('#formOnizleme').html((anket.bolumler||[]).map(bolumHtml).join(''))}
function bolumHtml(b){return `<section class="basvuru-card p-3 mb-3"><div class="d-flex justify-content-between align-items-center mb-3"><h3 class="mb-0">${esc(b.kod)}. ${esc(b.baslik)}</h3><button class="btn btn-sm btn-outline-secondary" onclick="bolumAc(${b.id})">Bölümü düzenle</button></div>${(b.bilgiler||[]).map(x=>`<div class="alert alert-info"><strong>${esc(x.baslik)}</strong><div>${esc(x.metin)}</div></div>`).join('')}${(b.sorular||[]).map(soruHtml).join('')}</section>`}
function onizlemeAnahtari(q,ctx){return `${q.id}_${ctx.replace(/\s/g,'_')}`}
function cevapKontrolu(q,ctx){const k=onizlemeAnahtari(q,ctx),v=onizlemeCevaplari[k]||'',degis=`onchange="onizlemeCevapDegisti(${q.id},'${ctx}',this.value)"`;if(q.cevapTuru==='yesno')return `<select class="form-control" ${degis}><option value="">Seçiniz</option><option ${v==='Evet'?'selected':''}>Evet</option><option ${v==='Hayır'?'selected':''}>Hayır</option></select>`;if(q.cevapTuru==='select')return `<select class="form-control" ${degis}><option value="">Seçiniz</option>${(q.secenekler||[]).map(x=>`<option ${v===x?'selected':''}>${esc(x)}</option>`).join('')}</select>`;if(q.cevapTuru==='textarea')return `<textarea class="form-control" rows="3" oninput="onizlemeCevaplari['${k}']=this.value" placeholder="${esc(q.yerTutucu||'Açıklayınız')}">${esc(v)}</textarea>`;if(q.cevapTuru==='percent')return `<input class="form-control" type="number" min="0" max="100" step="0.01" value="${esc(v)}" oninput="onizlemeCevaplari['${k}']=this.value" placeholder="%">`;return `<input class="form-control" value="${esc(v)}" oninput="onizlemeCevaplari['${k}']=this.value" placeholder="${esc(q.yerTutucu||'')}">`}
function kosulluAlanHtml(q,ctx){const k=onizlemeAnahtari(q,ctx),v=onizlemeCevaplari[k]||'',acikla=q.herZamanAciklamaIste||(q.aciklamaKosullari||[]).includes(v),dosya=(q.dosyaKosullari||[]).includes(v);let h=q.kapsamDisiBirakir&&v==='Evet'?'<div class="alert alert-danger mt-2">Bu cevap başvuruyu kapsam dışı bırakır.</div>':'';if(acikla)h+=`<textarea class="form-control mt-2" placeholder="Açıklayınız" oninput="onizlemeCevaplari['${k}_aciklama']=this.value">${esc(onizlemeCevaplari[k+'_aciklama']||'')}</textarea>`;if(dosya)h+='<div class="alert alert-secondary mt-2 mb-0"><i class="fas fa-paperclip mr-1"></i>Bu cevap için dosya yüklenmesi istenir. Önizleme ekranında dosya yüklenemez.</div>';return h}
function onizlemeCevapDegisti(id,ctx,deger){const q=(anket.bolumler||[]).flatMap(b=>b.sorular||[]).find(x=>x.id===id);if(!q)return;onizlemeCevaplari[onizlemeAnahtari(q,ctx)]=deger;$(`#kosul_${onizlemeAnahtari(q,ctx)}`).html(kosulluAlanHtml(q,ctx))}
function soruHtml(q){const baglamlar=q.ortak?['Ortak']:q.guncelleme&&q.yapim?['Mevcut tesis','Planlanan yatırım']:q.guncelleme?['Mevcut tesis']:['Planlanan yatırım'];const cevaplar=`<div class="esf-cols ${baglamlar.length===1?'single':''}">${baglamlar.map(x=>`<div class="esf-answer-box"><h4>${x}</h4>${cevapKontrolu(q,x)}<div id="kosul_${onizlemeAnahtari(q,x)}" class="conditionalField">${kosulluAlanHtml(q,x)}</div></div>`).join('')}</div>`;const kapsam=q.kapsamDisiFaaliyetlerListesiniGoster?`<details class="esf-info mt-2"><summary>${esc(anket.kapsamDisiFaaliyetlerBaslik)}</summary>${anket.kapsamDisiFaaliyetlerHtml||''}</details>`:'';return `<div class="border rounded p-3 mb-3 ${q.aktif===false?'text-muted bg-light':''}"><div class="d-flex justify-content-between"><div class="font-weight-bold">${esc(q.gorunumKodu)} ${esc(q.metin)} ${q.zorunlu?'<span class="text-danger">*</span>':''}${q.notMetni?`<small class="d-block text-muted mt-1">${esc(q.notMetni)}</small>`:''}</div><button class="btn btn-sm btn-outline-secondary" onclick="soruAc(${q.id})">Soruyu düzenle</button></div>${q.bilgiMetni?`<div class="esf-info mt-2">${esc(q.bilgiMetni)}</div>`:''}<div class="mt-2">${cevaplar}</div>${kapsam}</div>`}
function anketAdiAc(){$('#anketAdi').val(anket.aciklama);$('#adModal').modal('show')}function anketAdiKaydet(){AjaxPost('/CevreselSosyalAnket/AnketAdiniKaydet',{id:anket.id,aciklama:$('#anketAdi').val()},s=>basarili(s,'#adModal'))}
function temizHtml(html){const t=document.createElement('template');t.innerHTML=html||'';t.content.querySelectorAll('script,style,iframe,object,embed').forEach(x=>x.remove());const izinli=new Set(['P','UL','OL','LI','STRONG','EM','BR','H4','H5']);[...t.content.querySelectorAll('*')].forEach(x=>{if(!izinli.has(x.tagName)){x.replaceWith(...x.childNodes);return}[...x.attributes].forEach(a=>x.removeAttribute(a.name))});return t.innerHTML.trim()}
function kapsamAc(){$('#kapsamBaslik').val(anket.kapsamDisiFaaliyetlerBaslik);$('#kapsamHtml').val(anket.kapsamDisiFaaliyetlerHtml);kapsamOnizle();$('#kapsamModal').modal('show')}function kapsamOnizle(){$('#kapsamOnizleme').html(`<h4>${esc($('#kapsamBaslik').val())}</h4>${temizHtml($('#kapsamHtml').val())}`)}$(document).on('input','#kapsamBaslik,#kapsamHtml',kapsamOnizle);function kapsamKaydet(){AjaxPost('/CevreselSosyalAnket/KapsamDisiKaydet',{id:anket.id,baslik:$('#kapsamBaslik').val(),html:$('#kapsamHtml').val()},s=>basarili(s,'#kapsamModal'))}
function bolumAc(id=0){const b=(anket.bolumler||[]).find(x=>x.id===id)||{id:0,kod:'',baslik:''};$('#bolumId').val(b.id);$('#bolumKod').val(b.kod);$('#bolumBaslik').val(b.baslik);$('#bolumSilBtn').toggle(b.id>0);$('#bolumModalBaslik').text(b.id?'Bölümü düzenle':'Bölüm ekle');$('#bolumModal').modal('show')}function bolumKaydet(){AjaxPost('/CevreselSosyalAnket/BolumKaydet',{id:Number($('#bolumId').val()),anketSurumId:anket.id,kod:$('#bolumKod').val(),baslik:$('#bolumBaslik').val()},s=>basarili(s,'#bolumModal'))}function bolumSil(){if(!confirm('Bölüm ve bağlı bütün soruları silinsin mi?'))return;AjaxPost('/CevreselSosyalAnket/BolumSil',{id:Number($('#bolumId').val()),anketSurumId:anket.id},s=>basarili(s,'#bolumModal'))}
function bosSoru(){return{id:0,anahtar:'',gorunumKodu:'',baslik:'',metin:'',cevapTuru:'yesno',ortak:false,yapim:true,guncelleme:true,zorunlu:false,maksimumUzunluk:null,notMetni:'',bilgiMetni:'',yerTutucu:'',kapsamDisiBirakir:false,kapsamDisiFaaliyetlerListesiniGoster:false,herZamanAciklamaIste:false,otomatikKaynakKodu:null,aktif:true,secenekler:[],aciklamaKosullari:[],dosyaKosullari:[]}}
function soruAc(id=0){seciliSoru=(anket.bolumler||[]).flatMap(b=>b.sorular||[]).find(x=>x.id===id)||bosSoru();$('#soruBolum').html((anket.bolumler||[]).map(b=>`<option value="${b.id}" ${b.id===seciliSoru.bolumId?'selected':''}>${esc(b.kod)}. ${esc(b.baslik)}</option>`).join(''));$('#soruTur').html(turler.map(x=>`<option value="${x[0]}" ${x[0]===seciliSoru.cevapTuru?'selected':''}>${x[1]}</option>`));$('#soruKaynak').html(kaynaklar.map(x=>`<option value="${x[0]}" ${x[0]===(seciliSoru.otomatikKaynakKodu||'')?'selected':''}>${x[1]}</option>`));$('#soruId').val(seciliSoru.id);$('#soruKod').val(seciliSoru.gorunumKodu);$('#soruMetin').val(seciliSoru.metin);$('#soruMaks').val(seciliSoru.maksimumUzunluk??'');$('#soruSecenek').val(satir(seciliSoru.secenekler));$('#soruAciklamaKosul').val(satir(seciliSoru.aciklamaKosullari));$('#soruDosyaKosul').val(satir(seciliSoru.dosyaKosullari));$('#soruNot').val(seciliSoru.notMetni);$('#soruBilgi').val(seciliSoru.bilgiMetni);$('#soruYer').val(seciliSoru.yerTutucu);[['Aktif','aktif'],['Ortak','ortak'],['Yapim','yapim'],['Guncelleme','guncelleme'],['Zorunlu','zorunlu'],['Aciklama','herZamanAciklamaIste'],['Kapsam','kapsamDisiBirakir'],['Liste','kapsamDisiFaaliyetlerListesiniGoster']].forEach(x=>$(`#soru${x[0]}`).prop('checked',!!seciliSoru[x[1]]));$('#soruSilBtn').toggle(id>0);$('#soruModalBaslik').text(id?'Soruyu düzenle':'Soru ekle');$('#soruModal').modal('show')}
function soruModeli(){const q={...seciliSoru,id:Number($('#soruId').val()),gorunumKodu:$('#soruKod').val(),metin:$('#soruMetin').val(),cevapTuru:$('#soruTur').val(),otomatikKaynakKodu:$('#soruKaynak').val()||null,maksimumUzunluk:$('#soruMaks').val()?Number($('#soruMaks').val()):null,secenekler:liste($('#soruSecenek').val()),aciklamaKosullari:liste($('#soruAciklamaKosul').val()),dosyaKosullari:liste($('#soruDosyaKosul').val()),notMetni:$('#soruNot').val(),bilgiMetni:$('#soruBilgi').val(),yerTutucu:$('#soruYer').val()};[['Aktif','aktif'],['Ortak','ortak'],['Yapim','yapim'],['Guncelleme','guncelleme'],['Zorunlu','zorunlu'],['Aciklama','herZamanAciklamaIste'],['Kapsam','kapsamDisiBirakir'],['Liste','kapsamDisiFaaliyetlerListesiniGoster']].forEach(x=>q[x[1]]=$(`#soru${x[0]}`).prop('checked'));return q}function soruKaydet(){AjaxPost('/CevreselSosyalAnket/SoruKaydet',{anketSurumId:anket.id,bolumId:Number($('#soruBolum').val()),soru:soruModeli()},s=>basarili(s,'#soruModal'))}function soruSil(){if(!confirm('Soru silinsin mi?'))return;AjaxPost('/CevreselSosyalAnket/SoruSil',{anketSurumId:anket.id,bolumId:Number($('#soruBolum').val()),soru:{id:Number($('#soruId').val())}},s=>basarili(s,'#soruModal'))}
function taslakOlustur(){AjaxPost('/CevreselSosyalAnket/TaslakOlustur',{},s=>{if(!s?.basarili)return hata(s);yukle(s.nesne)})}function yayinla(){if(!confirm('Bu taslak yayınlansın mı?'))return;AjaxPost('/CevreselSosyalAnket/Yayinla',{id:anket.id},s=>{if(!s?.basarili)return hata(s);PopupMesajGoster(s.mesaj,true);yukle(anket.id)})}$(function(){yukle()});
</script>}
